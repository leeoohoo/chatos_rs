#!/bin/sh
# Firefox still reads protected macOS app data even with an explicit profile.
set -eu
: "${CHATOS_PLUGIN_CACHE_DIR:?Missing isolated Plugin cache}"
firefox_bin='/Applications/Firefox.app/Contents/MacOS/firefox'
if [ ! -x "$firefox_bin" ]; then
  echo 'Firefox is not installed.' >&2
  exit 69
fi
mkdir -p "$CHATOS_PLUGIN_CACHE_DIR/officecli-browser-profiles"
render_profile=$(mktemp -d "$CHATOS_PLUGIN_CACHE_DIR/officecli-browser-profiles/firefox.XXXXXXXX")
firefox_app_data="$CHATOS_PLUGIN_CACHE_DIR/firefox-app-data"
mkdir -p "$firefox_app_data"
screenshot=''
for argument in "$@"; do
  case "$argument" in
    --screenshot=*) screenshot=${argument#--screenshot=} ;;
  esac
done
cleanup() {
  /bin/rm -rf -- "$render_profile"
}
trap cleanup EXIT
status=0
CFFIXED_USER_HOME="$firefox_app_data" \
MOZ_APP_DATA="$firefox_app_data" \
MOZ_LOCAL_APP_DATA="$firefox_app_data" \
MOZ_HEADLESS=1 \
  "$firefox_bin" --new-instance --profile "$render_profile" "$@" || status=$?
if [ "$status" -eq 0 ] && [ -n "$screenshot" ]; then
  attempts=0
  while [ ! -s "$screenshot" ] && [ "$attempts" -lt 300 ]; do
    /bin/sleep 0.1
    attempts=$((attempts + 1))
  done
  if [ ! -s "$screenshot" ]; then
    echo 'Firefox did not finish the screenshot before its launcher exited.' >&2
    status=1
  fi
fi
exit "$status"
