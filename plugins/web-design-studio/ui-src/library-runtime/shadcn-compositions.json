                      { "module": "message.MessageContent", "children": [
                        { "module": "message.MessageHeader", "children": ["AI Designer"] },
                        { "module": "bubble.Bubble", "props": { "variant": "secondary" }, "children": [
                          { "module": "bubble.BubbleContent", "children": ["I created a responsive hero and navigation."] }
                        ] }
                      ] }
                    ] }
                  ] },
                  { "module": "message-scroller.MessageScrollerItem", "children": [
                    { "module": "message.Message", "props": { "align": "end" }, "children": [
                      { "module": "message.MessageContent", "children": [
                        { "module": "bubble.Bubble", "props": { "variant": "default", "align": "end" }, "children": [
                          { "module": "bubble.BubbleContent", "children": [{ "$ref": "content", "fallback": "Make the visual language more editorial." }] }
