                                                                        <Grid ColumnSpacing="8">
                                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                                            <StackPanel Spacing="3">
                                                                                <TextBlock Text="{x:Bind StatusLabel}" Style="{StaticResource ChatOSBodyStrongTextStyle}" />
                                                                                <TextBlock Text="{x:Bind Detail}" TextWrapping="Wrap" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                                                            </StackPanel>
                                                                            <TextBlock Grid.Column="1" Text="{x:Bind UpdatedAtLabel}" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <Button HorizontalAlignment="Center" Click="OnLoadMorePlanningRunsClick"
                                                                Content="加载更早规划记录" Style="{StaticResource ChatOSSecondaryButtonStyle}"
                                                                IsEnabled="{x:Bind StoryViewModel.CanLoadMorePlanningRuns, Mode=OneWay}"
                                                                Visibility="{x:Bind StoryViewModel.HasMorePlanningRuns, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                    </StackPanel>
                                                </Expander>
                                                <Rectangle Height="1" Fill="{StaticResource ChatOSBorderBrush}" />
                                                <Border Padding="12" Background="{StaticResource ChatOSPurpleSoftBrush}" CornerRadius="10">
