                                                        <Button Click="OnAddStoryResourceClick" Style="{StaticResource ChatOSToolbarButtonStyle}" ToolTipService.ToolTip="添加素材"><FontIcon Glyph="&#xE710;" /></Button>
                                                        <Button Click="OnRemoveStoryResourceClick" Style="{StaticResource ChatOSToolbarButtonStyle}" ToolTipService.ToolTip="移除素材"><FontIcon Glyph="&#xE74D;" /></Button>
                                                    </StackPanel>
                                                </Grid>
                                                <ListView MaxHeight="190" Background="Transparent" BorderThickness="0" ItemsSource="{x:Bind StoryViewModel.Resources}" SelectedItem="{x:Bind StoryViewModel.SelectedResource, Mode=TwoWay}" SelectionMode="Single">
