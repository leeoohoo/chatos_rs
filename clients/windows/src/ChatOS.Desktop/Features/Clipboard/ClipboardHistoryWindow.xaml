<Window
    x:Class="ChatOS.Desktop.Features.Clipboard.ClipboardHistoryWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:domain="using:ChatOS.Core.Domain"
    mc:Ignorable="d"
    Title="Clipboard History">

    <Grid Background="{StaticResource ChatOSWorkspaceBackgroundBrush}">
        <Grid.Resources>
            <DataTemplate x:Key="ClipboardEntryTemplate" x:DataType="domain:ClipboardHistoryEntry">
                <Border Margin="0,0,0,8" Padding="12" Style="{StaticResource ChatOSCardStyle}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Text="{x:Bind Preview}" Style="{StaticResource ChatOSBodyStrongTextStyle}" TextWrapping="Wrap" MaxLines="3" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{x:Bind Kind}" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                <TextBlock Text="{x:Bind SourceApplication}" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                <TextBlock Text="{x:Bind UpdatedAt}" Style="{StaticResource ChatOSCaptionTextStyle}" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="6">
                            <Button AutomationProperties.AutomationId="ChatOS.Clipboard.Restore" Click="OnRestoreClicked" Content="恢复" Style="{StaticResource ChatOSPrimaryButtonStyle}" />
                            <Button AutomationProperties.AutomationId="ChatOS.Clipboard.Pin" Click="OnPinClicked" Content="固定/取消" />
                            <Button AutomationProperties.AutomationId="ChatOS.Clipboard.Delete" Click="OnDeleteClicked" Content="删除" />
                        </StackPanel>
                    </Grid>
                </Border>
            </DataTemplate>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid x:Name="TitleBar" Background="{StaticResource ChatOSTitleBarBackgroundBrush}">
            <StackPanel Margin="16,0,140,0" VerticalAlignment="Center" Orientation="Horizontal" Spacing="10">
                <FontIcon Glyph="&#xE8C8;" Foreground="{StaticResource ChatOSAccentBrush}" />
                <TextBlock Text="剪贴板历史" Style="{StaticResource ChatOSTitleTextStyle}" />
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1" Margin="16,14,16,8" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox AutomationProperties.AutomationId="ChatOS.Clipboard.Search" PlaceholderText="搜索历史记录" Text="{x:Bind ViewModel.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="1" Click="OnRefreshClicked" Content="刷新" />
        </Grid>
        <Grid Grid.Row="2" Margin="16,4,16,16">
            <ListView x:Name="HistoryList" ItemsSource="{x:Bind ViewModel.Entries}" ItemTemplate="{StaticResource ClipboardEntryTemplate}" SelectionMode="None" />
            <ProgressRing Width="24" Height="24" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                <FontIcon Glyph="&#xE8C8;" FontSize="30" Foreground="{StaticResource ChatOSSecondaryTextBrush}" />
                <TextBlock Text="还没有剪贴板历史" Style="{StaticResource ChatOSSecondaryBodyTextStyle}" />
            </StackPanel>
            <InfoBar x:Name="ErrorBar" VerticalAlignment="Bottom" IsClosable="True" Severity="Error" />
        </Grid>
    </Grid>
</Window>
