<UserControl
    x:Class="ChatOS.Desktop.Features.AgentTeams.AgentTeamPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:domain="using:ChatOS.Core.Domain">

    <Grid Padding="20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource ChatOSPageTitleTextStyle}" Text="Agent 团队" />
                <TextBlock Opacity="0.65" Text="{x:Bind ViewModel.ProjectName, Mode=OneWay}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Click="OnNewAgentClick" Content="新建 Agent" />
                <Button Click="OnNewTeamClick" Content="新建团队" />
                <Button Click="OnOpenDirectClick" Content="打开私聊" />
                <Button Click="OnRunAgentsClick" Content="运行队列" />
                <Button Click="OnRefreshClick" Content="刷新" />
            </StackPanel>
        </Grid>

        <InfoBar
            Grid.Row="1"
            IsOpen="{x:Bind HasNotice, Mode=OneWay}"
            IsClosable="False"
            Message="{x:Bind Notice, Mode=OneWay}"
            Severity="{x:Bind NoticeSeverity, Mode=OneWay}" />

        <Pivot Grid.Row="2">
            <PivotItem Header="对话">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="8">
                        <TextBlock FontWeight="SemiBold" Text="团队与私聊" />
                        <ListView
                            ItemsSource="{x:Bind ViewModel.Rooms}"
                            SelectedItem="{x:Bind ViewModel.SelectedRoom, Mode=TwoWay}"
                            SelectionChanged="OnRoomSelectionChanged">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="domain:AgentRoom">
                                    <StackPanel Padding="4">
                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind Draft.Name}" />
                                        <TextBlock FontSize="12" Opacity="0.65" Text="{x:Bind Kind}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>

                    <Grid Grid.Column="1" RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontSize="18" FontWeight="SemiBold" Text="{x:Bind SelectedRoomName, Mode=OneWay}" />
                                <TextBlock Opacity="0.65" Text="{x:Bind SelectedRoomGoal, Mode=OneWay}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Button Click="OnConfigureTeamClick" Content="团队设置" IsEnabled="{x:Bind ViewModel.CanConfigureTeam, Mode=OneWay}" />
                                <Button Click="OnAddMemberClick" Content="添加成员" IsEnabled="{x:Bind ViewModel.CanConfigureTeam, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>

                        <ItemsControl Grid.Row="1" ItemsSource="{x:Bind ViewModel.Members}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="domain:AgentRoomMember">
                                    <Button Click="OnMemberClick" Content="{x:Bind Draft.Role}" ToolTipService.ToolTip="{x:Bind Draft.Responsibility}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.Messages}" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="domain:AgentMessage">
                                    <Border Margin="0,3" Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
                                        <StackPanel Spacing="4">
                                            <TextBlock FontWeight="SemiBold" Text="{x:Bind SenderKind}" />
                                            <TextBlock Text="{x:Bind Content}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                            <ItemsControl ItemsSource="{x:Bind Attachments}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="domain:AgentMessageAttachment">
                                                        <Button Click="OnDownloadAttachmentClick" Content="{x:Bind Name}" FontSize="11" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock FontSize="11" Opacity="0.55" Text="{x:Bind CreatedAtUnixMs}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <StackPanel Grid.Row="3" Spacing="6">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.PendingAttachments}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="domain:AgentMessageAttachment">
                                        <Button Click="OnRemoveAttachmentClick" Content="{x:Bind Name}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Click="OnAddAttachmentClick" Content="附件" />
                                <TextBox
                                    Grid.Column="1"
                                    AcceptsReturn="True"
                                    MaxHeight="140"
                                    PlaceholderText="给团队发消息；未选择 @ 时会路由给默认 Agent"
                                    Text="{x:Bind ViewModel.MessageText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    TextWrapping="Wrap" />
                                <Button Grid.Column="2" Click="OnMentionSendClick" Content="@ 发送" />
                                <Button Grid.Column="3" Click="OnSendClick" Content="发送" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Grid>
            </PivotItem>

            <PivotItem Header="Agents">
                <ListView ItemsSource="{x:Bind ViewModel.Agents}" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="domain:AgentProfile">
                            <Grid Padding="10" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="3">
                                    <TextBlock FontWeight="SemiBold" Text="{x:Bind Draft.Name}" />
                                    <TextBlock Opacity="0.7" Text="{x:Bind Draft.Description}" TextWrapping="Wrap" />
                                    <TextBlock FontSize="11" Opacity="0.55" Text="{x:Bind Draft.ModelConfigId}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                    <Button Click="OnEditAgentClick" Content="编辑" />
                                    <Button Click="OnDirectAgentClick" Content="私聊" />
                                    <Button Click="OnArchiveAgentClick" Content="归档" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </PivotItem>

            <PivotItem Header="Todo">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Button HorizontalAlignment="Left" Click="OnNewTodoClick" Content="新建 Todo" IsEnabled="{x:Bind ViewModel.HasRoom, Mode=OneWay}" />
                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Todos}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="domain:AgentTodo">
                                <Grid Padding="10" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3">
                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind Draft.Title}" />
                                        <TextBlock Opacity="0.7" Text="{x:Bind Draft.Detail}" TextWrapping="Wrap" />
                                        <TextBlock FontSize="11" Opacity="0.6" Text="{x:Bind Status}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5">
                                        <Button Click="OnTodoUpClick" Content="↑" />
                                        <Button Click="OnTodoDownClick" Content="↓" />
                                        <Button Click="OnEditTodoClick" Content="更新" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </PivotItem>

            <PivotItem Header="资产">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Button HorizontalAlignment="Left" Click="OnNewAssetClick" Content="新建团队资产" IsEnabled="{x:Bind ViewModel.HasRoom, Mode=OneWay}" />
                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Assets}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="domain:AgentTeamAsset">
                                <Grid Padding="10" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Expander HorizontalAlignment="Stretch">
                                        <Expander.Header>
                                            <StackPanel Spacing="3">
                                                <TextBlock FontWeight="SemiBold" Text="{x:Bind Title}" />
                                                <TextBlock FontSize="11" Opacity="0.6" Text="{x:Bind Category}" />
                                            </StackPanel>
                                        </Expander.Header>
                                        <TextBlock Margin="0,8,0,4" IsTextSelectionEnabled="True" Opacity="0.8" Text="{x:Bind Markdown}" TextWrapping="Wrap" />
                                    </Expander>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                        <Button Click="OnEditAssetClick" Content="编辑" />
                                        <Button Click="OnArchiveAssetClick" Content="归档" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </PivotItem>

            <PivotItem Header="成员提案">
                <ListView ItemsSource="{x:Bind ViewModel.StaffingProposals}" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="domain:AgentStaffingProposal">
                            <Grid Padding="12" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock FontWeight="SemiBold" Text="{x:Bind Draft.Kind}" />
                                    <TextBlock Text="{x:Bind Draft.Name}" TextWrapping="Wrap" />
                                    <TextBlock Opacity="0.72" Text="{x:Bind Draft.Role}" TextWrapping="Wrap" />
                                    <TextBlock Opacity="0.72" Text="{x:Bind Draft.Rationale}" TextWrapping="Wrap" />
                                    <TextBlock Opacity="0.72" Text="{x:Bind Draft.Reason}" TextWrapping="Wrap" />
                                    <TextBlock FontSize="11" Opacity="0.6" Text="{x:Bind Status}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                    <Button Click="OnApproveStaffingProposalClick" Content="批准" />
                                    <Button Click="OnRejectStaffingProposalClick" Content="拒绝" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </PivotItem>

            <PivotItem Header="运行">
                <ListView ItemsSource="{x:Bind ViewModel.Runs}" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="domain:AgentRunSummary">
                            <Grid Padding="10" ColumnSpacing="10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="120" /><ColumnDefinition Width="100" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind AgentId}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Status}" />
                                <TextBlock Grid.Column="2" Text="{x:Bind ModelCalls}" />
                                <TextBlock Grid.Column="3" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Text="{x:Bind LastError}" TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </PivotItem>
        </Pivot>
    </Grid>
</UserControl>
