<UserControl
    x:Class="ChatOS.Desktop.Features.Projects.ProjectGitPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:core="using:ChatOS.Core.Domain"
    mc:Ignorable="d">

    <Grid Background="{StaticResource ChatOSContentBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="1" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Padding="14,0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE943;" Foreground="{StaticResource ChatOSSecondaryTextBrush}" />
            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Spacing="1">
                <TextBlock Text="{x:Bind ViewModel.HeadLabel, Mode=OneWay}" Style="{StaticResource ChatOSBodyStrongTextStyle}" />
                <TextBlock Text="{x:Bind ViewModel.SyncLabel, Mode=OneWay}" Style="{StaticResource ChatOSCaptionTextStyle}" />
            </StackPanel>
            <Button Grid.Column="2" Content="{x:Bind Localization.Pull, Mode=OneWay}" Command="{x:Bind ViewModel.PullCommand}" IsEnabled="{x:Bind ViewModel.IsRepository, Mode=OneWay}" />
            <Button Grid.Column="3" Content="{x:Bind Localization.Push, Mode=OneWay}" Command="{x:Bind ViewModel.PushCommand}" IsEnabled="{x:Bind ViewModel.IsRepository, Mode=OneWay}" Style="{StaticResource ChatOSPrimaryButtonStyle}" />
            <Button Grid.Column="4" Command="{x:Bind ViewModel.RefreshCommand}" Style="{StaticResource ChatOSToolbarButtonStyle}" ToolTipService.ToolTip="{x:Bind Localization.RefreshGitStatus, Mode=OneWay}">
                <FontIcon Glyph="&#xE72C;" />
            </Button>
            <Button
                Grid.Column="5"
                Command="{x:Bind ViewModel.CancelOperationCommand}"
                IsEnabled="{x:Bind ViewModel.CanCancel, Mode=OneWay}"
                Style="{StaticResource ChatOSToolbarButtonStyle}"
                ToolTipService.ToolTip="{x:Bind Localization.CancelGitOperation, Mode=OneWay}">
                <FontIcon Glyph="&#xE711;" />
            </Button>
            <ProgressRing Grid.Column="6" Width="18" Height="18" IsActive="{x:Bind ViewModel.CanCancel, Mode=OneWay}" />
        </Grid>

        <Border Grid.Row="1" Background="{StaticResource ChatOSBorderBrush}" />

        <Grid
            Grid.Row="2"
            Visibility="{x:Bind ViewModel.IsRepository, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="420" Spacing="12">
                <Border Width="58" Height="58" CornerRadius="16" Background="{StaticResource ChatOSProcessBackgroundBrush}">
                    <FontIcon Glyph="&#xE943;" FontSize="28" Foreground="{StaticResource ChatOSPurpleBrush}" />
                </Border>
                <TextBlock HorizontalAlignment="Center" Text="{x:Bind Localization.NotGitRepository, Mode=OneWay}" Style="{StaticResource ChatOSHeadlineTextStyle}" />
                <TextBlock
                    Text="{x:Bind Localization.GitInitializationNotice, Mode=OneWay}"
                    TextAlignment="Center"
                    Style="{StaticResource ChatOSSecondaryBodyTextStyle}" />
                <Button
                    HorizontalAlignment="Center"
                    Content="{x:Bind Localization.InitializeGitRepository, Mode=OneWay}"
                    Command="{x:Bind ViewModel.InitializeRepositoryCommand}"
                    Style="{StaticResource ChatOSPrimaryButtonStyle}" />
            </StackPanel>
        </Grid>

        <Grid
            Grid.Row="2"
            Visibility="{x:Bind ViewModel.IsRepository, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="330" />
            </Grid.ColumnDefinitions>

            <Grid Background="{StaticResource ChatOSSidebarBackgroundBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="48" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Padding="12,0" ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" Text="{x:Bind Localization.Changes, Mode=OneWay}" Style="{StaticResource ChatOSHeadlineTextStyle}" />
                    <Button
                        Grid.Column="1"
                        Content="{x:Bind Localization.StageAll, Mode=OneWay}"
                        Command="{x:Bind ViewModel.StageAllCommand}"
                        IsEnabled="{x:Bind ViewModel.HasWorkingTreeChanges, Mode=OneWay}" />
                    <Button
                        Grid.Column="2"
                        Content="{x:Bind Localization.UnstageAll, Mode=OneWay}"
                        Command="{x:Bind ViewModel.UnstageAllCommand}"
                        IsEnabled="{x:Bind ViewModel.HasStagedChanges, Mode=OneWay}" />
                </Grid>

                <ListView Grid.Row="1" Padding="8" ItemsSource="{x:Bind ViewModel.Changes}" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="core:ProjectGitChange">
                            <Border Margin="0,2" Padding="9" Style="{StaticResource ChatOSCardStyle}">
                                <Grid RowSpacing="7">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Path}" TextTrimming="CharacterEllipsis" Style="{StaticResource ChatOSBodyStrongTextStyle}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Kind}" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                    </Grid>
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
                                        <TextBlock Style="{StaticResource ChatOSCaptionTextStyle}">
                                            <Run Text="{Binding Staged, Source={StaticResource ChatOSLocalization}}" /><Run Text=" " /><Run Text="{x:Bind IndexStatus}" />
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource ChatOSCaptionTextStyle}">
                                            <Run Text="{Binding WorkingTree, Source={StaticResource ChatOSLocalization}}" /><Run Text=" " /><Run Text="{x:Bind WorkTreeStatus}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="4">
                                        <Button
                                            Content="{Binding WorkingTreeDiff, Source={StaticResource ChatOSLocalization}}"
                                            Click="OnWorkingDiffClick"
                                            Visibility="{x:Bind HasWorkingTreeChanges, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <Button
                                            Content="{Binding StagedDiff, Source={StaticResource ChatOSLocalization}}"
                                            Click="OnStagedDiffClick"
                                            Visibility="{x:Bind HasStagedChanges, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <Button
                                            Content="{Binding Stage, Source={StaticResource ChatOSLocalization}}"
                                            Click="OnStageClick"
                                            Visibility="{x:Bind HasWorkingTreeChanges, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <Button
                                            Content="{Binding Unstage, Source={StaticResource ChatOSLocalization}}"
                                            Click="OnUnstageClick"
                                            Visibility="{x:Bind HasStagedChanges, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="8"
                    Visibility="{x:Bind ViewModel.HasChanges, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                    <FontIcon Glyph="&#xE73E;" FontSize="28" Foreground="{StaticResource ChatOSSuccessBrush}" />
                    <TextBlock Text="{x:Bind Localization.NoWorkingTreeChanges, Mode=OneWay}" Style="{StaticResource ChatOSBodyStrongTextStyle}" />
                </StackPanel>

                <Border Grid.Row="2" Margin="8" Padding="10" Style="{StaticResource ChatOSCardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{x:Bind Localization.CreateCommit, Mode=OneWay}" Style="{StaticResource ChatOSBodyStrongTextStyle}" />
                        <TextBox
                            AcceptsReturn="True"
                            MinHeight="64"
                            MaxHeight="120"
                            PlaceholderText="{x:Bind Localization.CommitMessagePlaceholder, Mode=OneWay}"
                            Text="{x:Bind ViewModel.CommitMessage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            TextWrapping="Wrap" />
                        <Button
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Content="{x:Bind Localization.CommitStagedChanges, Mode=OneWay}"
                            Command="{x:Bind ViewModel.CommitCommand}"
                            IsEnabled="{x:Bind ViewModel.CanCommit, Mode=OneWay}"
                            Style="{StaticResource ChatOSPrimaryButtonStyle}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Column="1" Background="{StaticResource ChatOSBorderBrush}" />

            <Grid Grid.Column="2" Padding="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="1" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock Text="{x:Bind ViewModel.SelectedDiff.Path, Mode=OneWay}" TextTrimming="CharacterEllipsis" Style="{StaticResource ChatOSHeadlineTextStyle}" />
                    <TextBlock Text="{x:Bind Localization.DiffReadOnlyNotice, Mode=OneWay}" Style="{StaticResource ChatOSCaptionTextStyle}" />
                </StackPanel>
                <Border Grid.Row="1" Margin="0,12" Background="{StaticResource ChatOSBorderBrush}" />
                <ScrollViewer
                    Grid.Row="2"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto"
                    Visibility="{x:Bind ViewModel.HasDiff, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock
                        FontFamily="Cascadia Mono, Consolas"
                        FontSize="12"
                        IsTextSelectionEnabled="True"
                        Text="{x:Bind ViewModel.SelectedDiff.Content, Mode=OneWay}"
                        TextWrapping="NoWrap" />
                </ScrollViewer>
                <StackPanel
                    Grid.Row="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="8"
                    Visibility="{x:Bind ViewModel.HasDiff, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                    <FontIcon Glyph="&#xE8A5;" FontSize="34" Foreground="{StaticResource ChatOSTertiaryTextBrush}" />
                    <TextBlock Text="{x:Bind Localization.SelectChangeToViewDiff, Mode=OneWay}" Style="{StaticResource ChatOSHeadlineTextStyle}" />
                    <TextBlock Text="{x:Bind Localization.SplitDiffNotice, Mode=OneWay}" Style="{StaticResource ChatOSCaptionTextStyle}" />
                </StackPanel>
                <TextBlock
                    Grid.Row="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Text="{x:Bind Localization.NoTextDiff, Mode=OneWay}"
                    Style="{StaticResource ChatOSCaptionTextStyle}"
                    Visibility="{x:Bind ViewModel.IsDiffEmpty, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>

            <Border Grid.Column="3" Background="{StaticResource ChatOSBorderBrush}" />

            <ScrollViewer Grid.Column="4" Padding="10" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12">
                    <Border Style="{StaticResource ChatOSCardStyle}">
                        <StackPanel Spacing="8">
                            <Grid>
                                <TextBlock Text="{x:Bind Localization.Branches, Mode=OneWay}" Style="{StaticResource ChatOSHeadlineTextStyle}" />
                                <Button HorizontalAlignment="Right" Content="{x:Bind Localization.New, Mode=OneWay}" Click="OnCreateBranchClick" />
                            </Grid>
                            <ListView ItemsSource="{x:Bind ViewModel.Branches}" SelectionMode="None" MaxHeight="220">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="core:ProjectGitBranch">
                                        <Grid Padding="2,5" ColumnSpacing="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" Style="{StaticResource ChatOSBodyStrongTextStyle}" />
                                                <TextBlock Text="{x:Bind Upstream}" TextTrimming="CharacterEllipsis" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="{Binding Switch, Source={StaticResource ChatOSLocalization}}" Click="OnSwitchBranchClick" Visibility="{x:Bind IsCurrent, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                            <Button Grid.Column="2" Content="{Binding Merge, Source={StaticResource ChatOSLocalization}}" Click="OnMergeBranchClick" Visibility="{x:Bind IsCurrent, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource ChatOSCardStyle}">
                        <StackPanel Spacing="8">
                            <Grid>
                                <TextBlock Text="{x:Bind Localization.Remotes, Mode=OneWay}" Style="{StaticResource ChatOSHeadlineTextStyle}" />
                                <Button HorizontalAlignment="Right" Content="{x:Bind Localization.Add, Mode=OneWay}" Click="OnAddRemoteClick" />
                            </Grid>
                            <ListView ItemsSource="{x:Bind ViewModel.Remotes}" SelectionMode="None" MaxHeight="180">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="core:ProjectGitRemote">
                                        <Grid Padding="2,5" ColumnSpacing="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="{x:Bind Name}" Style="{StaticResource ChatOSBodyStrongTextStyle}" />
                                                <TextBlock Text="{x:Bind Url}" TextTrimming="CharacterEllipsis" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Click="OnEditRemoteClick" Style="{StaticResource ChatOSToolbarButtonStyle}" ToolTipService.ToolTip="{Binding EditRemote, Source={StaticResource ChatOSLocalization}}">
                                                <FontIcon Glyph="&#xE70F;" FontSize="12" />
                                            </Button>
                                            <Button Grid.Column="2" Click="OnRemoveRemoteClick" Style="{StaticResource ChatOSToolbarButtonStyle}" ToolTipService.ToolTip="{Binding RemoveRemote, Source={StaticResource ChatOSLocalization}}">
                                                <FontIcon Glyph="&#xE74D;" FontSize="12" Foreground="{StaticResource ChatOSFailureBrush}" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <TextBlock
                                Text="{x:Bind Localization.FastForwardOnlyNotice, Mode=OneWay}"
                                Style="{StaticResource ChatOSCaptionTextStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource ChatOSCardStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{x:Bind Localization.RecentCommits, Mode=OneWay}" Style="{StaticResource ChatOSHeadlineTextStyle}" />
                            <ListView ItemsSource="{x:Bind ViewModel.Commits}" SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="core:ProjectGitCommit">
                                        <Grid Padding="2,6" ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="58" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock FontFamily="Cascadia Mono, Consolas" Text="{x:Bind ShortId}" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                            <StackPanel Grid.Column="1" Spacing="1">
                                                <TextBlock Text="{x:Bind Subject}" TextTrimming="CharacterEllipsis" Style="{StaticResource ChatOSBodyStrongTextStyle}" />
                                                <TextBlock Text="{x:Bind Author}" TextTrimming="CharacterEllipsis" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <StackPanel Grid.Row="3" Margin="14,6" Spacing="3">
            <TextBlock
                Text="{x:Bind ViewModel.ActionMessage, Mode=OneWay}"
                Foreground="{StaticResource ChatOSSuccessBrush}"
                Style="{StaticResource ChatOSCaptionTextStyle}"
                Visibility="{x:Bind ViewModel.ActionMessage, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />
            <TextBlock
                Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Foreground="{StaticResource ChatOSFailureBrush}"
                Style="{StaticResource ChatOSCaptionTextStyle}"
                Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />
        </StackPanel>
    </Grid>
</UserControl>
