                                                        <ItemsControl ItemsSource="{x:Bind StoryViewModel.PromptAuditItems}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="media:StoryPromptAuditItem">
                                                                    <Border Margin="0,0,0,8" Padding="10" Background="{StaticResource ChatOSSurfaceSubtleBrush}" CornerRadius="8">
                                                                        <StackPanel Spacing="4">
                                                                            <TextBlock Text="{x:Bind Name}" Style="{StaticResource ChatOSBodyStrongTextStyle}" />
                                                                            <TextBlock Text="{x:Bind Key}" Foreground="{StaticResource ChatOSPurpleBrush}" IsTextSelectionEnabled="True" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                                                            <TextBlock Text="{x:Bind Purpose}" TextWrapping="Wrap" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                                                            <TextBox AcceptsReturn="True" IsReadOnly="True" MaxHeight="180" Text="{x:Bind Content}" TextWrapping="Wrap" />
                                                                        </StackPanel>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Expander>
                                                <Rectangle Height="1" Fill="{StaticResource ChatOSBorderBrush}" />
                                                <Border x:Name="StoryPortraitsSectionAnchor" Height="1" />
                                                <Grid>
