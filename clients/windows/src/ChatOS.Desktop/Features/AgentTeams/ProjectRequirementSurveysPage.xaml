<UserControl
    x:Class="ChatOS.Desktop.Features.AgentTeams.ProjectRequirementSurveysPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:presentation="using:ChatOS.Presentation.AgentTeams"
    AutomationProperties.AutomationId="ChatOS.RequirementSurveys.Root"
    AutomationProperties.Name="项目需求调研中心">

    <Grid Padding="24" RowSpacing="14" Background="{StaticResource ChatOSWorkspaceBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Padding="18" Background="{StaticResource ChatOSSurfaceSubtleBrush}" BorderBrush="{StaticResource ChatOSBorderBrush}" BorderThickness="1" CornerRadius="14">
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="54" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Border Width="52" Height="52" Background="{StaticResource ChatOSPurpleBrush}" CornerRadius="14">
                    <FontIcon Glyph="&#xE9D5;" FontSize="23" Foreground="White" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                    <TextBlock Text="{x:Bind ViewModel.ProjectName, Mode=OneWay}" Style="{StaticResource ChatOSPageTitleTextStyle}" />
                    <TextBlock MaxWidth="820" Text="本地任务需要你补充信息时会在这里暂停。提交答案后，Local Agent Host 会保存答案并恢复原 Run。" TextWrapping="Wrap" Style="{StaticResource ChatOSCaptionTextStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Padding="9,5" Background="{StaticResource ChatOSAccentSoftBrush}" CornerRadius="9"><TextBlock Style="{StaticResource ChatOSCaptionTextStyle}"><Run Text="{x:Bind ViewModel.PendingCount, Mode=OneWay}" /><Run Text=" 待填写" /></TextBlock></Border>
                        <Border Padding="9,5" Background="{StaticResource ChatOSContentBackgroundBrush}" CornerRadius="9"><TextBlock Style="{StaticResource ChatOSCaptionTextStyle}"><Run Text="{x:Bind ViewModel.AwaitingResolutionCount, Mode=OneWay}" /><Run Text=" 处理中" /></TextBlock></Border>
                        <Border Padding="9,5" Background="{StaticResource ChatOSSuccessSoftBrush}" CornerRadius="9"><TextBlock Style="{StaticResource ChatOSCaptionTextStyle}"><Run Text="{x:Bind ViewModel.ResolvedCount, Mode=OneWay}" /><Run Text=" 已恢复" /></TextBlock></Border>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Top" Orientation="Horizontal" Spacing="8">
                    <ProgressRing Width="20" Height="20" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                    <Button AutomationProperties.AutomationId="ChatOS.RequirementSurveys.Refresh" AutomationProperties.Name="刷新需求调研" Click="OnRefreshClick" Content="刷新" IsEnabled="{x:Bind ViewModel.CanRefresh, Mode=OneWay}" Style="{StaticResource ChatOSSecondaryButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <InfoBar
            Grid.Row="1"
            IsClosable="False"
            IsOpen="{x:Bind HasNotice, Mode=OneTime}"
            Message="{x:Bind Notice, Mode=OneTime}"
            Severity="{x:Bind NoticeSeverity, Mode=OneTime}" />

        <Grid Grid.Row="2" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400" MinWidth="310" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid>
                <ListView
                    AutomationProperties.AutomationId="ChatOS.RequirementSurveys.List"
                    AutomationProperties.Name="需求调研列表"
                    ItemsSource="{x:Bind ViewModel.Surveys}"
                    SelectedItem="{x:Bind ViewModel.SelectedSurvey, Mode=TwoWay}"
                    SelectionMode="Single"
                    Visibility="{x:Bind ViewModel.HasSurveys, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="presentation:ProjectRequirementSurveyItemViewModel">
                            <Border Margin="0,0,0,8" Padding="12" Style="{StaticResource ChatOSCardStyle}">
                                <StackPanel Spacing="5">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" FontSize="11" Opacity="0.7" Text="{x:Bind StatusText}" />
                                    </Grid>
                                    <TextBlock MaxLines="2" Opacity="0.72" Text="{x:Bind Purpose}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock FontSize="11" Opacity="0.55" Text="{x:Bind QuestionCountText}" />
                                        <TextBlock FontSize="11" Opacity="0.55" Text="{x:Bind CreatedAtText}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Border
                    Padding="24"
                    Style="{StaticResource ChatOSCardStyle}"
                    Visibility="{x:Bind ViewModel.HasSurveys, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                        <FontIcon FontSize="34" Glyph="&#xE9D5;" />
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="暂无需求调研" />
                        <TextBlock MaxWidth="280" Opacity="0.65" Text="当项目目标、范围或方案需要 Human 确认时，调研会显示在这里。" TextAlignment="Center" TextWrapping="Wrap" />
                        <Button Click="OnRefreshClick" Content="重新检查" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border
                Grid.Column="1"
                Padding="18"
                Style="{StaticResource ChatOSCardStyle}"
                Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="5">
                                <TextBlock FontSize="22" FontWeight="SemiBold" Text="{x:Bind ViewModel.SelectedSurvey.Title, Mode=OneWay}" TextWrapping="Wrap" />
                                <TextBlock Opacity="0.72" Text="{x:Bind ViewModel.SelectedSurvey.Purpose, Mode=OneWay}" TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{x:Bind ViewModel.SelectedSurvey.StatusText, Mode=OneWay}" />
                        </Grid>

                        <InfoBar
                            IsClosable="False"
                            IsOpen="True"
                            Message="{x:Bind ViewModel.SelectedSurvey.PermissionText, Mode=OneWay}"
                            Severity="Informational" />

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="调研问卷与答案" />
                            <Button
                                Grid.Column="1"
                                AutomationProperties.AutomationId="ChatOS.RequirementSurveys.Submit"
                                AutomationProperties.Name="填写并提交需求调研"
                                Click="OnFillSurveyClick"
                                Content="填写并提交"
                                IsEnabled="{x:Bind ViewModel.CanSubmitSelected, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.SelectedSurvey.IsPending, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>

                        <ItemsControl ItemsSource="{x:Bind ViewModel.SelectedSurvey.Questions, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="presentation:ProjectRequirementSurveyQuestionViewModel">
                                    <Border Margin="0,0,0,8" Padding="12" Background="{StaticResource ChatOSProcessBackgroundBrush}" CornerRadius="8">
                                        <StackPanel Spacing="5">
                                            <TextBlock FontWeight="SemiBold" Text="{x:Bind Prompt}" TextWrapping="Wrap" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock FontSize="11" Opacity="0.6" Text="{x:Bind KindText}" />
                                                <TextBlock FontSize="11" Opacity="0.6" Text="{x:Bind RequirementText}" />
                                            </StackPanel>
                                            <TextBlock Opacity="0.8" Text="{x:Bind AnswerText}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Spacing="5" Visibility="{x:Bind ViewModel.SelectedSurvey.IsSubmitted, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock FontWeight="SemiBold" Text="补充备注" />
                            <TextBlock IsTextSelectionEnabled="True" Opacity="0.8" Text="{x:Bind ViewModel.SelectedSurvey.SubmissionNotes, Mode=OneWay}" TextWrapping="Wrap" />
                        </StackPanel>

                        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="方案与后续回复" />
                            <ProgressRing Grid.Column="1" Width="18" Height="18" IsActive="{x:Bind ViewModel.SelectedSurvey.IsPlanBusy, Mode=OneWay}" />
                        </Grid>
                        <InfoBar
                            IsClosable="False"
                            IsOpen="{x:Bind ViewModel.SelectedSurvey.HasPlanError, Mode=OneWay}"
                            Message="{x:Bind ViewModel.SelectedSurvey.PlanError, Mode=OneWay}"
                            Severity="Error" />
                        <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.SelectedSurvey.HasPlan, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.SelectedSurvey.PlanVersionText, Mode=OneWay}" />
                                <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{x:Bind ViewModel.SelectedSurvey.PlanStatusText, Mode=OneWay}" />
                            </Grid>
                            <Border Padding="12" Background="{StaticResource ChatOSProcessBackgroundBrush}" CornerRadius="8">
                                <RichTextBlock x:Name="PlanMarkdownPreview" IsTextSelectionEnabled="True" />
                            </Border>
                            <TextBlock Opacity="0.72" Text="{x:Bind ViewModel.SelectedSurvey.PlanBoundaryText, Mode=OneWay}" TextWrapping="Wrap" />
                            <TextBlock Opacity="0.72" Text="{x:Bind ViewModel.SelectedSurvey.PlanFollowUpText, Mode=OneWay}" TextWrapping="Wrap" />
                            <Button
                                AutomationProperties.AutomationId="ChatOS.RequirementSurveys.ConfirmPlan"
                                AutomationProperties.Name="确认当前需求方案"
                                Click="OnConfirmPlanClick"
                                Content="确认当前方案"
                                HorizontalAlignment="Left"
                                IsEnabled="{x:Bind ViewModel.SelectedSurvey.CanConfirmPlan, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.SelectedSurvey.IsPlanPendingConfirmation, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                        <StackPanel
                            Spacing="10"
                            Visibility="{x:Bind ViewModel.SelectedSurvey.HasPlan, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                            <TextBlock
                                Opacity="0.72"
                                Text="{x:Bind ViewModel.SelectedSurvey.PlanFollowUpText, Mode=OneWay}"
                                TextWrapping="Wrap" />
                            <Border
                                Padding="12"
                                Background="{StaticResource ChatOSProcessBackgroundBrush}"
                                CornerRadius="8"
                                Visibility="{x:Bind ViewModel.SelectedSurvey.HasLegacyPlanCandidate, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <RichTextBlock x:Name="LegacyPlanMarkdownPreview" IsTextSelectionEnabled="True" />
                            </Border>
                            <TextBlock
                                Opacity="0.72"
                                Text="这份历史回复尚未保存为方案版本。确认仅认可方案，不会自动开始任务。"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind ViewModel.SelectedSurvey.HasLegacyPlanCandidate, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button
                                AutomationProperties.AutomationId="ChatOS.RequirementSurveys.AdoptPlan"
                                AutomationProperties.Name="保存并确认历史需求方案"
                                Click="OnAdoptPlanClick"
                                Content="保存并确认此方案"
                                HorizontalAlignment="Left"
                                IsEnabled="{x:Bind ViewModel.SelectedSurvey.CanAdoptLegacyPlan, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.SelectedSurvey.HasLegacyPlanCandidate, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>

                        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="后续执行" />
                        <TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.SelectedSurvey.ResolutionSummary, Mode=OneWay}" TextWrapping="Wrap" />

                        <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.SelectedSurvey.HasDetailedResolution, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock FontWeight="SemiBold" Text="方案" />
                            <TextBlock IsTextSelectionEnabled="True" Text="{x:Bind ViewModel.SelectedSurvey.SolutionMarkdown, Mode=OneWay}" TextWrapping="Wrap" />
                            <TextBlock Margin="0,8,0,0" FontWeight="SemiBold" Text="执行步骤" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.SelectedSurvey.ExecutionSteps, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,6" Padding="10" Background="{StaticResource ChatOSProcessBackgroundBrush}" CornerRadius="8">
                                            <StackPanel Spacing="4">
                                                <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                                                <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" />
                                                <TextBlock FontSize="11" Opacity="0.65" Text="{Binding Owner}" />
                                                <TextBlock FontSize="11" Opacity="0.65" Text="{Binding Deliverable}" TextWrapping="Wrap" />
                                                <TextBlock FontSize="11" Opacity="0.65" Text="{Binding AcceptanceCriteria}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Margin="0,8,0,0" FontWeight="SemiBold" Text="风险与待定项" />
                            <TextBlock IsTextSelectionEnabled="True" Text="{x:Bind ViewModel.SelectedSurvey.RisksAndOpenQuestions, Mode=OneWay}" TextWrapping="Wrap" />
                            <TextBlock Margin="0,8,0,0" FontWeight="SemiBold" Text="相关资料" />
                            <TextBlock IsTextSelectionEnabled="True" Text="{x:Bind ViewModel.SelectedSurvey.RelatedMaterials, Mode=OneWay}" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <StackPanel
                Grid.Column="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8"
                Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                <FontIcon FontSize="34" Glyph="&#xE8A5;" />
                <TextBlock Opacity="0.65" Text="从左侧选择一张调研查看详情" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
