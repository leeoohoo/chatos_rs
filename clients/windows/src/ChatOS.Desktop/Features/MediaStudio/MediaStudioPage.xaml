                                                        <Border MinHeight="214" Style="{StaticResource MediaStudioCardStyle}">
                                                            <StackPanel Spacing="12">
                                                                <Grid ColumnSpacing="8">
                                                                    <Border Width="38" Height="38" HorizontalAlignment="Left" Background="{StaticResource ChatOSPurpleSoftBrush}" CornerRadius="10">
                                                                        <FontIcon Glyph="&#xE714;" FontSize="17" Foreground="{StaticResource ChatOSPurpleBrush}" />
                                                                    </Border>
                                                                    <Border HorizontalAlignment="Right" VerticalAlignment="Center" Padding="8,4" Background="{StaticResource ChatOSPurpleSoftBrush}" CornerRadius="10">
                                                                        <TextBlock Text="{x:Bind StatusLabel}" Foreground="{StaticResource ChatOSPurpleBrush}" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                                                    </Border>
                                                                </Grid>
                                                                <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" Style="{StaticResource ChatOSHeadlineTextStyle}" />
                                                                <TextBlock MinHeight="36" Text="{x:Bind Description}" MaxLines="2" TextWrapping="Wrap" Style="{StaticResource ChatOSSecondaryBodyTextStyle}" />
                                                                <StackPanel Spacing="5" Visibility="{x:Bind HasSegments, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                    <Grid>
                                                                        <TextBlock Text="制作进度" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                                                        <TextBlock HorizontalAlignment="Right" Text="{x:Bind ProgressLabel}" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                                                    </Grid>
                                                                    <ProgressBar Height="5" Maximum="1" Value="{x:Bind CompletionRatio}" />
                                                                </StackPanel>
                                                                <Grid>
                                                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                                                        <TextBlock Text="{x:Bind SegmentCountLabel}" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                                                        <TextBlock Text="{x:Bind DurationLabel}" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                                                    </StackPanel>
                                                                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="6">
                                                                        <TextBlock Text="{x:Bind UpdatedAtLabel}" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                                                        <FontIcon Glyph="&#xE76C;" FontSize="11" Foreground="{StaticResource ChatOSSecondaryTextBrush}" />
                                                                    </StackPanel>
                                                                </Grid>
                                                            </StackPanel>
                                                        </Border>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button HorizontalAlignment="Center" Click="OnLoadMoreStoryProjectsClick" Content="加载更早剧情"
                                                Style="{StaticResource ChatOSSecondaryButtonStyle}"
                                                IsEnabled="{x:Bind StoryViewModel.CanLoadMoreProjects, Mode=OneWay}"
                                                Visibility="{x:Bind StoryViewModel.HasMoreProjects, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                        <Border x:Name="StoryCreateForm" MaxWidth="720" HorizontalAlignment="Stretch" Padding="22" Background="{StaticResource ChatOSSurfaceSubtleBrush}" CornerRadius="16">
                                            <StackPanel Spacing="16">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="新建剧情" Style="{StaticResource ChatOSPageTitleTextStyle}" />
                                                    <TextBlock Text="选择文本、图片和视频模型，创建后进入五段式工作台。" TextWrapping="Wrap" Style="{StaticResource ChatOSSecondaryBodyTextStyle}" />
                                                </StackPanel>
                                                <TextBox Header="标题" MaxLength="120" PlaceholderText="给剧情一个容易识别的名字" Text="{x:Bind StoryViewModel.NewTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBox Header="描述" AcceptsReturn="True" MaxLength="4000" MinHeight="80" Text="{x:Bind StoryViewModel.NewDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" />
                                                <Grid ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                    <ComboBox Header="文本模型" DisplayMemberPath="Name" ItemsSource="{x:Bind StoryViewModel.Models}" SelectedItem="{x:Bind StoryViewModel.NewTextModel, Mode=TwoWay}" />
                                                    <ComboBox Grid.Column="1" Header="图片模型" DisplayMemberPath="Name" ItemsSource="{x:Bind StoryViewModel.ImageModels}" SelectedItem="{x:Bind StoryViewModel.NewImageModel, Mode=TwoWay}" />
                                                    <ComboBox Grid.Column="2" Header="视频模型" DisplayMemberPath="Name" ItemsSource="{x:Bind StoryViewModel.VideoModels}" SelectedItem="{x:Bind StoryViewModel.NewVideoModel, Mode=TwoWay}" />
                                                </Grid>
                                                <Button Click="OnCreateStoryProjectClick" Content="创建并进入工作台" HorizontalAlignment="Stretch" IsEnabled="{x:Bind StoryViewModel.CanCreate, Mode=OneWay}" Style="{StaticResource ChatOSPrimaryButtonStyle}" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>

                                <Grid x:Name="StoryWorkspacePanel">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="1" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid Padding="16,12" ColumnSpacing="10">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <Button Click="OnCloseStoryProjectClick" Style="{StaticResource ChatOSToolbarButtonStyle}" ToolTipService.ToolTip="返回剧情列表"><FontIcon Glyph="&#xE72B;" /></Button>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind StoryViewModel.ProjectTitle, Mode=OneWay}" Style="{StaticResource ChatOSHeadlineTextStyle}" />
                                                <TextBlock Text="{x:Bind StoryViewModel.WorkspaceSummary, Mode=OneWay}" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                                            <TextBlock VerticalAlignment="Center" Text="{x:Bind StoryViewModel.StatusMessage, Mode=OneWay}" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                            <Button Click="OnOpenStoryPromptCenterClick" Content="提示词中心" Style="{StaticResource ChatOSSecondaryButtonStyle}" ToolTipService.ToolTip="查看剧情模式实际使用的提示词" />
                                            <Button Click="OnSaveStoryProjectClick" Content="保存" IsEnabled="{x:Bind StoryViewModel.CanSave, Mode=OneWay}" Style="{StaticResource ChatOSPrimaryButtonStyle}" />
                                        </StackPanel>
                                    </Grid>
                                    <Border Grid.Row="1" Background="{StaticResource ChatOSBorderBrush}" />

                                    <SelectorBar x:Name="StoryWorkspaceSectionBar" Grid.Row="2" Margin="16,8" SelectionChanged="OnStoryWorkspaceSectionChanged">
                                        <SelectorBarItem x:Name="StorySourceSectionItem" Text="原文与规划" IsSelected="True" />
                                        <SelectorBarItem x:Name="StoryStyleSectionItem" Text="风格与模型" />
                                        <SelectorBarItem x:Name="StoryPortraitsSectionItem" Text="角色与场景" />
                                        <SelectorBarItem x:Name="StorySegmentsSectionItem" Text="分段制作" />
                                        <SelectorBarItem x:Name="StoryGraphSectionItem" Text="关系与作品" />
                                    </SelectorBar>

                                    <Grid Grid.Row="3" Padding="16" ColumnSpacing="14">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="340" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <ScrollViewer x:Name="StoryOverviewScroll" Grid.ColumnSpan="2" VerticalScrollBarVisibility="Auto">
                                            <StackPanel MaxWidth="980" HorizontalAlignment="Center" Spacing="13">
                                                <Border x:Name="StorySourceSectionAnchor" Height="1" />
                                                <TextBox Header="项目标题" MaxLength="120" Text="{x:Bind StoryViewModel.ProjectTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBox Header="项目描述" AcceptsReturn="True" MaxLength="4000" MinHeight="60" Text="{x:Bind StoryViewModel.ProjectDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" />
                                                <TextBox Header="附加创作要求（规划、画面和视频全程遵守）" AcceptsReturn="True" MaxLength="2000" MinHeight="70" PlaceholderText="例如：整体更温暖、减少快速运镜、突出主角；随项目保存，可随时修改。" Text="{x:Bind StoryViewModel.CreativeRequirements, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" />
                                                <TextBox Header="剧情原文" AcceptsReturn="True" IsEnabled="{x:Bind StoryViewModel.CanEditPlanningInputs, Mode=OneWay}" MaxLength="80000" MinHeight="210" PlaceholderText="粘贴完整剧情；快速分段只生成可编辑草稿，不会调用模型。" Text="{x:Bind StoryViewModel.ProjectSource, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" />
                                                <Button Click="OnOptimizeStorySourceClick" Content="AI 优化剧情原文（先生成候选）" IsEnabled="{x:Bind StoryViewModel.CanOptimizeStorySource, Mode=OneWay}" Style="{StaticResource ChatOSSecondaryButtonStyle}" />
                                                <TextBox Header="全剧摘要" AcceptsReturn="True" MaxLength="16000" MinHeight="80" PlaceholderText="AI 规划完成后会保存在这里，也可以手动编辑。" Text="{x:Bind StoryViewModel.ProjectSummary, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" />
                                                <Border x:Name="StoryStyleSectionAnchor" Height="1" />
                                                <TextBox Header="画面风格" AcceptsReturn="True" IsEnabled="{x:Bind StoryViewModel.CanEditPlanningInputs, Mode=OneWay}" MaxLength="2000" MinHeight="90" Text="{x:Bind StoryViewModel.VisualStyle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" />
                                                <Button Click="OnOptimizeVisualStyleClick" Content="AI 优化画面风格（先生成候选）" IsEnabled="{x:Bind StoryViewModel.CanOptimizeVisualStyle, Mode=OneWay}" Style="{StaticResource ChatOSSecondaryButtonStyle}" />
                                                <ComboBox Header="画面比例" IsEnabled="{x:Bind StoryViewModel.CanEditPlanningInputs, Mode=OneWay}" ItemsSource="{x:Bind StoryViewModel.Ratios}" SelectedItem="{x:Bind StoryViewModel.ProjectRatio, Mode=TwoWay}" />
                                                <TextBlock Text="{x:Bind StoryViewModel.PlanningInputsLockLabel, Mode=OneWay}" TextWrapping="Wrap" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                                <ComboBox Header="文本模型" DisplayMemberPath="Name" ItemsSource="{x:Bind StoryViewModel.Models}" SelectedItem="{x:Bind StoryViewModel.ProjectTextModel, Mode=TwoWay}" />
                                                <ComboBox Header="图片模型" DisplayMemberPath="Name" ItemsSource="{x:Bind StoryViewModel.ImageModels}" SelectedItem="{x:Bind StoryViewModel.ProjectImageModel, Mode=TwoWay}" />
                                                <ComboBox Header="视频模型" DisplayMemberPath="Name" ItemsSource="{x:Bind StoryViewModel.VideoModels}" SelectedItem="{x:Bind StoryViewModel.ProjectVideoModel, Mode=TwoWay}" />
