                                                        </StackPanel>
                                                        <Grid ColumnSpacing="10" RowSpacing="6">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                                            <CheckBox Grid.ColumnSpan="2" Content="AI 细化未完成分段（调用文本模型）" IsChecked="{x:Bind StoryViewModel.BatchRefinements, Mode=TwoWay}" />
                                                            <CheckBox Grid.Row="1" Content="素材参考图" IsChecked="{x:Bind StoryViewModel.BatchResources, Mode=TwoWay}" />
                                                            <CheckBox Grid.Row="1" Grid.Column="1" Content="分段首帧" IsChecked="{x:Bind StoryViewModel.BatchFirstFrames, Mode=TwoWay}" />
                                                            <CheckBox Grid.Row="2" Content="分段尾帧" IsChecked="{x:Bind StoryViewModel.BatchLastFrames, Mode=TwoWay}" />
                                                            <CheckBox Grid.Row="2" Grid.Column="1" Content="分段视频" IsChecked="{x:Bind StoryViewModel.BatchVideos, Mode=TwoWay}" />
                                                        </Grid>
                                                        <TextBlock Text="{x:Bind StoryViewModel.BatchPlanLabel, Mode=OneWay}" TextWrapping="Wrap" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                                        <Grid ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                            <Button Click="OnRunStoryBatchClick" Content="开始批量生产" IsEnabled="{x:Bind StoryViewModel.CanStartBatch, Mode=OneWay}" Style="{StaticResource ChatOSPrimaryButtonStyle}" HorizontalAlignment="Stretch" />
