ARG NODE_DOWNLOAD_BASE_URL=https://npmmirror.com/mirrors/node
ARG NODE_DOWNLOAD_FALLBACK_URL=https://nodejs.org/dist
ARG NPM_REGISTRY=https://registry.npmmirror.com

FROM rust:1.94.0-bookworm AS builder

ENV CARGO_REGISTRIES_CRATES_IO_PROTOCOL=sparse
ENV CARGO_REGISTRIES_CRATES_IO_INDEX=sparse+https://rsproxy.cn/index/
ENV CARGO_NET_RETRY=10
ENV CARGO_HTTP_TIMEOUT=600
ENV CARGO_TARGET_DIR=/tmp/chatos-target
ENV RUSTUP_TOOLCHAIN=1.94.0

RUN mkdir -p "$CARGO_HOME" \
    && printf '%s\n' \
      '[source.crates-io]' \
      'replace-with = "rsproxy-sparse"' \
      '' \
      '[source.rsproxy-sparse]' \
      'registry = "sparse+https://rsproxy.cn/index/"' \
      '' \
      '[net]' \
      'git-fetch-with-cli = true' \
      > "$CARGO_HOME/config.toml"

RUN find /etc/apt -type f \( -name '*.list' -o -name '*.sources' \) -print0 \
    | xargs -0 -r sed -i \
      -e 's|http://deb.debian.org/debian|http://mirrors.aliyun.com/debian|g' \
      -e 's|https://deb.debian.org/debian|http://mirrors.aliyun.com/debian|g' \
      -e 's|http://security.debian.org/debian-security|http://mirrors.aliyun.com/debian-security|g' \
      -e 's|https://security.debian.org/debian-security|http://mirrors.aliyun.com/debian-security|g' \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
      build-essential \
      ca-certificates \
      clang \
      cmake \
      git \
      libssl-dev \
      pkg-config \
      protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY . .

ARG MANIFEST_PATH=Cargo.toml
ARG PACKAGE_NAME=
ARG BIN_NAME
ARG CARGO_BUILD_JOBS=4
ARG CARGO_TARGET_CACHE_ID=chatos-rust-target-1.94-j4
ARG CARGO_PROFILE_RELEASE_LTO=true
ARG CARGO_PROFILE_RELEASE_CODEGEN_UNITS=1

ENV CARGO_PROFILE_RELEASE_LTO=${CARGO_PROFILE_RELEASE_LTO}
ENV CARGO_PROFILE_RELEASE_CODEGEN_UNITS=${CARGO_PROFILE_RELEASE_CODEGEN_UNITS}

RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,id=${CARGO_TARGET_CACHE_ID},target=/tmp/chatos-target \
    test -n "$BIN_NAME" \
    && if [ -n "$PACKAGE_NAME" ]; then \
         cargo build --release --ignore-rust-version --jobs "$CARGO_BUILD_JOBS" --manifest-path "$MANIFEST_PATH" -p "$PACKAGE_NAME" --bin "$BIN_NAME"; \
       else \
         cargo build --release --ignore-rust-version --jobs "$CARGO_BUILD_JOBS" --manifest-path "$MANIFEST_PATH" --bin "$BIN_NAME"; \
       fi \
    && mkdir -p /out \
    && cp "$CARGO_TARGET_DIR/release/$BIN_NAME" /out/service

FROM debian:bookworm-slim AS runtime-deps

ARG BIN_NAME
ARG AGENT_BROWSER_VERSION=0.31.2
ARG NODE_VERSION=24.4.1
ARG NODE_DOWNLOAD_BASE_URL
ARG NODE_DOWNLOAD_FALLBACK_URL
ARG NPM_REGISTRY

RUN find /etc/apt -type f \( -name '*.list' -o -name '*.sources' \) -print0 \
    | xargs -0 -r sed -i \
      -e 's|http://deb.debian.org/debian|http://mirrors.aliyun.com/debian|g' \
      -e 's|https://deb.debian.org/debian|http://mirrors.aliyun.com/debian|g' \
      -e 's|http://security.debian.org/debian-security|http://mirrors.aliyun.com/debian-security|g' \
      -e 's|https://security.debian.org/debian-security|http://mirrors.aliyun.com/debian-security|g' \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        bash \
        ca-certificates \
        curl \
        git \
        openssh-client \
        ripgrep \
        tzdata \
    && if [ "$BIN_NAME" = "chat_app_server_rs" ]; then \
         apt-get install -y --no-install-recommends chromium xz-utils \
         && node_arch="$(dpkg --print-architecture)" \
         && case "$node_arch" in \
              amd64) node_arch=x64 ;; \
              arm64) node_arch=arm64 ;; \
              *) echo "unsupported Node.js architecture: $node_arch" >&2; exit 1 ;; \
            esac \
         && node_archive="node-v${NODE_VERSION}-linux-${node_arch}.tar.xz" \
         && download_node_file() { \
              node_path="$1"; node_destination="$2"; \
              for node_base_url in "$NODE_DOWNLOAD_BASE_URL" "$NODE_DOWNLOAD_FALLBACK_URL"; do \
                if curl -fL --retry 5 --retry-delay 2 --retry-all-errors \
                  "${node_base_url}/v${NODE_VERSION}/${node_path}" -o "$node_destination"; then \
                  return 0; \
                fi; \
              done; \
              return 1; \
            } \
         && download_node_file "$node_archive" "/tmp/${node_archive}" \
         && download_node_file SHASUMS256.txt /tmp/node-shasums.txt \
         && grep "  ${node_archive}$" /tmp/node-shasums.txt > /tmp/node-sha256.txt \
         && (cd /tmp && sha256sum -c node-sha256.txt) \
         && tar -xJf "/tmp/${node_archive}" -C /usr/local --strip-components=1 \
         && rm -f "/tmp/${node_archive}" /tmp/node-shasums.txt /tmp/node-sha256.txt \
         && npm install --global --registry "$NPM_REGISTRY" "agent-browser@${AGENT_BROWSER_VERSION}"; \
       fi \
    && rm -rf /var/lib/apt/lists/*

ENV AGENT_BROWSER_BIN=/usr/local/bin/agent-browser
ENV AGENT_BROWSER_EXECUTABLE_PATH=/usr/bin/chromium

FROM runtime-deps AS runtime-base

COPY --from=builder /out/service /usr/local/bin/chatos-service
COPY docker/entrypoint-rust-service.sh /usr/local/bin/chatos-rust-service-entrypoint
RUN sed -i 's/\r$//' /usr/local/bin/chatos-rust-service-entrypoint \
    && chmod 755 /usr/local/bin/chatos-rust-service-entrypoint

WORKDIR /app
ENV RUST_LOG=info

ENTRYPOINT ["chatos-rust-service-entrypoint"]

FROM runtime-base AS runtime
