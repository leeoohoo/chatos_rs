#!/bin/sh
# Firefox still reads protected macOS app data even with an explicit profile.
set -eu
: "${CHATOS_PLUGIN_CACHE_DIR:?Missing isolated Plugin cache}"
firefox_bin='/Applications/Firefox.app/Contents/MacOS/firefox'
if [ ! -x "$firefox_bin" ]; then
  echo 'Firefox is not installed.' >&2
  exit 69
fi
mkdir -p "$CHATOS_PLUGIN_CACHE_DIR/officecli-browser-profiles"
render_profile=$(mktemp -d "$CHATOS_PLUGIN_CACHE_DIR/officecli-browser-profiles/firefox.XXXXXXXX")
firefox_app_data="$CHATOS_PLUGIN_CACHE_DIR/firefox-app-data"
mkdir -p "$firefox_app_data"
screenshot=''
for argument in "$@"; do
  case "$argument" in
    --screenshot=*) screenshot=${argument#--screenshot=} ;;
  esac
done
cleanup() {
  if [ -n "${firefox_pid:-}" ] && kill -0 "$firefox_pid" 2>/dev/null; then
    kill -TERM "$firefox_pid" 2>/dev/null || true
    wait "$firefox_pid" 2>/dev/null || true
  fi
  /bin/rm -rf -- "$render_profile"
}
trap cleanup EXIT
firefox_pid=''
CFFIXED_USER_HOME="$firefox_app_data" \
MOZ_APP_DATA="$firefox_app_data" \
MOZ_LOCAL_APP_DATA="$firefox_app_data" \
MOZ_HEADLESS=1 \
  "$firefox_bin" --new-instance --profile "$render_profile" "$@" &
firefox_pid=$!

attempts=0
while [ -n "$screenshot" ] && [ ! -s "$screenshot" ] \
    && kill -0 "$firefox_pid" 2>/dev/null && [ "$attempts" -lt 300 ]; do
  /bin/sleep 0.1
  attempts=$((attempts + 1))
done
if [ -n "$screenshot" ] && [ -s "$screenshot" ]; then
  /bin/sleep 1
  exit 0
fi
if kill -0 "$firefox_pid" 2>/dev/null; then
  echo 'Firefox did not finish the screenshot within 30 seconds.' >&2
  exit 1
fi
if wait "$firefox_pid"; then
  status=0
else
  status=$?
fi
firefox_pid=''
exit "$status"
