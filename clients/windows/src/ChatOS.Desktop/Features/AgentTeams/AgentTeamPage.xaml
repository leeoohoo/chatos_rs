<UserControl
    x:Class="ChatOS.Desktop.Features.AgentTeams.AgentTeamPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:domain="using:ChatOS.Core.Domain"
    xmlns:presentation="using:ChatOS.Presentation.AgentTeams">

    <Grid
        AutomationProperties.AutomationId="ChatOS.AgentTeam.Root"
        AutomationProperties.Name="Agent 团队工作区"
        Background="{StaticResource ChatOSWorkspaceBackgroundBrush}">
        <Grid RowSpacing="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid MinHeight="64" Padding="14,10" ColumnSpacing="18" Background="{StaticResource ChatOSSidebarBackgroundBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="5">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Width="34" Height="34" Background="{StaticResource ChatOSPurpleSoftBrush}" CornerRadius="10">
                            <FontIcon Glyph="&#xE716;" FontSize="17" Foreground="{StaticResource ChatOSPurpleBrush}" />
                        </Border>
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource ChatOSHeadlineTextStyle}" Text="{x:Bind SelectedRoomName, Mode=OneTime}" />
                    </StackPanel>
                    <TextBlock Margin="44,0,0,0" MaxWidth="820" Text="{x:Bind SelectedRoomGoal, Mode=OneTime}" TextTrimming="CharacterEllipsis" Style="{StaticResource ChatOSCaptionTextStyle}" />
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                    <Button Click="OnOpenDirectClick" Content="打开私聊" Style="{StaticResource ChatOSSecondaryButtonStyle}" />
                    <Button Click="OnNewAgentClick" Content="新建 Agent" Style="{StaticResource ChatOSSecondaryButtonStyle}" />
                    <Button Click="OnNewTeamClick" Content="新建团队" IsEnabled="{x:Bind ViewModel.CanCreateTeam, Mode=OneWay}" Style="{StaticResource ChatOSPrimaryButtonStyle}" />
                    <Button AutomationProperties.Name="运行等待队列" Click="OnRunAgentsClick" Style="{StaticResource ChatOSToolbarButtonStyle}" ToolTipService.ToolTip="运行等待队列">
                        <FontIcon Glyph="&#xE768;" />
                    </Button>
                    <Button AutomationProperties.Name="刷新 Agent 团队" Click="OnRefreshClick" Style="{StaticResource ChatOSToolbarButtonStyle}" ToolTipService.ToolTip="刷新">
                        <FontIcon Glyph="&#xE72C;" />
                    </Button>
                </StackPanel>
            </Grid>

            <InfoBar
                Grid.Row="1"
                Margin="10,6"
                IsOpen="{x:Bind HasNotice, Mode=OneTime}"
                IsClosable="False"
                Message="{x:Bind Notice, Mode=OneTime}"
                Severity="{x:Bind NoticeSeverity, Mode=OneTime}" />

            <Grid Grid.Row="2" Padding="14,0,14,14" ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="248" />
                </Grid.ColumnDefinitions>

                <Pivot
                    x:Name="TeamPivot"
                    AutomationProperties.AutomationId="ChatOS.AgentTeam.Navigation"
                    AutomationProperties.Name="团队页面导航"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch">
                    <PivotItem Header="总览">
                        <ScrollViewer Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="12">
                                <Border Style="{StaticResource ChatOSSectionCardStyle}">
                                    <Grid ColumnSpacing="18">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="260" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="7">
                                            <TextBlock Text="当前阶段" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{x:Bind OverviewStageTitle, Mode=OneTime}" Style="{StaticResource ChatOSHeadlineTextStyle}" />
                                                <Border Padding="8,3" Background="{StaticResource ChatOSAccentSoftBrush}" CornerRadius="8">
                                                    <TextBlock Text="{x:Bind OverviewStageStatus, Mode=OneTime}" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock MaxWidth="760" Text="{x:Bind OverviewStageDescription, Mode=OneTime}" TextWrapping="Wrap" Style="{StaticResource ChatOSSecondaryBodyTextStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8">
                                            <Grid>
                                                <TextBlock Text="任务完成度" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                                <TextBlock HorizontalAlignment="Right" Text="{x:Bind TodoProgressLabel, Mode=OneTime}" Style="{StaticResource ChatOSBodyStrongTextStyle}" />
                                            </Grid>
                                            <ProgressBar Height="6" Maximum="100" Value="{x:Bind TodoProgressPercent, Mode=OneTime}" />
                                            <StackPanel Orientation="Horizontal" Spacing="18">
                                                <TextBlock><Run Text="{x:Bind ActiveTodoCount, Mode=OneTime}" /><Run Text=" 进行中" /></TextBlock>
                                                <TextBlock><Run Text="{x:Bind PendingTodoCount, Mode=OneTime}" /><Run Text=" 等待" /></TextBlock>
                                                <TextBlock><Run Text="{x:Bind BlockedTodoCount, Mode=OneTime}" /><Run Text=" 需处理" /></TextBlock>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource ChatOSSectionCardStyle}">
                                        <StackPanel Spacing="9">
                                            <Grid>
                                                <TextBlock Text="需要你处理" Style="{StaticResource ChatOSHeadlineTextStyle}" />
                                                <Border HorizontalAlignment="Right" Padding="8,3" Background="{StaticResource ChatOSSurfaceSubtleBrush}" CornerRadius="8">
                                                    <TextBlock Text="{x:Bind PendingProposalCount, Mode=OneTime}" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="仅显示必须由你决定的成员变更提案" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                            <ListView MaxHeight="220" Background="Transparent" BorderThickness="0" ItemsSource="{x:Bind ViewModel.StaffingProposals}" SelectionMode="None">
                                                <ListView.ItemTemplate>
                                                    <DataTemplate x:DataType="domain:AgentStaffingProposal">
                                                        <Border Margin="0,0,0,7" Padding="11" Background="{StaticResource ChatOSSurfaceSubtleBrush}" CornerRadius="9">
                                                            <Grid ColumnSpacing="10">
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                                <StackPanel Spacing="3">
                                                                    <TextBlock Text="{x:Bind Draft.Name}" Style="{StaticResource ChatOSBodyStrongTextStyle}" />
                                                                    <TextBlock Text="{x:Bind Draft.Rationale}" TextWrapping="Wrap" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="5">
                                                                    <Button Click="OnApproveStaffingProposalClick" Content="批准" Style="{StaticResource ChatOSPrimaryButtonStyle}" />
                                                                    <Button Click="OnRejectStaffingProposalClick" Content="拒绝" Style="{StaticResource ChatOSSecondaryButtonStyle}" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ListView.ItemTemplate>
                                            </ListView>
                                            <TextBlock HorizontalAlignment="Center" Text="当前没有需要处理的事项" Foreground="{StaticResource ChatOSSuccessBrush}" Visibility="{x:Bind HasPendingProposals, Mode=OneTime, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Style="{StaticResource ChatOSSectionCardStyle}">
                                        <StackPanel Spacing="9">
                                            <TextBlock Text="当前执行" Style="{StaticResource ChatOSHeadlineTextStyle}" />
                                            <TextBlock Text="任务状态由系统实时汇总" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                            <ProgressBar Height="6" Maximum="100" Value="{x:Bind TodoProgressPercent, Mode=OneTime}" />
                                            <TextBlock Text="{x:Bind ExecutionSummary, Mode=OneTime}" TextWrapping="Wrap" Style="{StaticResource ChatOSSecondaryBodyTextStyle}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource ChatOSSectionCardStyle}">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="里程碑" Style="{StaticResource ChatOSHeadlineTextStyle}" />
                                            <TextBlock Text="由项目经理维护，任务事实由系统校验" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                            <TextBlock Text="{x:Bind MilestoneSummary, Mode=OneTime}" TextWrapping="Wrap" Style="{StaticResource ChatOSSecondaryBodyTextStyle}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Style="{StaticResource ChatOSSectionCardStyle}">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="项目经理简报" Style="{StaticResource ChatOSHeadlineTextStyle}" />
                                            <TextBlock Text="尚未生成" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                            <TextBlock Text="项目经理会在收到任务状态、调研和审批变化后维护阶段判断、风险与下一步。" TextWrapping="Wrap" Style="{StaticResource ChatOSSecondaryBodyTextStyle}" />
                                            <Button HorizontalAlignment="Right" Click="OnOpenRequirementSurveysClick" Content="查看需求调研" Style="{StaticResource ChatOSSecondaryButtonStyle}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </PivotItem>

                    <PivotItem Header="聊天">
                    <Grid Margin="0,10,0,0" ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="268" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource ChatOSSectionCardStyle}" Padding="0">
                            <Grid RowSpacing="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="1" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid Padding="16,14" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="团队与私聊" Style="{StaticResource ChatOSHeadlineTextStyle}" />
                                        <TextBlock Text="选择一个会话继续协作" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Click="OnNewTeamClick" Style="{StaticResource ChatOSToolbarButtonStyle}" ToolTipService.ToolTip="新建团队">
                                        <FontIcon Glyph="&#xE710;" />
                                    </Button>
                                </Grid>
                                <Border Grid.Row="1" Background="{StaticResource ChatOSBorderBrush}" />
                                <ListView
                                    Grid.Row="2"
                                    Padding="7"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    ItemContainerStyle="{StaticResource ChatOSSidebarItemStyle}"
                                    ItemsSource="{x:Bind ViewModel.Rooms}"
                                    SelectedItem="{x:Bind ViewModel.SelectedRoom, Mode=TwoWay}"
                                    SelectionChanged="OnRoomSelectionChanged">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="domain:AgentRoom">
                                            <Grid Padding="3" ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="32" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="30" Height="30" Background="{StaticResource ChatOSPurpleSoftBrush}" CornerRadius="9">
                                                    <FontIcon Glyph="&#xE716;" FontSize="14" Foreground="{StaticResource ChatOSPurpleBrush}" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                    <TextBlock FontWeight="SemiBold" Text="{x:Bind Draft.Name}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{x:Bind Kind, Converter={StaticResource AgentTeamDisplayTextConverter}}" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource ChatOSSectionCardStyle}" Padding="0">
                            <Grid RowSpacing="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="1" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="1" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Padding="18,14" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="{x:Bind SelectedRoomName, Mode=OneTime}" Style="{StaticResource ChatOSHeadlineTextStyle}" />
                                        <TextBlock MaxWidth="620" Text="{x:Bind SelectedRoomGoal, Mode=OneTime}" TextWrapping="Wrap" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                        <Button Click="OnConfigureTeamClick" Content="团队设置" IsEnabled="{x:Bind ViewModel.CanConfigureTeam, Mode=OneWay}" Style="{StaticResource ChatOSSecondaryButtonStyle}" />
                                        <Button Click="OnAddMemberClick" Content="添加成员" IsEnabled="{x:Bind ViewModel.CanConfigureTeam, Mode=OneWay}" Style="{StaticResource ChatOSSecondaryButtonStyle}" />
                                    </StackPanel>
                                </Grid>
                                <Border Grid.Row="1" Background="{StaticResource ChatOSBorderBrush}" />

                                <ScrollViewer Grid.Row="2" Padding="18,10" HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.Members}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="7" /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="domain:AgentRoomMember">
                                                <Button Click="OnMemberClick" Content="{x:Bind Draft.Role}" Style="{StaticResource ChatOSSecondaryButtonStyle}" ToolTipService.ToolTip="{x:Bind Draft.Responsibility}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <ListView Grid.Row="3" Padding="14,6" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" ItemsSource="{x:Bind ViewModel.MessageItems}" SelectionMode="None">
                                    <ListView.Header>
                                        <Grid Padding="0,5,0,7" Visibility="{x:Bind ViewModel.HasEarlierMessages, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Button HorizontalAlignment="Center" Click="OnLoadEarlierMessagesClick" Content="加载更早消息" Style="{StaticResource ChatOSSecondaryButtonStyle}" Visibility="{x:Bind ViewModel.IsLoadingEarlierMessages, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                            <ProgressRing Width="20" Height="20" HorizontalAlignment="Center" IsActive="{x:Bind ViewModel.IsLoadingEarlierMessages, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsLoadingEarlierMessages, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </Grid>
                                    </ListView.Header>
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="IsTabStop" Value="False" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="presentation:AgentMessageItemViewModel">
                                            <Border MaxWidth="720" Margin="0,4" Padding="13" HorizontalAlignment="{x:Bind IsHuman, Converter={StaticResource AgentMessageAlignmentConverter}}" Background="{x:Bind IsHuman, Converter={StaticResource AgentMessageBubbleBrushConverter}}" CornerRadius="11">
                                                <StackPanel Spacing="5">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <Border Width="25" Height="25" Background="{StaticResource ChatOSPurpleSoftBrush}" CornerRadius="8" Visibility="{x:Bind IsHuman, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                                            <FontIcon Glyph="{x:Bind SenderGlyph}" FontSize="12" Foreground="{StaticResource ChatOSPurpleBrush}" />
                                                        </Border>
                                                        <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{x:Bind SenderLabel}" />
                                                    </StackPanel>
                                                    <TextBlock Text="{x:Bind Content}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                                    <ItemsControl ItemsSource="{x:Bind Attachments}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="domain:AgentMessageAttachment">
                                                                <StackPanel Margin="0,2,0,0" Orientation="Horizontal" Spacing="4">
                                                                    <Button Click="OnPreviewAttachmentClick" Content="{x:Bind Name}" Style="{StaticResource ChatOSSecondaryButtonStyle}" FontSize="11" />
                                                    <Button AutomationProperties.Name="下载附件" Click="OnDownloadAttachmentClick" Style="{StaticResource ChatOSToolbarButtonStyle}" ToolTipService.ToolTip="另存为"><FontIcon Glyph="&#xE896;" FontSize="12" /></Button>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <TextBlock Text="{x:Bind TimestampLabel}" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>

                                <Border Grid.Row="4" Background="{StaticResource ChatOSBorderBrush}" />
                                <StackPanel Grid.Row="5" Padding="14" Spacing="8">
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.PendingAttachments}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="domain:AgentMessageAttachment">
                                                <Button Click="OnRemoveAttachmentClick" Content="{x:Bind Name}" Style="{StaticResource ChatOSSecondaryButtonStyle}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                                <Button AutomationProperties.Name="添加附件" Click="OnAddAttachmentClick" Style="{StaticResource ChatOSToolbarButtonStyle}" ToolTipService.ToolTip="添加附件">
                                            <FontIcon Glyph="&#xE723;" />
                                        </Button>
                                        <TextBox Grid.Column="1" AcceptsReturn="True" MaxHeight="140" PlaceholderText="给团队发消息；未选择 @ 时会路由给默认 Agent" Text="{x:Bind ViewModel.MessageText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" />
                                        <Button Grid.Column="2" Click="OnMentionSendClick" Content="@ 发送" Style="{StaticResource ChatOSSecondaryButtonStyle}" />
                                        <Button Grid.Column="3" Click="OnSendClick" Content="发送" Style="{StaticResource ChatOSPrimaryButtonStyle}" />
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </PivotItem>

                    <PivotItem Header="任务">
                    <Grid Margin="0,10,0,0" RowSpacing="12">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Grid>
                            <StackPanel Spacing="3">
                                <TextBlock Text="团队任务" Style="{StaticResource ChatOSHeadlineTextStyle}" />
                                <TextBlock Text="排序、分派并跟踪团队接下来要完成的工作。" Style="{StaticResource ChatOSCaptionTextStyle}" />
                            </StackPanel>
                            <Button HorizontalAlignment="Right" Click="OnNewTodoClick" Content="新建 Todo" IsEnabled="{x:Bind ViewModel.HasRoom, Mode=OneWay}" Style="{StaticResource ChatOSPrimaryButtonStyle}" />
                        </Grid>
                        <Grid Grid.Row="1">
                            <ListView Background="Transparent" BorderThickness="0" ItemsSource="{x:Bind ViewModel.TodoItems}" SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="presentation:AgentTodoItemViewModel">
                                        <Border Margin="0,0,0,9" Style="{StaticResource ChatOSSectionCardStyle}">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="{x:Bind Title}" Style="{StaticResource ChatOSHeadlineTextStyle}" />
                                                    <TextBlock Text="{x:Bind Detail}" TextWrapping="Wrap" Style="{StaticResource ChatOSSecondaryBodyTextStyle}" />
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <Border Padding="9,4" Background="{StaticResource ChatOSAccentSoftBrush}" CornerRadius="9"><TextBlock Text="{x:Bind StatusLabel}" Style="{StaticResource ChatOSCaptionTextStyle}" /></Border>
                                                        <Border Padding="9,4" Background="{StaticResource ChatOSSurfaceSubtleBrush}" CornerRadius="9"><TextBlock Text="{x:Bind AssigneeLabel}" Style="{StaticResource ChatOSCaptionTextStyle}" /></Border>
                                                        <Border Padding="9,4" Background="{StaticResource ChatOSSurfaceSubtleBrush}" CornerRadius="9"><TextBlock Text="{x:Bind PriorityLabel}" Style="{StaticResource ChatOSCaptionTextStyle}" /></Border>
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="6">
                                                    <Button Click="OnTodoUpClick" Content="↑" Tag="{x:Bind Todo}" Style="{StaticResource ChatOSToolbarButtonStyle}" />
                                                    <Button Click="OnTodoDownClick" Content="↓" Tag="{x:Bind Todo}" Style="{StaticResource ChatOSToolbarButtonStyle}" />
                                                    <Button Click="OnEditTodoClick" Content="更新" Tag="{x:Bind Todo}" Style="{StaticResource ChatOSSecondaryButtonStyle}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Visibility="{x:Bind HasTodos, Mode=OneTime, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                <FontIcon Glyph="&#xE9D5;" FontSize="24" Foreground="{StaticResource ChatOSPurpleBrush}" />
                                <TextBlock HorizontalAlignment="Center" Text="暂无团队任务" Style="{StaticResource ChatOSHeadlineTextStyle}" />
                                <TextBlock Text="选择团队后创建任务，并分派给对应 Agent。" Style="{StaticResource ChatOSCaptionTextStyle}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </PivotItem>

                    <PivotItem Header="需求调研">
                        <Grid Margin="0,10,0,0">
                            <StackPanel MaxWidth="440" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="11">
                                <Border Style="{StaticResource ChatOSEmptyStateIconStyle}">
                                    <FontIcon Glyph="&#xE9D5;" FontSize="23" Foreground="{StaticResource ChatOSPurpleBrush}" />
                                </Border>
                                <TextBlock HorizontalAlignment="Center" Text="需求调研已迁移" Style="{StaticResource ChatOSHeadlineTextStyle}" />
                                <TextBlock Text="Task 调研由本机任务保存并恢复 Run。打开项目需求调研后可查看问题、填写答案并继续执行。" TextAlignment="Center" TextWrapping="Wrap" Style="{StaticResource ChatOSSecondaryBodyTextStyle}" />
                                <Button AutomationProperties.AutomationId="ChatOS.AgentTeam.OpenRequirementSurveys" AutomationProperties.Name="打开需求调研" Click="OnOpenRequirementSurveysClick" Content="打开需求调研" Style="{StaticResource ChatOSPrimaryButtonStyle}" />
                            </StackPanel>
                        </Grid>
                    </PivotItem>

                    <PivotItem Header="共享资产">
                    <Grid Margin="0,10,0,0" RowSpacing="12">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Grid>
                            <StackPanel Spacing="3">
                                <TextBlock Text="团队资产" Style="{StaticResource ChatOSHeadlineTextStyle}" />
                                <TextBlock Text="沉淀所有成员都能复用的上下文、规范和交付物。" Style="{StaticResource ChatOSCaptionTextStyle}" />
                            </StackPanel>
                            <Button HorizontalAlignment="Right" Click="OnNewAssetClick" Content="新建团队资产" IsEnabled="{x:Bind ViewModel.HasRoom, Mode=OneWay}" Style="{StaticResource ChatOSPrimaryButtonStyle}" />
                        </Grid>
                        <Grid Grid.Row="1">
                            <ListView Background="Transparent" BorderThickness="0" ItemsSource="{x:Bind ViewModel.Assets}" SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="domain:AgentTeamAsset">
                                        <Border Margin="0,0,0,9" Style="{StaticResource ChatOSSectionCardStyle}">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <Expander HorizontalAlignment="Stretch">
                                                    <Expander.Header>
                                                        <StackPanel Spacing="3">
                                                            <TextBlock Text="{x:Bind Title}" Style="{StaticResource ChatOSHeadlineTextStyle}" />
                                                            <TextBlock Text="{x:Bind Category, Converter={StaticResource AgentTeamDisplayTextConverter}}" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                                        </StackPanel>
                                                    </Expander.Header>
                                                    <TextBlock Margin="0,10,0,4" IsTextSelectionEnabled="True" Text="{x:Bind Markdown}" TextWrapping="Wrap" Style="{StaticResource ChatOSSecondaryBodyTextStyle}" />
                                                </Expander>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="7">
                                                    <Button Click="OnAssetHistoryClick" Content="版本历史" Style="{StaticResource ChatOSSecondaryButtonStyle}" />
                                                    <Button Click="OnEditAssetClick" Content="编辑" Style="{StaticResource ChatOSSecondaryButtonStyle}" />
                                                    <Button Click="OnArchiveAssetClick" Content="归档" Style="{StaticResource ChatOSSecondaryButtonStyle}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <StackPanel AutomationProperties.AutomationId="ChatOS.AgentTeam.Assets.Empty" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Visibility="{x:Bind HasAssets, Mode=OneTime, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                <Border Style="{StaticResource ChatOSEmptyStateIconStyle}">
                                    <FontIcon Glyph="&#xE8A5;" FontSize="23" Foreground="{StaticResource ChatOSPurpleBrush}" />
                                </Border>
                                <TextBlock HorizontalAlignment="Center" Text="还没有共享资产" Style="{StaticResource ChatOSHeadlineTextStyle}" />
                                <TextBlock MaxWidth="420" Text="在这里维护项目背景、进度、技术栈和架构决策。" TextAlignment="Center" TextWrapping="Wrap" Style="{StaticResource ChatOSCaptionTextStyle}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </PivotItem>

                    <PivotItem Header="运行">
                    <Grid Margin="0,10,0,0" RowSpacing="12">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="3">
                                <TextBlock Text="Agent 运行" Style="{StaticResource ChatOSHeadlineTextStyle}" />
                                <TextBlock Text="查看运行状态、耗时、模型调用和错误详情。" Style="{StaticResource ChatOSCaptionTextStyle}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" DisplayMemberPath="Label" ItemsSource="{x:Bind ViewModel.RunAgentFilters}" SelectedItem="{x:Bind ViewModel.SelectedRunAgentFilter, Mode=TwoWay}" />
                        </Grid>
                        <Grid Grid.Row="1">
                            <ListView Background="Transparent" BorderThickness="0" ItemsSource="{x:Bind ViewModel.VisibleRunItems}" SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="presentation:AgentRunItemViewModel">
                                        <Border Margin="0,0,0,9" Style="{StaticResource ChatOSSectionCardStyle}">
                                            <Grid ColumnSpacing="14">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <StackPanel Spacing="5">
                                                    <StackPanel Orientation="Horizontal" Spacing="9">
                                                        <TextBlock Text="{x:Bind AgentLabel}" Style="{StaticResource ChatOSBodyStrongTextStyle}" />
                                                        <Border Padding="8,3" Background="{StaticResource ChatOSAccentSoftBrush}" CornerRadius="8"><TextBlock Text="{x:Bind StatusLabel}" Style="{StaticResource ChatOSCaptionTextStyle}" /></Border>
                                                    </StackPanel>
                                                    <TextBlock Style="{StaticResource ChatOSCaptionTextStyle}"><Run Text="{x:Bind ModelCallsLabel}" /><Run Text=" · 耗时 " /><Run Text="{x:Bind DurationLabel}" /><Run Text=" · 更新于 " /><Run Text="{x:Bind UpdatedAtLabel}" /></TextBlock>
                                                    <TextBlock Foreground="{StaticResource ChatOSFailureBrush}" Text="{x:Bind LastError}" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <Button Grid.Column="1" VerticalAlignment="Center" Click="OnInspectRunClick" Content="查看详情" Style="{StaticResource ChatOSSecondaryButtonStyle}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Visibility="{x:Bind ViewModel.HasVisibleRuns, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                <FontIcon Glyph="&#xE9D9;" FontSize="24" Foreground="{StaticResource ChatOSPurpleBrush}" />
                                <TextBlock HorizontalAlignment="Center" Text="暂无运行记录" Style="{StaticResource ChatOSHeadlineTextStyle}" />
                                <TextBlock Text="Agent 被消息、心跳或团队任务唤醒后会显示在这里。" Style="{StaticResource ChatOSCaptionTextStyle}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                    </PivotItem>
                </Pivot>

                <Border Grid.Column="1" Margin="0,10,0,0" Padding="0" Style="{StaticResource ChatOSSectionCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="1" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Padding="14,13" ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="团队成员" Style="{StaticResource ChatOSHeadlineTextStyle}" />
                                <TextBlock Text="点击成员查看职责" Style="{StaticResource ChatOSCaptionTextStyle}" />
                            </StackPanel>
                            <Border Grid.Column="1" VerticalAlignment="Top" Padding="8,3" Background="{StaticResource ChatOSPurpleSoftBrush}" CornerRadius="10">
                                <TextBlock Text="{x:Bind MemberCount, Mode=OneTime}" Foreground="{StaticResource ChatOSPurpleBrush}" Style="{StaticResource ChatOSCaptionTextStyle}" />
                            </Border>
                        </Grid>
                        <Border Grid.Row="1" Background="{StaticResource ChatOSBorderBrush}" />
                        <Grid Grid.Row="2">
                            <ListView AutomationProperties.AutomationId="ChatOS.AgentTeam.Members" AutomationProperties.Name="团队成员" Padding="8" Background="Transparent" BorderThickness="0" ItemsSource="{x:Bind ViewModel.Members}" SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="domain:AgentRoomMember">
                                        <Button Margin="0,0,0,7" Padding="10" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Click="OnMemberClick" Style="{StaticResource ChatOSSecondaryButtonStyle}">
                                            <Grid ColumnSpacing="9">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <Border Width="34" Height="34" Background="{StaticResource ChatOSPurpleSoftBrush}" CornerRadius="10">
                                                    <FontIcon Glyph="&#xE77B;" FontSize="15" Foreground="{StaticResource ChatOSPurpleBrush}" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock Text="{x:Bind Draft.Role}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{x:Bind Draft.Responsibility}" TextTrimming="CharacterEllipsis" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="7" Visibility="{x:Bind HasMembers, Mode=OneTime, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                <FontIcon Glyph="&#xE77B;" FontSize="23" Foreground="{StaticResource ChatOSPurpleBrush}" />
                                <TextBlock Text="尚未添加团队成员" Style="{StaticResource ChatOSBodyStrongTextStyle}" />
                                <TextBlock MaxWidth="190" Text="先创建 Agent，再将其加入当前团队。" TextAlignment="Center" TextWrapping="Wrap" Style="{StaticResource ChatOSCaptionTextStyle}" />
                            </StackPanel>
                        </Grid>
                        <Button Grid.Row="3" Margin="12" HorizontalAlignment="Stretch" Click="OnAddMemberClick" Content="添加成员" IsEnabled="{x:Bind ViewModel.CanConfigureTeam, Mode=OneWay}" Style="{StaticResource ChatOSSecondaryButtonStyle}" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
