{
  "name": "@chatos/web-design-studio",
  "version": "0.9.0",
  "description": "AI-editable visual website design workbench for ChatOS and Codex.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "chatos-web-design-studio": "bin/chatos-web-design-studio"
  },
  "files": [
    "assets/",
    "bin/",
    "dist/",
    "!dist/*.test.mjs",
    "docs/",
    "skills/",
    "ui/",
    ".codex-plugin/",
    ".mcp.json",
    "chatos.plugin.json",
    "README.md"
  ],
  "scripts": {
    "dev": "vite",
    "sync:inspira": "node scripts/sync-inspira-registry.mjs",
    "build": "vite build && node scripts/build.mjs",
    "studio": "node bin/chatos-web-design-studio studio",
    "studio:dev": "npm run build && npm run studio",
    "mcp": "node dist/mcp-server.mjs mcp",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "pack:verify": "npm run test && npm pack --dry-run"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.4",
    "@chakra-ui/react": "3.37.0",
    "@emotion/react": "11.14.0",
    "@internationalized/date": "3.12.3",
    "@inspira-ui/plugins": "0.0.2",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@vueuse/core": "14.2.1",
    "@tiptap/react": "3.6.6",
    "@tiptap/starter-kit": "3.6.6",
    "antd": "6.6.2",
    "class-variance-authority": "0.7.1",
    "daisyui": "^5.7.28",
    "express": "5.1.0",
    "lucide-react": "1.39.0",
    "proper-lockfile": "4.1.2",
    "radix-ui": "1.6.7",
    "motion-v": "2.3.0",
    "ogl": "1.0.11",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "simplex-noise": "4.0.3",
    "theme-colors": "0.1.0",
    "three": "0.183.2",
    "vue": "3.5.29"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.2.1",
    "@types/express": "5.0.3",
    "@types/node": "24.5.2",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.4",
    "@vitejs/plugin-vue": "6.0.1",
    "esbuild": "0.25.10",
    "typescript": "5.9.2",
    "vite": "7.3.6"
  }
}
