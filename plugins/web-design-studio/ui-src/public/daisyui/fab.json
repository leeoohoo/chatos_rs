{
  "slug": "fab",
  "title": "FAB / Speed Dial",
  "description": "FAB (Floating Action Button) stays in the bottom corner of screen. It includes a focusable and accessible element with button role. Clicking or focusing it shows additional buttons (known as Speed Dial buttons) in a vertical arrangement or a flower shape (quarter circle).",
  "demos": [
    {
      "id": "fab-1",
      "label": "FAB and Speed Dial (vertical)",
      "html": "<div class=\"fab\">\n  <!-- a focusable div with tabindex is necessary to work on all browsers. role=\"button\" is necessary for accessibility -->\n  <div tabindex=\"0\" role=\"button\" class=\"btn btn-lg btn-circle btn-primary\">F</div>\n\n  <!-- buttons that show up when FAB is open -->\n  <button class=\"btn btn-lg btn-circle\">A</button>\n  <button class=\"btn btn-lg btn-circle\">B</button>\n  <button class=\"btn btn-lg btn-circle\">C</button>\n</div>"
    },
