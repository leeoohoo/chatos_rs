<Page
    x:Class="ChatOS.Desktop.Features.MediaStudio.MediaStudioPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:ChatOS.Core.Domain"
    xmlns:media="using:ChatOS.Desktop.Features.MediaStudio"
    AutomationProperties.AutomationId="ChatOS.MediaStudio.Root"
    AutomationProperties.Name="AI 创作">

    <Page.Resources>
        <media:FilePathToImageSourceConverter x:Key="FilePathToImageSourceConverter" />
    </Page.Resources>

    <Grid Background="{StaticResource ChatOSWorkspaceBackgroundBrush}">
        <Grid Padding="28,22,28,26" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="11">
                    <Border Width="38" Height="38" Background="{StaticResource ChatOSPurpleSoftBrush}" CornerRadius="11">
                        <FontIcon Glyph="&#xE735;" FontSize="19" Foreground="{StaticResource ChatOSPurpleBrush}" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="AI 创作" Style="{StaticResource ChatOSPageTitleTextStyle}" />
                        <TextBlock Text="使用已配置的模型生成图片，结果只保存在本机" Style="{StaticResource ChatOSCaptionTextStyle}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                    <TextBlock VerticalAlignment="Center" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Style="{StaticResource ChatOSCaptionTextStyle}" />
                    <ProgressRing Width="20" Height="20" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                    <Button AutomationProperties.AutomationId="ChatOS.MediaStudio.Refresh" AutomationProperties.Name="刷新模型" Click="OnReloadModelsClick" Style="{StaticResource ChatOSToolbarButtonStyle}" ToolTipService.ToolTip="刷新模型">
                        <FontIcon Glyph="&#xE72C;" />
                    </Button>
                </StackPanel>
            </Grid>

            <InfoBar x:Name="ErrorInfoBar" Grid.Row="1" IsClosable="False" Severity="Error" />

            <Pivot Grid.Row="2">
                <PivotItem Header="图片创作">
                    <Grid Margin="0,10,0,0" ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="360" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource ChatOSSectionCardStyle}" Padding="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="62" />
                                    <RowDefinition Height="1" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid Padding="18,0">
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="图片画布" Style="{StaticResource ChatOSHeadlineTextStyle}" />
                                        <TextBlock Text="最新一批生成结果" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                    </StackPanel>
                                </Grid>
                                <Border Grid.Row="1" Background="{StaticResource ChatOSBorderBrush}" />

                                <Grid Grid.Row="2">
                                    <GridView
                                        x:Name="LatestImageGrid"
                                        Padding="16"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        ItemsSource="{x:Bind ViewModel.LatestImages}"
                                        SelectionMode="None">
                                        <GridView.ItemsPanel>
                                            <ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="2" /></ItemsPanelTemplate>
                                        </GridView.ItemsPanel>
                                        <GridView.ItemTemplate>
                                            <DataTemplate x:DataType="media:MediaStudioImageItem">
                                                <Border Width="360" Margin="0,0,12,12" Padding="8" Background="{StaticResource ChatOSSurfaceSubtleBrush}" CornerRadius="13">
                                                    <Grid>
                                                        <Image Height="300" Source="{Binding FilePath, Converter={StaticResource FilePathToImageSourceConverter}}" Stretch="Uniform" />
                                                        <Button HorizontalAlignment="Right" VerticalAlignment="Top" Click="OnSaveImageClick" Style="{StaticResource ChatOSToolbarButtonStyle}" ToolTipService.ToolTip="另存为">
                                                            <FontIcon Glyph="&#xE74E;" />
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </GridView.ItemTemplate>
                                    </GridView>

                                    <StackPanel x:Name="CanvasEmptyState" MaxWidth="480" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                                        <Border Style="{StaticResource ChatOSEmptyStateIconStyle}" Background="{StaticResource ChatOSPurpleSoftBrush}">
                                            <FontIcon Glyph="&#xEB9F;" FontSize="24" Foreground="{StaticResource ChatOSPurpleBrush}" />
                                        </Border>
                                        <TextBlock HorizontalAlignment="Center" Text="描述想象中的画面" Style="{StaticResource ChatOSHeadlineTextStyle}" />
                                        <TextBlock Text="选择图片模型、填写提示词并生成；图片不会进入聊天记录。" TextAlignment="Center" TextWrapping="Wrap" Style="{StaticResource ChatOSSecondaryBodyTextStyle}" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource ChatOSSectionCardStyle}" Padding="0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Padding="18" Spacing="17">
                                    <TextBlock Text="生成设置" Style="{StaticResource ChatOSHeadlineTextStyle}" />

                                    <StackPanel Spacing="7">
                                        <TextBlock Text="图片模型" Style="{StaticResource ChatOSBodyStrongTextStyle}" />
                                        <ComboBox AutomationProperties.AutomationId="ChatOS.MediaStudio.Model" HorizontalAlignment="Stretch" DisplayMemberPath="Name" ItemsSource="{x:Bind ViewModel.Models}" SelectedItem="{x:Bind ViewModel.SelectedModel, Mode=TwoWay}" />
                                    </StackPanel>

                                    <StackPanel Spacing="7">
                                        <Grid>
                                            <TextBlock Text="参考图（可选）" Style="{StaticResource ChatOSBodyStrongTextStyle}" />
                                            <Button HorizontalAlignment="Right" AutomationProperties.AutomationId="ChatOS.MediaStudio.AddReference" Click="OnAddReferenceClick" Content="添加" Style="{StaticResource ChatOSSecondaryButtonStyle}" />
                                        </Grid>
                                        <ItemsControl ItemsSource="{x:Bind ViewModel.ReferenceImages}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="core:ImageGenerationInput">
                                                    <Border Margin="0,0,0,5" Padding="9,6" Background="{StaticResource ChatOSSurfaceSubtleBrush}" CornerRadius="8">
                                                        <Grid ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                            <TextBlock VerticalAlignment="Center" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                                            <Button Grid.Column="1" Click="OnRemoveReferenceClick" Style="{StaticResource ChatOSToolbarButtonStyle}" ToolTipService.ToolTip="移除">
                                                                <FontIcon Glyph="&#xE711;" FontSize="11" />
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <StackPanel Spacing="7">
                                        <TextBlock Text="提示词" Style="{StaticResource ChatOSBodyStrongTextStyle}" />
                                        <TextBox AutomationProperties.AutomationId="ChatOS.MediaStudio.Prompt" AcceptsReturn="True" MinHeight="170" PlaceholderText="描述主体、场景、构图、光线和风格…" Text="{x:Bind ViewModel.Prompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="7">
                                            <TextBlock Text="尺寸" Style="{StaticResource ChatOSBodyStrongTextStyle}" />
                                            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.Sizes}" SelectedItem="{x:Bind ViewModel.SelectedSize, Mode=TwoWay}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="7">
                                            <TextBlock Text="数量" Style="{StaticResource ChatOSBodyStrongTextStyle}" />
                                            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.Counts}" SelectedItem="{x:Bind ViewModel.SelectedCount, Mode=TwoWay}" />
                                        </StackPanel>
                                    </Grid>

                                    <Button AutomationProperties.AutomationId="ChatOS.MediaStudio.Generate" AutomationProperties.Name="生成图片" Click="OnGenerateClick" Content="生成图片" IsEnabled="{x:Bind ViewModel.CanGenerate, Mode=OneWay}" Style="{StaticResource ChatOSPrimaryButtonStyle}" HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </PivotItem>

                <PivotItem Header="视频创作">
                    <Grid Margin="0,10,0,0" ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="360" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource ChatOSSectionCardStyle}" Padding="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="62" />
                                    <RowDefinition Height="1" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid Padding="18,0">
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="视频画布" Style="{StaticResource ChatOSHeadlineTextStyle}" />
                                        <TextBlock Text="生成完成后自动保存到本机" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                    </StackPanel>
                                    <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Text="{x:Bind ViewModel.VideoProgressLabel, Mode=OneWay}" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                </Grid>
                                <Border Grid.Row="1" Background="{StaticResource ChatOSBorderBrush}" />
                                <Grid Grid.Row="2" Padding="18">
                                    <MediaPlayerElement x:Name="VideoPlayer" AreTransportControlsEnabled="True" AutoPlay="False" Stretch="Uniform" />
                                    <StackPanel x:Name="VideoEmptyState" MaxWidth="460" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                                        <Border Style="{StaticResource ChatOSEmptyStateIconStyle}" Background="{StaticResource ChatOSPurpleSoftBrush}">
                                            <FontIcon Glyph="&#xE714;" FontSize="24" Foreground="{StaticResource ChatOSPurpleBrush}" />
                                        </Border>
                                        <TextBlock HorizontalAlignment="Center" Text="把镜头描述变成视频" Style="{StaticResource ChatOSHeadlineTextStyle}" />
                                        <TextBlock Text="可选择首帧、画面比例、清晰度和时长。任务会自动轮询并下载结果。" TextAlignment="Center" TextWrapping="Wrap" Style="{StaticResource ChatOSSecondaryBodyTextStyle}" />
                                    </StackPanel>
                                    <Border x:Name="VideoProgressPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="22" Background="{StaticResource ChatOSSurfaceBrush}" CornerRadius="14">
                                        <StackPanel Width="300" Spacing="12">
                                            <TextBlock Text="正在生成视频" Style="{StaticResource ChatOSHeadlineTextStyle}" />
                                            <ProgressBar x:Name="VideoProgressBar" IsIndeterminate="True" />
                                            <TextBlock HorizontalAlignment="Center" Text="{x:Bind ViewModel.VideoProgressLabel, Mode=OneWay}" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource ChatOSSectionCardStyle}" Padding="0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Padding="18" Spacing="17">
                                    <TextBlock Text="视频设置" Style="{StaticResource ChatOSHeadlineTextStyle}" />
                                    <StackPanel Spacing="7">
                                        <TextBlock Text="视频模型" Style="{StaticResource ChatOSBodyStrongTextStyle}" />
                                        <ComboBox HorizontalAlignment="Stretch" DisplayMemberPath="Name" ItemsSource="{x:Bind ViewModel.VideoModels}" SelectedItem="{x:Bind ViewModel.SelectedVideoModel, Mode=TwoWay}" />
                                    </StackPanel>
                                    <StackPanel Spacing="7">
                                        <Grid>
                                            <TextBlock Text="首帧（可选）" Style="{StaticResource ChatOSBodyStrongTextStyle}" />
                                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="6">
                                                <Button Click="OnPickVideoFrameClick" Content="选择" Style="{StaticResource ChatOSSecondaryButtonStyle}" />
                                                <Button Click="OnRemoveVideoFrameClick" Content="清除" Style="{StaticResource ChatOSSecondaryButtonStyle}" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="{x:Bind ViewModel.VideoFirstFrameLabel, Mode=OneWay}" TextTrimming="CharacterEllipsis" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                    </StackPanel>
                                    <StackPanel Spacing="7">
                                        <TextBlock Text="提示词" Style="{StaticResource ChatOSBodyStrongTextStyle}" />
                                        <TextBox AcceptsReturn="True" MinHeight="150" PlaceholderText="描述镜头运动、主体动作、光线和节奏…" Text="{x:Bind ViewModel.VideoPrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="7">
                                            <TextBlock Text="清晰度" Style="{StaticResource ChatOSBodyStrongTextStyle}" />
                                            <ComboBox ItemsSource="{x:Bind ViewModel.VideoSizes, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.VideoSize, Mode=TwoWay}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="7">
                                            <TextBlock Text="时长（秒）" Style="{StaticResource ChatOSBodyStrongTextStyle}" />
                                            <ComboBox ItemsSource="{x:Bind ViewModel.VideoDurations, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.VideoSeconds, Mode=TwoWay}" />
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Spacing="7">
                                        <TextBlock Text="画面比例" Style="{StaticResource ChatOSBodyStrongTextStyle}" />
                                        <ComboBox ItemsSource="{x:Bind ViewModel.VideoRatios}" SelectedItem="{x:Bind ViewModel.VideoRatio, Mode=TwoWay}" />
                                    </StackPanel>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <Button Click="OnGenerateVideoClick" Content="生成视频" IsEnabled="{x:Bind ViewModel.CanGenerateVideo, Mode=OneWay}" Style="{StaticResource ChatOSPrimaryButtonStyle}" HorizontalAlignment="Stretch" />
                                        <Button Grid.Column="1" Click="OnCancelVideoClick" Content="停止等待" IsEnabled="{x:Bind ViewModel.IsGeneratingVideo, Mode=OneWay}" Style="{StaticResource ChatOSSecondaryButtonStyle}" />
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </PivotItem>

                <PivotItem Header="图片记录">
                    <ListView
                        Margin="0,10,0,0"
                        AutomationProperties.AutomationId="ChatOS.MediaStudio.History"
                        Background="Transparent"
                        BorderThickness="0"
                        IsItemClickEnabled="True"
                        ItemClick="OnHistoryItemClick"
                        ItemsSource="{x:Bind ViewModel.History}"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="media:MediaStudioHistoryItem">
                                <Border Margin="0,0,0,10" Style="{StaticResource ChatOSSectionCardStyle}">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <ItemsControl ItemsSource="{x:Bind Images}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="media:MediaStudioImageItem">
                                                    <Image Width="170" Height="110" Source="{Binding FilePath, Converter={StaticResource FilePathToImageSourceConverter}}" Stretch="UniformToFill" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5">
                                            <TextBlock Text="{x:Bind Prompt}" MaxLines="3" TextWrapping="Wrap" Style="{StaticResource ChatOSHeadlineTextStyle}" />
                                            <TextBlock Text="{x:Bind ModelName}" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                            <TextBlock Text="{x:Bind CreatedAtLabel}" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                        </StackPanel>
                                        <FontIcon Grid.Column="2" VerticalAlignment="Center" Glyph="&#xE76C;" Foreground="{StaticResource ChatOSSecondaryTextBrush}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </PivotItem>

                <PivotItem Header="视频记录">
                    <ListView
                        Margin="0,10,0,0"
                        Background="Transparent"
                        BorderThickness="0"
                        IsItemClickEnabled="True"
                        ItemClick="OnVideoHistoryItemClick"
                        ItemsSource="{x:Bind ViewModel.VideoHistory}"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="media:MediaStudioVideoHistoryItem">
                                <Border Margin="0,0,0,10" Style="{StaticResource ChatOSSectionCardStyle}">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <Border Width="44" Height="44" Background="{StaticResource ChatOSPurpleSoftBrush}" CornerRadius="12">
                                            <FontIcon Glyph="&#xE714;" Foreground="{StaticResource ChatOSPurpleBrush}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5">
                                            <TextBlock Text="{x:Bind Prompt}" MaxLines="2" TextWrapping="Wrap" Style="{StaticResource ChatOSHeadlineTextStyle}" />
                                            <TextBlock Text="{x:Bind ModelName}" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                            <TextBlock Text="{x:Bind CreatedAtLabel}" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Click="OnSaveVideoClick" Content="另存为" Style="{StaticResource ChatOSSecondaryButtonStyle}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </PivotItem>
            </Pivot>
        </Grid>
    </Grid>
</Page>
