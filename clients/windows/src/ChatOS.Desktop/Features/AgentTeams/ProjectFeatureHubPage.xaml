<Page
    x:Class="ChatOS.Desktop.Features.AgentTeams.ProjectFeatureHubPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:agent="using:ChatOS.Desktop.Features.AgentTeams"
    xmlns:shell="using:ChatOS.Desktop.AppShell">

    <Grid Background="{StaticResource ChatOSWorkspaceBackgroundBrush}">
        <ScrollViewer Padding="28,24,28,28" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="1200" HorizontalAlignment="Stretch" Spacing="16">
                <Border Padding="18" Background="{StaticResource ChatOSSurfaceSubtleBrush}" BorderBrush="{StaticResource ChatOSBorderBrush}" BorderThickness="1" CornerRadius="14">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="52" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="48" Height="48" Background="{StaticResource ChatOSPurpleBrush}" CornerRadius="14">
                            <FontIcon Glyph="{x:Bind FeatureGlyph, Mode=OneTime}" FontSize="22" Foreground="White" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="{x:Bind FeatureTitle, Mode=OneTime}" Style="{StaticResource ChatOSPageTitleTextStyle}" />
                            <TextBlock Text="{x:Bind FeatureDescription, Mode=OneTime}" TextWrapping="Wrap" Style="{StaticResource ChatOSCaptionTextStyle}" />
                        </StackPanel>
                        <Grid x:Name="SurveySummaryPanel" Grid.Column="2" VerticalAlignment="Center" ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel MinWidth="52" HorizontalAlignment="Center" Spacing="2">
                                <TextBlock HorizontalAlignment="Center" Foreground="{StaticResource ChatOSPurpleBrush}" Text="{x:Bind PendingSurveyCount, Mode=OneTime}" Style="{StaticResource ChatOSPageTitleTextStyle}" />
                                <TextBlock HorizontalAlignment="Center" Text="待填写" Style="{StaticResource ChatOSCaptionTextStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" MinWidth="52" HorizontalAlignment="Center" Spacing="2">
                                <TextBlock HorizontalAlignment="Center" Foreground="{StaticResource ChatOSSuccessBrush}" Text="{x:Bind ResolvedSurveyCount, Mode=OneTime}" Style="{StaticResource ChatOSPageTitleTextStyle}" />
                                <TextBlock HorizontalAlignment="Center" Text="已恢复" Style="{StaticResource ChatOSCaptionTextStyle}" />
                            </StackPanel>
                            <Button Grid.Column="2" Click="OnRefreshSurveySummaryClick" Style="{StaticResource ChatOSToolbarButtonStyle}" ToolTipService.ToolTip="刷新需求调研">
                                <Grid>
                                    <FontIcon Glyph="&#xE72C;" FontSize="13" Visibility="{x:Bind IsLoadingSurveySummary, Mode=OneTime, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                    <ProgressRing Width="16" Height="16" IsActive="{x:Bind IsLoadingSurveySummary, Mode=OneTime}" Visibility="{x:Bind IsLoadingSurveySummary, Mode=OneTime, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </Grid>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>

                <StackPanel Spacing="3">
                    <TextBlock Text="{x:Bind FeatureListTitle, Mode=OneTime}" Style="{StaticResource ChatOSHeadlineTextStyle}" />
                    <TextBlock Text="{x:Bind FeatureListDescription, Mode=OneTime}" Style="{StaticResource ChatOSCaptionTextStyle}" />
                    <TextBlock Foreground="{StaticResource ChatOSFailureBrush}" Text="{x:Bind SurveySummaryError, Mode=OneTime}" TextWrapping="Wrap" />
                </StackPanel>

                <ListView
                    x:Name="AgentProjectList"
                    AutomationProperties.AutomationId="ChatOS.ProjectFeatureHub.Projects"
                    AutomationProperties.Name="选择项目"
                    Background="Transparent"
                    BorderThickness="0"
                    IsItemClickEnabled="True"
                    ItemClick="OnProjectClicked"
                    ItemsSource="{x:Bind Shell.Projects}"
                    SelectionMode="None">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Width" Value="340" />
                            <Setter Property="Height" Value="100" />
                            <Setter Property="Margin" Value="0,0,10,10" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="VerticalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" ItemWidth="340" ItemHeight="100" /></ItemsPanelTemplate></ListView.ItemsPanel>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="shell:ShellResourceViewModel">
                            <Border Padding="13" Style="{StaticResource ChatOSSectionCardStyle}">
                                <Grid ColumnSpacing="11">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Border Width="36" Height="36" VerticalAlignment="Top" Background="{StaticResource ChatOSAccentSoftBrush}" CornerRadius="10">
                                        <FontIcon Glyph="&#xE8B7;" FontSize="16" Foreground="{StaticResource ChatOSAccentBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                        <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" Style="{StaticResource ChatOSBodyStrongTextStyle}" />
                                        <TextBlock Text="{x:Bind Subtitle}" TextTrimming="CharacterEllipsis" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                    </StackPanel>
                                    <FontIcon Grid.Column="2" VerticalAlignment="Center" Glyph="&#xE76C;" FontSize="12" Foreground="{StaticResource ChatOSSecondaryTextBrush}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <ListView
                    x:Name="SurveyProjectList"
                    AutomationProperties.AutomationId="ChatOS.RequirementSurveys.ProjectSummary"
                    AutomationProperties.Name="跨项目需求调研汇总"
                    Background="Transparent"
                    BorderThickness="0"
                    IsItemClickEnabled="True"
                    ItemClick="OnSurveyProjectClicked"
                    ItemsSource="{x:Bind SurveyProjects}"
                    SelectionMode="None">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Width" Value="266" />
                            <Setter Property="Height" Value="100" />
                            <Setter Property="Margin" Value="0,0,10,10" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="VerticalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" ItemWidth="266" ItemHeight="100" /></ItemsPanelTemplate></ListView.ItemsPanel>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="agent:ProjectSurveySummary">
                            <Border Padding="13" Background="{StaticResource ChatOSSurfaceSubtleBrush}" BorderBrush="{StaticResource ChatOSBorderBrush}" BorderThickness="1" CornerRadius="12">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Border Width="34" Height="34" VerticalAlignment="Top" Background="{StaticResource ChatOSSuccessSoftBrush}" CornerRadius="9">
                                        <FontIcon Glyph="&#xE8B7;" FontSize="15" Foreground="{StaticResource ChatOSSuccessBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                        <TextBlock Text="{x:Bind Project.Title}" TextTrimming="CharacterEllipsis" Style="{StaticResource ChatOSBodyStrongTextStyle}" />
                                        <TextBlock Text="{x:Bind StatusLabel}" TextTrimming="CharacterEllipsis" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Border Padding="6,2" Background="{StaticResource ChatOSContentBackgroundBrush}" CornerRadius="8"><TextBlock Style="{StaticResource ChatOSCaptionTextStyle}"><Run Text="{x:Bind PendingCount}" /><Run Text=" 待填写" /></TextBlock></Border>
                                            <Border Padding="6,2" Background="{StaticResource ChatOSContentBackgroundBrush}" CornerRadius="8"><TextBlock Style="{StaticResource ChatOSCaptionTextStyle}"><Run Text="{x:Bind ResolvedCount}" /><Run Text=" 已恢复" /></TextBlock></Border>
                                        </StackPanel>
                                    </StackPanel>
                                    <FontIcon Grid.Column="2" VerticalAlignment="Center" Glyph="&#xE76C;" FontSize="12" Foreground="{StaticResource ChatOSSecondaryTextBrush}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Border x:Name="NoProjectsPanel" MinHeight="300" Style="{StaticResource ChatOSSectionCardStyle}" Visibility="{x:Bind HasProjects, Mode=OneTime, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                    <StackPanel MaxWidth="420" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="11">
                        <Border Style="{StaticResource ChatOSEmptyStateIconStyle}"><FontIcon Glyph="&#xE8B7;" FontSize="23" Foreground="{StaticResource ChatOSAccentBrush}" /></Border>
                        <TextBlock HorizontalAlignment="Center" Text="还没有本机项目" Style="{StaticResource ChatOSHeadlineTextStyle}" />
                        <TextBlock Text="请从左侧的 + 菜单创建项目，然后回到这里查看需求调研。" TextAlignment="Center" TextWrapping="Wrap" Style="{StaticResource ChatOSSecondaryBodyTextStyle}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
