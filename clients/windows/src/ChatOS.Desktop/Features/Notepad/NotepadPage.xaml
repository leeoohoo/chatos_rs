<UserControl
    x:Class="ChatOS.Desktop.Features.Notepad.NotepadPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:core="using:ChatOS.Core.Domain"
    mc:Ignorable="d">
    <Grid Background="{StaticResource ChatOSContentBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="54" />
            <RowDefinition Height="1" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Padding="14,0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Click="OnCloseClick" Style="{StaticResource ChatOSToolbarButtonStyle}" ToolTipService.ToolTip="{x:Bind Localization.CloseNotepad, Mode=OneWay}"><FontIcon Glyph="&#xE72B;" /></Button>
            <TextBlock Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Text="{x:Bind Localization.Notepad, Mode=OneWay}" Style="{StaticResource ChatOSHeadlineTextStyle}" />
            <TextBox Grid.Column="3" VerticalAlignment="Center" PlaceholderText="{x:Bind Localization.SearchNotes, Mode=OneWay}" Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" KeyDown="OnSearchKeyDown" />
            <Button Grid.Column="4" Command="{x:Bind ViewModel.SearchCommand}" Style="{StaticResource ChatOSToolbarButtonStyle}" ToolTipService.ToolTip="{x:Bind Localization.Search, Mode=OneWay}"><FontIcon Glyph="&#xE721;" /></Button>
            <ProgressRing Grid.Column="5" Width="18" Height="18" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
        </Grid>
        <Border Grid.Row="1" Background="{StaticResource ChatOSBorderBrush}" />
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Background="{StaticResource ChatOSSidebarBackgroundBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="180" />
                    <RowDefinition Height="1" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Padding="10,8" ColumnSpacing="4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Content="{x:Bind Localization.AllNotes, Mode=OneWay}" Click="OnRootFolderClick" />
                    <Button Grid.Column="1" Click="OnCreateFolderClick" Style="{StaticResource ChatOSToolbarButtonStyle}" ToolTipService.ToolTip="{x:Bind Localization.NewFolder, Mode=OneWay}"><FontIcon Glyph="&#xE8B7;" FontSize="12" /></Button>
                </Grid>
                <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Folders}" IsItemClickEnabled="True" ItemClick="OnFolderClick" SelectionMode="None" Padding="8,0">
                    <ListView.ItemTemplate><DataTemplate x:DataType="core:NotepadFolderItem">
                        <Grid Padding="4" ColumnSpacing="4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE8B7;" FontSize="12" />
                            <StackPanel Grid.Column="1"><TextBlock Text="{x:Bind Name}" Style="{StaticResource ChatOSBodyStrongTextStyle}" /><TextBlock Text="{x:Bind Path}" TextTrimming="CharacterEllipsis" Style="{StaticResource ChatOSCaptionTextStyle}" /></StackPanel>
                            <Button Grid.Column="2" Click="OnRenameFolderClick" Style="{StaticResource ChatOSToolbarButtonStyle}"><FontIcon Glyph="&#xE70F;" FontSize="11" /></Button>
                            <Button Grid.Column="3" Click="OnDeleteFolderClick" Style="{StaticResource ChatOSToolbarButtonStyle}"><FontIcon Glyph="&#xE74D;" FontSize="11" Foreground="{StaticResource ChatOSFailureBrush}" /></Button>
                        </Grid>
                    </DataTemplate></ListView.ItemTemplate>
                </ListView>
                <Border Grid.Row="2" Background="{StaticResource ChatOSBorderBrush}" />
                <Grid Grid.Row="3" Padding="10,8"><TextBlock Text="{x:Bind Localization.Notes, Mode=OneWay}" Style="{StaticResource ChatOSHeadlineTextStyle}" /><Button HorizontalAlignment="Right" Click="OnCreateNoteClick" Style="{StaticResource ChatOSToolbarButtonStyle}" ToolTipService.ToolTip="{x:Bind Localization.NewNote, Mode=OneWay}"><FontIcon Glyph="&#xE710;" /></Button></Grid>
                <ListView Grid.Row="4" ItemsSource="{x:Bind ViewModel.Notes}" IsItemClickEnabled="True" ItemClick="OnNoteClick" SelectionMode="Single" SelectedItem="{x:Bind ViewModel.SelectedNote, Mode=OneWay}" Padding="8">
                    <ListView.ItemTemplate><DataTemplate x:DataType="core:NotepadNote">
                        <StackPanel Padding="5" Spacing="2"><TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" Style="{StaticResource ChatOSBodyStrongTextStyle}" /><TextBlock Text="{x:Bind Folder}" TextTrimming="CharacterEllipsis" Style="{StaticResource ChatOSCaptionTextStyle}" /></StackPanel>
                    </DataTemplate></ListView.ItemTemplate>
                </ListView>
            </Grid>
            <Border Grid.Column="1" Background="{StaticResource ChatOSBorderBrush}" />
            <Grid Grid.Column="2" Padding="18" RowSpacing="12">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="1" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBox Header="{x:Bind Localization.Title, Mode=OneWay}" Text="{x:Bind ViewModel.Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}" />
                    <Button Grid.Column="1" Content="{x:Bind Localization.Preview, Mode=OneWay}" Click="OnPreviewModeClick" />
                    <Button Grid.Column="2" Content="{x:Bind Localization.Edit, Mode=OneWay}" Click="OnEditModeClick" />
                    <Button Grid.Column="3" Content="{x:Bind Localization.Split, Mode=OneWay}" Click="OnSplitModeClick" />
                    <Button Grid.Column="4" Content="{x:Bind Localization.Export, Mode=OneWay}" Click="OnExportClick" IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}" />
                    <Button Grid.Column="5" Content="{x:Bind Localization.Delete, Mode=OneWay}" Click="OnDeleteNoteClick" IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}" />
                    <Button Grid.Column="6" Content="{x:Bind Localization.Save, Mode=OneWay}" Command="{x:Bind ViewModel.SaveCommand}" IsEnabled="{x:Bind ViewModel.IsDirty, Mode=OneWay}" Style="{StaticResource ChatOSPrimaryButtonStyle}" />
                </Grid>
                <TextBox Grid.Row="1" Header="{x:Bind Localization.Tags, Mode=OneWay}" PlaceholderText="{x:Bind Localization.CommaSeparated, Mode=OneWay}" Text="{x:Bind ViewModel.TagsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}" />
                <Border Grid.Row="2" Background="{StaticResource ChatOSBorderBrush}" />
                <Grid Grid.Row="3" ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition x:Name="PreviewColumn" Width="*" /><ColumnDefinition x:Name="EditorColumn" Width="0" /></Grid.ColumnDefinitions>
                    <Border Padding="16" Style="{StaticResource ChatOSCardStyle}" Visibility="{x:Bind ViewModel.IsPreviewVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"><ScrollViewer VerticalScrollBarVisibility="Auto"><RichTextBlock x:Name="MarkdownPreview" IsTextSelectionEnabled="True" /></ScrollViewer></Border>
                    <TextBox Grid.Column="1" AcceptsReturn="True" FontFamily="Cascadia Mono, Consolas" HorizontalScrollBarVisibility="Auto" Text="{x:Bind ViewModel.Content, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" Visibility="{x:Bind ViewModel.IsEditorVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <StackPanel Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}"><FontIcon Glyph="&#xE70B;" FontSize="34" Foreground="{StaticResource ChatOSTertiaryTextBrush}" /><TextBlock Text="{x:Bind Localization.SelectOrCreateNote, Mode=OneWay}" Style="{StaticResource ChatOSHeadlineTextStyle}" /></StackPanel>
                </Grid>
            </Grid>
        </Grid>
        <StackPanel Grid.Row="3" Margin="14,6" Spacing="3"><TextBlock Text="{x:Bind ViewModel.ActionMessage, Mode=OneWay}" Foreground="{StaticResource ChatOSSuccessBrush}" Style="{StaticResource ChatOSCaptionTextStyle}" Visibility="{x:Bind ViewModel.ActionMessage, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" /><TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" Foreground="{StaticResource ChatOSFailureBrush}" Style="{StaticResource ChatOSCaptionTextStyle}" Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" /></StackPanel>
    </Grid>
</UserControl>
