{
  "direction": {
    "previewHeight": 150,
    "demos": [
      {
        "id": "direction-ltr",
        "label": "从左到右",
        "composition": {
          "module": "direction.DirectionProvider",
          "props": { "direction": "ltr" },
          "children": [
            {
              "element": "div",
              "props": { "dir": "ltr", "className": "flex w-full max-w-md items-center justify-between gap-4 rounded-xl border bg-background p-4" },
              "children": [
                { "element": "span", "props": { "className": "text-sm font-medium" }, "children": [{ "$ref": "content", "fallback": "Design from left to right" }] },
                { "module": "button.Button", "children": ["Continue →"] }
              ]
            }
          ]
        }
      },
      {
        "id": "direction-rtl",
        "label": "从右到左",
        "composition": {
          "module": "direction.DirectionProvider",
          "props": { "direction": "rtl" },
          "children": [
            {
              "element": "div",
              "props": { "dir": "rtl", "className": "flex w-full max-w-md items-center justify-between gap-4 rounded-xl border bg-background p-4" },
              "children": [
                { "element": "span", "props": { "className": "text-sm font-medium" }, "children": ["تصميم من اليمين إلى اليسار"] },
                { "module": "button.Button", "children": ["متابعة ←"] }
              ]
            }
          ]
        }
      }
    ]
  },
  "attachment": {
    "previewHeight": 170,
    "demos": [
      {
        "id": "attachment-done",
        "label": "完成状态",
        "composition": {
          "module": "attachment.Attachment",
          "props": { "state": "done", "className": "w-full max-w-md" },
          "children": [
            { "module": "attachment.AttachmentMedia", "children": ["FIG"] },
            { "module": "attachment.AttachmentContent", "children": [
              { "module": "attachment.AttachmentTitle", "children": [{ "$ref": "content", "fallback": "design-system.fig" }] },
              { "module": "attachment.AttachmentDescription", "children": ["18.4 MB · Uploaded"] }
            ] },
            { "module": "attachment.AttachmentActions", "children": [
              { "module": "attachment.AttachmentAction", "props": { "aria-label": "Remove attachment" }, "children": ["×"] }
            ] }
          ]
        }
      },
      {
        "id": "attachment-uploading",
        "label": "上传状态",
        "composition": {
          "module": "attachment.Attachment",
          "props": { "state": "uploading", "className": "w-full max-w-md" },
          "children": [
            { "module": "attachment.AttachmentMedia", "children": ["68%"] },
            { "module": "attachment.AttachmentContent", "children": [
              { "module": "attachment.AttachmentTitle", "children": [{ "$ref": "content", "fallback": "hero-video.mp4" }] },
              { "module": "attachment.AttachmentDescription", "children": ["Uploading · 24.8 MB"] }
            ] },
            { "module": "attachment.AttachmentActions", "children": [
              { "module": "attachment.AttachmentAction", "props": { "aria-label": "Cancel upload" }, "children": ["×"] }
            ] }
          ]
        }
      },
      {
        "id": "attachment-error",
        "label": "错误状态",
        "composition": {
          "module": "attachment.Attachment",
          "props": { "state": "error", "className": "w-full max-w-md" },
          "children": [
            { "module": "attachment.AttachmentMedia", "children": ["!"] },
            { "module": "attachment.AttachmentContent", "children": [
              { "module": "attachment.AttachmentTitle", "children": [{ "$ref": "content", "fallback": "oversize-image.png" }] },
              { "module": "attachment.AttachmentDescription", "children": ["Upload failed · File is too large"] }
            ] },
            { "module": "attachment.AttachmentActions", "children": [
              { "module": "attachment.AttachmentAction", "props": { "aria-label": "Retry upload" }, "children": ["↻"] }
            ] }
          ]
        }
      }
    ]
  },
