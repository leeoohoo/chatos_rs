<Window
    x:Class="ChatOS.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shell="using:ChatOS.Desktop.AppShell"
    mc:Ignorable="d"
    Title="ChatOS">

    <Window.Resources>
        <DataTemplate x:Key="ShellResourceTemplate" x:DataType="shell:ShellResourceViewModel">
            <Grid Padding="4,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="{x:Bind Glyph}" FontSize="14" />
                <StackPanel Grid.Column="1" Spacing="1">
                    <TextBlock Text="{x:Bind Title}" Style="{StaticResource ChatOSBodyStrongTextStyle}" />
                    <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource ChatOSCaptionTextStyle}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="RootGrid" Background="{StaticResource ChatOSWorkspaceBackgroundBrush}">
        <Grid x:Name="LoginRoot" AutomationProperties.AutomationId="ChatOS.Login.Root" AutomationProperties.Name="ChatOS sign in" Background="{StaticResource ChatOSWorkspaceBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid x:Name="LoginTitleBar" Grid.Row="0" Background="{StaticResource ChatOSTitleBarBackgroundBrush}">
                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center" Orientation="Horizontal" Spacing="10">
                    <FontIcon Glyph="&#xE8BD;" Foreground="{StaticResource ChatOSAccentBrush}" />
                    <TextBlock Text="ChatOS" Style="{StaticResource ChatOSTitleTextStyle}" />
                </StackPanel>
            </Grid>
            <Border
                Grid.Row="1"
                Width="420"
                Padding="32"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{StaticResource ChatOSContentBackgroundBrush}"
                BorderBrush="{StaticResource ChatOSBorderBrush}"
                BorderThickness="1"
                CornerRadius="16">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="6">
                        <FontIcon HorizontalAlignment="Left" Glyph="&#xE8BD;" FontSize="34" Foreground="{StaticResource ChatOSAccentBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.Localization.SignInTitle, Mode=OneWay}" Style="{StaticResource ChatOSPageTitleTextStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.Localization.SignInDescription, Mode=OneWay}" Style="{StaticResource ChatOSSecondaryBodyTextStyle}" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="{x:Bind ViewModel.Localization.Username, Mode=OneWay}" Style="{StaticResource ChatOSBodyStrongTextStyle}" />
                        <TextBox AutomationProperties.AutomationId="ChatOS.Login.Username" AutomationProperties.Name="Username" Text="{x:Bind ViewModel.Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{x:Bind ViewModel.Localization.UsernamePlaceholder, Mode=OneWay}" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="{x:Bind ViewModel.Localization.Password, Mode=OneWay}" Style="{StaticResource ChatOSBodyStrongTextStyle}" />
                        <PasswordBox x:Name="LoginPasswordBox" AutomationProperties.AutomationId="ChatOS.Login.Password" AutomationProperties.Name="Password" PasswordChanged="OnPasswordChanged" PlaceholderText="{x:Bind ViewModel.Localization.PasswordPlaceholder, Mode=OneWay}" />
                    </StackPanel>

                    <TextBlock
                        x:Name="LoginErrorText"
                        AutomationProperties.AutomationId="ChatOS.Login.Error"
                        Foreground="{StaticResource ChatOSFailureBrush}"
                        Style="{StaticResource ChatOSSecondaryBodyTextStyle}"
                        Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                        TextWrapping="Wrap" />

                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ProgressRing x:Name="LoginProgress" Width="22" Height="22" HorizontalAlignment="Left" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                        <Button x:Name="LoginButton" AutomationProperties.AutomationId="ChatOS.Login.Submit" AutomationProperties.Name="Sign in" Grid.Column="1" MinWidth="96" Command="{x:Bind ViewModel.LoginCommand}" Content="{x:Bind ViewModel.Localization.SignIn, Mode=OneWay}" Style="{StaticResource ChatOSPrimaryButtonStyle}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <Grid
            x:Name="ShellRoot"
            AutomationProperties.AutomationId="ChatOS.Shell.Root"
            AutomationProperties.Name="ChatOS workspace"
            Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid x:Name="AppTitleBar" Grid.Row="0" Background="{StaticResource ChatOSTitleBarBackgroundBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="252" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="16,0,0,0" VerticalAlignment="Center" Orientation="Horizontal" Spacing="10">
                    <FontIcon Glyph="&#xE8BD;" Foreground="{StaticResource ChatOSAccentBrush}" />
                    <TextBlock Text="ChatOS" Style="{StaticResource ChatOSTitleTextStyle}" />
                </StackPanel>

                <TextBlock Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center" Text="{x:Bind ViewModel.WorkspaceTitle, Mode=OneWay}" Style="{StaticResource ChatOSHeadlineTextStyle}" />

                <StackPanel Grid.Column="2" Margin="0,0,140,0" VerticalAlignment="Center" Orientation="Horizontal" Spacing="4">
                    <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Text="{x:Bind ViewModel.CurrentUserLabel, Mode=OneWay}" Style="{StaticResource ChatOSCaptionTextStyle}" />
                    <Button AutomationProperties.AutomationId="ChatOS.Shell.Notepad" AutomationProperties.Name="{x:Bind ViewModel.Localization.Notepad, Mode=OneWay}" Click="OnNotepadClicked" Style="{StaticResource ChatOSToolbarButtonStyle}" ToolTipService.ToolTip="{x:Bind ViewModel.Localization.Notepad, Mode=OneWay}">
                        <FontIcon Glyph="&#xE70B;" />
                    </Button>
                    <Button AutomationProperties.AutomationId="ChatOS.Shell.Artifacts" AutomationProperties.Name="{x:Bind ViewModel.Localization.Artifacts, Mode=OneWay}" Click="OnArtifactsClicked" Style="{StaticResource ChatOSToolbarButtonStyle}" ToolTipService.ToolTip="{x:Bind ViewModel.Localization.Artifacts, Mode=OneWay}">
                        <FontIcon Glyph="&#xE8B7;" />
                    </Button>
                    <Button AutomationProperties.AutomationId="ChatOS.Shell.AccountMenu" AutomationProperties.Name="{x:Bind ViewModel.Localization.AccountAndSettings, Mode=OneWay}" Style="{StaticResource ChatOSToolbarButtonStyle}" ToolTipService.ToolTip="{x:Bind ViewModel.Localization.AccountAndSettings, Mode=OneWay}">
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem AutomationProperties.AutomationId="ChatOS.Shell.Settings" Text="{x:Bind ViewModel.Localization.Settings, Mode=OneWay}" Click="OnSettingsClicked">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE713;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="{x:Bind ViewModel.Localization.SignOut, Mode=OneWay}" Command="{x:Bind ViewModel.LogoutCommand}">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8AC;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>
                        <FontIcon Glyph="&#xE77B;" />
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="252" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Background="{StaticResource ChatOSSidebarBackgroundBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="12,0" VerticalAlignment="Center" Orientation="Horizontal" Spacing="4">
                        <Button AutomationProperties.AutomationId="ChatOS.Shell.Refresh" AutomationProperties.Name="{x:Bind ViewModel.Localization.RefreshResources, Mode=OneWay}" Command="{x:Bind ViewModel.RefreshWorkspaceCommand}" Style="{StaticResource ChatOSToolbarButtonStyle}" ToolTipService.ToolTip="{x:Bind ViewModel.Localization.RefreshResources, Mode=OneWay}">
                            <FontIcon Glyph="&#xE72C;" />
                        </Button>
                        <Button AutomationProperties.AutomationId="ChatOS.Shell.CreateResource" AutomationProperties.Name="{x:Bind ViewModel.Localization.CreateResource, Mode=OneWay}" Style="{StaticResource ChatOSToolbarButtonStyle}" ToolTipService.ToolTip="{x:Bind ViewModel.Localization.CreateResource, Mode=OneWay}">
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="{x:Bind ViewModel.Localization.CreateLocalTerminal, Mode=OneWay}" Click="OnCreateLocalTerminalClicked">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE756;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Button.Flyout>
                            <FontIcon Glyph="&#xE710;" />
                        </Button>
                        <ProgressRing Width="18" Height="18" Margin="6,0,0,0" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Padding="10,4,10,20" Spacing="6">
                            <TextBlock Text="{x:Bind ViewModel.Localization.Contacts, Mode=OneWay}" Style="{StaticResource ChatOSSectionLabelTextStyle}" />
                            <ListView AutomationProperties.AutomationId="ChatOS.Shell.Contacts" AutomationProperties.Name="{x:Bind ViewModel.Localization.Contacts, Mode=OneWay}" ItemsSource="{x:Bind ViewModel.Contacts}" SelectedItem="{x:Bind ViewModel.SelectedResource, Mode=TwoWay}" SelectionMode="Single" ItemContainerStyle="{StaticResource ChatOSSidebarItemStyle}" ItemTemplate="{StaticResource ShellResourceTemplate}" />

                            <TextBlock Margin="0,8,0,0" Text="{x:Bind ViewModel.Localization.Projects, Mode=OneWay}" Style="{StaticResource ChatOSSectionLabelTextStyle}" />
                            <ListView AutomationProperties.AutomationId="ChatOS.Shell.Projects" AutomationProperties.Name="{x:Bind ViewModel.Localization.Projects, Mode=OneWay}" ItemsSource="{x:Bind ViewModel.Projects}" SelectedItem="{x:Bind ViewModel.SelectedResource, Mode=TwoWay}" ItemContainerStyle="{StaticResource ChatOSSidebarItemStyle}" ItemTemplate="{StaticResource ShellResourceTemplate}" />

                            <TextBlock Margin="0,8,0,0" Text="{x:Bind ViewModel.Localization.Local, Mode=OneWay}" Style="{StaticResource ChatOSSectionLabelTextStyle}" />
                            <ListView AutomationProperties.AutomationId="ChatOS.Shell.LocalResources" AutomationProperties.Name="{x:Bind ViewModel.Localization.Local, Mode=OneWay}" ItemsSource="{x:Bind ViewModel.LocalResources}" SelectedItem="{x:Bind ViewModel.SelectedResource, Mode=TwoWay}" ItemContainerStyle="{StaticResource ChatOSSidebarItemStyle}" ItemTemplate="{StaticResource ShellResourceTemplate}" />

                            <TextBlock Margin="0,8,0,0" Text="{x:Bind ViewModel.Localization.Remote, Mode=OneWay}" Style="{StaticResource ChatOSSectionLabelTextStyle}" />
                            <ListView AutomationProperties.AutomationId="ChatOS.Shell.RemoteResources" AutomationProperties.Name="{x:Bind ViewModel.Localization.Remote, Mode=OneWay}" ItemsSource="{x:Bind ViewModel.RemoteResources}" SelectedItem="{x:Bind ViewModel.SelectedResource, Mode=TwoWay}" ItemContainerStyle="{StaticResource ChatOSSidebarItemStyle}" ItemTemplate="{StaticResource ShellResourceTemplate}" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Border Grid.Column="1" Background="{StaticResource ChatOSBorderBrush}" />

                <ContentControl x:Name="WorkspaceContent" AutomationProperties.AutomationId="ChatOS.Shell.Workspace" Grid.Column="2" />
            </Grid>
        </Grid>

        <Border
            x:Name="ApprovalOverlay"
            AutomationProperties.AutomationId="ChatOS.Approval.Root"
            Width="520"
            MaxHeight="520"
            Margin="24"
            Padding="18"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Background="{StaticResource ChatOSContentBackgroundBrush}"
            BorderBrush="{StaticResource ChatOSBorderBrush}"
            BorderThickness="1"
            CornerRadius="14"
            Visibility="Collapsed">
            <Grid RowSpacing="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="3">
                        <TextBlock Text="{x:Bind ViewModel.Localization.LocalOperationAwaitingApproval, Mode=OneWay}" Style="{StaticResource ChatOSHeadlineTextStyle}" />
                        <TextBlock x:Name="ApprovalSourceText" Style="{StaticResource ChatOSCaptionTextStyle}" />
                    </StackPanel>
                    <Border
                        x:Name="ApprovalRiskBadge"
                        Grid.Column="1"
                        Padding="9,4"
                        VerticalAlignment="Top"
                        Background="{StaticResource ChatOSProcessBackgroundBrush}"
                        CornerRadius="10">
                        <TextBlock x:Name="ApprovalRiskText" Style="{StaticResource ChatOSBodyStrongTextStyle}" />
                    </Border>
                </Grid>

                <Border
                    Grid.Row="1"
                    Padding="12"
                    Background="{StaticResource ChatOSWorkspaceBackgroundBrush}"
                    CornerRadius="8">
                    <ScrollViewer MaxHeight="170" VerticalScrollBarVisibility="Auto">
                        <TextBlock
                            x:Name="ApprovalCommandText"
                            FontFamily="Cascadia Mono, Consolas"
                            FontSize="12"
                            IsTextSelectionEnabled="True"
                            TextWrapping="Wrap" />
                    </ScrollViewer>
                </Border>

                <StackPanel Grid.Row="2" Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8B7;" FontSize="12" Foreground="{StaticResource ChatOSSecondaryTextBrush}" />
                        <TextBlock
                            x:Name="ApprovalWorkingDirectoryText"
                            Style="{StaticResource ChatOSSecondaryBodyTextStyle}"
                            IsTextSelectionEnabled="True"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock
                        x:Name="ApprovalReasonText"
                        Foreground="{StaticResource ChatOSSecondaryTextBrush}"
                        Style="{StaticResource ChatOSSecondaryBodyTextStyle}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <TextBlock
                    x:Name="ApprovalQueueText"
                    Grid.Row="3"
                    Style="{StaticResource ChatOSCaptionTextStyle}" />

                <Grid Grid.Row="4" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button
                        x:Name="DeclineApprovalButton"
                        AutomationProperties.AutomationId="ChatOS.Approval.Deny"
                        Click="OnDeclineApproval"
                        Content="{x:Bind ViewModel.Localization.Deny, Mode=OneWay}" />
                    <ProgressRing
                        x:Name="ApprovalProgressRing"
                        Grid.Column="1"
                        Width="20"
                        Height="20"
                        HorizontalAlignment="Right"
                        IsActive="False" />
                    <Button
                        x:Name="AcceptApprovalButton"
                        AutomationProperties.AutomationId="ChatOS.Approval.AllowOnce"
                        Grid.Column="2"
                        Click="OnAcceptApproval"
                        Content="{x:Bind ViewModel.Localization.AllowOnce, Mode=OneWay}" />
                    <Button
                        x:Name="AcceptSessionApprovalButton"
                        AutomationProperties.AutomationId="ChatOS.Approval.AllowSession"
                        Grid.Column="3"
                        Click="OnAcceptSessionApproval"
                        Content="{x:Bind ViewModel.Localization.AllowForSession, Mode=OneWay}"
                        Style="{StaticResource ChatOSPrimaryButtonStyle}" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
