<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="ChatOSToolbarButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource ChatOSSecondaryTextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="ChatOSSidebarItemStyle" TargetType="ListViewItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style x:Key="ChatOSSidebarListStyle" TargetType="ListView">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="IsTabStop" Value="False" />
    </Style>

    <Style x:Key="ChatOSPrimaryButtonStyle" TargetType="Button">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="16,7" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Background" Value="{StaticResource ChatOSAccentBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="ChatOSSecondaryButtonStyle" TargetType="Button">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Background" Value="{StaticResource ChatOSSurfaceSubtleBrush}" />
        <Setter Property="Foreground" Value="{StaticResource ChatOSPrimaryTextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ChatOSBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="ChatOSCardStyle" TargetType="Border">
        <Setter Property="Padding" Value="16" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Background" Value="{StaticResource ChatOSContentBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ChatOSBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="ChatOSEmptyStateIconStyle" TargetType="Border">
        <Setter Property="Width" Value="56" />
        <Setter Property="Height" Value="56" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Background" Value="{StaticResource ChatOSAccentSoftBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style x:Key="ChatOSSectionCardStyle" TargetType="Border" BasedOn="{StaticResource ChatOSCardStyle}">
        <Setter Property="Padding" Value="18" />
        <Setter Property="CornerRadius" Value="14" />
    </Style>
</ResourceDictionary>
