                                                        <Grid ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                            <Button Click="OnResumeStoryPlanningClick" Content="{x:Bind StoryViewModel.ResumePlanningLabel, Mode=OneWay}" HorizontalAlignment="Stretch" IsEnabled="{x:Bind StoryViewModel.CanResumePlanning, Mode=OneWay}" Style="{StaticResource ChatOSPrimaryButtonStyle}" />
                                                            <Button Grid.Column="1" Click="OnAbandonStoryPlanningClick" Content="放弃待恢复记录" IsEnabled="{x:Bind StoryViewModel.CanAbandonPlanning, Mode=OneWay}" Style="{StaticResource ChatOSSecondaryButtonStyle}" />
                                                            <Button Grid.Column="2" Click="OnPauseStoryPlanningClick" Content="暂停当前规划" IsEnabled="{x:Bind StoryViewModel.CanPausePlanning, Mode=OneWay}" Style="{StaticResource ChatOSSecondaryButtonStyle}" />
