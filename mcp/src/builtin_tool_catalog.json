        "properties": {
          "end_line": {
            "minimum": 1,
            "type": "integer"
          },
          "path": {
            "type": "string"
          },
          "start_line": {
            "minimum": 1,
            "type": "integer"
          },
          "with_line_numbers": {
            "default": true,
            "type": "boolean"
          }
        },
        "required": [
          "path"
        ],
        "type": "object"
      },
      "name": "read_file"
    },
    {
      "description": "Compatibility alias for search_text in the current project workspace. query maps to search_text.pattern.\nPaths are relative to the current project workspace root.",
      "inputSchema": {
        "additionalProperties": false,
