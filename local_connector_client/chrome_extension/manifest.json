{
  "manifest_version": 3,
  "name": "ChatOS Chrome",
  "description": "Connect explicitly authorized Chrome tabs to ChatOS through a local Native Messaging Host.",
  "version": "1.3.0",
  "key": "",
  "permissions": [
    "activeTab",
    "nativeMessaging",
    "scripting",
    "storage"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "ChatOS Chrome",
    "default_popup": "popup.html"
  }
}
