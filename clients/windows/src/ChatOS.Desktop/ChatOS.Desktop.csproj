<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>ChatOS.Desktop</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ChatOS.Core\ChatOS.Core.csproj" />
    <ProjectReference Include="..\ChatOS.Api\ChatOS.Api.csproj" />
    <ProjectReference Include="..\ChatOS.Connector\ChatOS.Connector.csproj" />
    <ProjectReference Include="..\ChatOS.Presentation\ChatOS.Presentation.csproj" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\**\*.png" />
  </ItemGroup>
  <!--
    Windows App SDK 1.7 overwrites UseXamlCompilerExecutable while importing
    its targets. Apply the override immediately before both real compilation
    passes so non-English Windows installations use the language-independent
    in-process compiler instead of the broken XamlCompiler.exe host.
  -->
  <Target
      Name="ChatOSUseInProcessXamlCompiler"
      BeforeTargets="MarkupCompilePass1;MarkupCompilePass2">
    <PropertyGroup>
      <UseXamlCompilerExecutable>false</UseXamlCompilerExecutable>
    </PropertyGroup>
  </Target>
</Project>
