                                                    <Border Height="150" Background="{StaticResource ChatOSSurfaceSubtleBrush}" CornerRadius="10"><Image Source="{Binding ImagePath, Converter={StaticResource FilePathToImageSourceConverter}}" Stretch="Uniform" /></Border>
                                                    <TextBlock Text="素材 ID" Style="{StaticResource ChatOSCaptionTextStyle}" /><TextBlock IsTextSelectionEnabled="True" Text="{Binding Id}" TextWrapping="Wrap" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                                </StackPanel>
                                                <Border x:Name="StoryGraphSectionAnchor" Height="1" />
                                                <Expander Header="{x:Bind StoryViewModel.RelationSummary, Mode=OneWay}">
                                                    <StackPanel Padding="0,8,0,0" Spacing="8">
