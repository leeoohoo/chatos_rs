<Window
    x:Class="ChatOS.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shell="using:ChatOS.Desktop.AppShell"
    mc:Ignorable="d"
    Title="ChatOS">

    <Grid x:Name="RootGrid" Background="{StaticResource ChatOSWorkspaceBackgroundBrush}">
        <Grid.Resources>
            <DataTemplate x:Key="ShellResourceTemplate" x:DataType="shell:ShellResourceViewModel">
                <Grid Padding="6,4" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Width="18" HorizontalAlignment="Center" Glyph="{x:Bind Glyph}" FontSize="15" Foreground="{StaticResource ChatOSAccentBrush}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="{x:Bind Title}" Style="{StaticResource ChatOSBodyStrongTextStyle}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource ChatOSCaptionTextStyle}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </DataTemplate>
        </Grid.Resources>
        <Grid x:Name="LoginRoot" AutomationProperties.AutomationId="ChatOS.Login.Root" AutomationProperties.Name="ChatOS sign in" Background="{StaticResource ChatOSWorkspaceBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid x:Name="LoginTitleBar" Grid.Row="0" Background="{StaticResource ChatOSTitleBarBackgroundBrush}">
                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center" Orientation="Horizontal" Spacing="10">
                    <FontIcon Glyph="&#xE8BD;" Foreground="{StaticResource ChatOSAccentBrush}" />
                    <TextBlock Text="ChatOS" Style="{StaticResource ChatOSTitleTextStyle}" />
                </StackPanel>
            </Grid>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Padding="70" Background="{StaticResource ChatOSAccentWashBrush}">
                    <StackPanel MaxWidth="510" HorizontalAlignment="Stretch" VerticalAlignment="Center" Spacing="22">
                        <StackPanel.RenderTransform>
                            <TranslateTransform Y="-44" />
                        </StackPanel.RenderTransform>
                        <Grid Width="132" Height="143" HorizontalAlignment="Left">
                            <Image
                                x:Name="LoginPetSpriteImage"
                                AutomationProperties.AutomationId="ChatOS.Login.PetSprite"
                                AutomationProperties.Name="枫团"
                                IsHitTestVisible="False"
                                Stretch="Uniform"
                                Visibility="Collapsed" />
                            <Viewbox x:Name="LoginPetFallback" Stretch="Uniform">
                                <Canvas Width="150" Height="150">
                                <Ellipse Canvas.Left="22" Canvas.Top="112" Width="108" Height="18" Fill="#22000000" />
                                <Path Data="M35,72 C12,64 8,91 29,105 C14,105 10,117 28,120 C50,123 59,105 57,91 Z" Fill="#D9703A" Stroke="#A84E2D" StrokeThickness="2" />
                                <Path Data="M55,45 L42,13 L73,31 Z" Fill="#E88246" Stroke="#A84E2D" StrokeThickness="2" />
                                <Path Data="M95,45 L108,13 L78,31 Z" Fill="#E88246" Stroke="#A84E2D" StrokeThickness="2" />
                                <Path Data="M50,41 C57,22 94,22 101,43 C111,62 106,94 88,105 C78,112 64,110 55,102 C40,89 39,59 50,41 Z" Fill="#ED8A4F" Stroke="#A84E2D" StrokeThickness="2" />
                                <Path Data="M54,77 C59,59 90,59 97,77 C101,92 91,105 76,106 C60,105 50,92 54,77 Z" Fill="#FFF4E5" />
                                <Ellipse Canvas.Left="60" Canvas.Top="57" Width="8" Height="10" Fill="#35251F" />
                                <Ellipse Canvas.Left="85" Canvas.Top="57" Width="8" Height="10" Fill="#35251F" />
                                <Path Data="M72,73 Q76,77 80,73 Q79,84 72,73 Z" Fill="#4A3028" />
                                <Path Data="M72,84 Q77,89 83,84" Stroke="#A84E2D" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                <Path Data="M61,101 C54,111 55,125 66,128 C74,129 76,116 73,105 Z" Fill="#E88246" Stroke="#A84E2D" StrokeThickness="2" />
                                <Path Data="M91,101 C99,111 98,125 87,128 C79,129 77,116 80,105 Z" Fill="#E88246" Stroke="#A84E2D" StrokeThickness="2" />
                                <Path Data="M66,91 C57,78 52,94 64,104 C72,111 83,111 91,103 C101,92 94,78 86,91 C81,83 71,83 66,91 Z" Fill="#C94332" />
                                <Path Data="M76,87 L78,108" Stroke="#8F2F26" StrokeThickness="2" />
                                </Canvas>
                            </Viewbox>
                        </Grid>
                        <StackPanel Spacing="4">
                            <TextBlock FontFamily="{StaticResource ChatOSInterfaceFontFamily}" FontSize="38" FontWeight="Bold" Text="{x:Bind ViewModel.Localization.LoginBrandHeadline, Mode=OneWay}" TextWrapping="Wrap" />
                            <TextBlock FontFamily="{StaticResource ChatOSInterfaceFontFamily}" FontSize="38" FontWeight="Bold" Foreground="{StaticResource ChatOSWarningBrush}" Text="{x:Bind ViewModel.Localization.LoginBrandMemory, Mode=OneWay}" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource ChatOSSecondaryTextBrush}" Text="{x:Bind ViewModel.Localization.LoginBrandTagline, Mode=OneWay}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                    <Grid MinHeight="720" Padding="54">
                        <Border
                            Width="410"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0">
                            <Grid>
                                <StackPanel x:Name="LoginForm" Spacing="26">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{x:Bind ViewModel.Localization.SignInTitle, Mode=OneWay}" Style="{StaticResource ChatOSPageTitleTextStyle}" />
                                        <TextBlock Text="{x:Bind ViewModel.Localization.SignInDescription, Mode=OneWay}" Style="{StaticResource ChatOSSecondaryBodyTextStyle}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{x:Bind ViewModel.Localization.Account, Mode=OneWay}" Style="{StaticResource ChatOSBodyStrongTextStyle}" />
                                        <TextBox AutomationProperties.AutomationId="ChatOS.Login.Username" AutomationProperties.Name="Account" Text="{x:Bind ViewModel.Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{x:Bind ViewModel.Localization.AccountPlaceholder, Mode=OneWay}" />
                                    </StackPanel>
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{x:Bind ViewModel.Localization.Password, Mode=OneWay}" Style="{StaticResource ChatOSBodyStrongTextStyle}" />
                                        <PasswordBox x:Name="LoginPasswordBox" AutomationProperties.AutomationId="ChatOS.Login.Password" AutomationProperties.Name="Password" PasswordChanged="OnPasswordChanged" PlaceholderText="{x:Bind ViewModel.Localization.PasswordPlaceholder, Mode=OneWay}" />
                                    </StackPanel>
                                    <TextBlock x:Name="LoginErrorText" AutomationProperties.AutomationId="ChatOS.Login.Error" Foreground="{StaticResource ChatOSFailureBrush}" Style="{StaticResource ChatOSSecondaryBodyTextStyle}" Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" TextWrapping="Wrap" />
                                    <Grid>
                                        <Button x:Name="LoginButton" AutomationProperties.AutomationId="ChatOS.Login.Submit" AutomationProperties.Name="Sign in" Height="44" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{x:Bind ViewModel.LoginCommand}" Content="{x:Bind ViewModel.Localization.SignIn, Mode=OneWay}" Style="{StaticResource ChatOSPrimaryButtonStyle}" />
                                        <ProgressRing x:Name="LoginProgress" Width="20" Height="20" Margin="14,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" IsHitTestVisible="False" />
                                    </Grid>
                                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="6">
                                        <TextBlock VerticalAlignment="Center" Text="{x:Bind ViewModel.Localization.NoAccount, Mode=OneWay}" Style="{StaticResource ChatOSSecondaryBodyTextStyle}" />
                                        <Button AutomationProperties.AutomationId="ChatOS.Login.ShowRegistration" Command="{x:Bind ViewModel.ShowRegistrationCommand}" Content="{x:Bind ViewModel.Localization.CreateAccount, Mode=OneWay}" Style="{StaticResource ChatOSLinkButtonStyle}" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel x:Name="RegistrationForm" Spacing="14" Visibility="Collapsed">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{x:Bind ViewModel.Localization.CreateAccount, Mode=OneWay}" Style="{StaticResource ChatOSPageTitleTextStyle}" />
                                        <TextBlock Text="{x:Bind ViewModel.Localization.RegisterDescription, Mode=OneWay}" Style="{StaticResource ChatOSSecondaryBodyTextStyle}" />
                                    </StackPanel>
                                    <StackPanel Spacing="5">
                                        <TextBlock Text="{x:Bind ViewModel.Localization.Account, Mode=OneWay}" Style="{StaticResource ChatOSBodyStrongTextStyle}" />
                                        <TextBox AutomationProperties.AutomationId="ChatOS.Register.Email" AutomationProperties.Name="Email" Text="{x:Bind ViewModel.Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{x:Bind ViewModel.Localization.AccountPlaceholder, Mode=OneWay}" />
                                    </StackPanel>
                                    <StackPanel Spacing="5">
                                        <TextBlock Text="{x:Bind ViewModel.Localization.InvitationCode, Mode=OneWay}" Style="{StaticResource ChatOSBodyStrongTextStyle}" />
                                        <TextBox AutomationProperties.AutomationId="ChatOS.Register.InvitationCode" AutomationProperties.Name="Invitation code" Text="{x:Bind ViewModel.InviteCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{x:Bind ViewModel.Localization.InvitationCodePlaceholder, Mode=OneWay}" />
                                    </StackPanel>
                                    <StackPanel Spacing="5">
                                        <TextBlock Text="{x:Bind ViewModel.Localization.EmailVerificationCode, Mode=OneWay}" Style="{StaticResource ChatOSBodyStrongTextStyle}" />
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBox AutomationProperties.AutomationId="ChatOS.Register.VerificationCode" AutomationProperties.Name="Email verification code" MaxLength="6" Text="{x:Bind ViewModel.VerificationCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{x:Bind ViewModel.Localization.RegistrationVerificationCodePlaceholder, Mode=OneWay}" />
                                            <Button AutomationProperties.AutomationId="ChatOS.Register.SendCode" AutomationProperties.Name="Send verification code" Grid.Column="1" MinWidth="112" Command="{x:Bind ViewModel.SendRegistrationCodeCommand}" Content="{x:Bind ViewModel.RegistrationCodeActionTitle, Mode=OneWay}" Style="{StaticResource ChatOSSecondaryButtonStyle}" />
                                        </Grid>
                                    </StackPanel>
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="5">
                                            <TextBlock Text="{x:Bind ViewModel.Localization.Password, Mode=OneWay}" Style="{StaticResource ChatOSBodyStrongTextStyle}" />
                                            <PasswordBox x:Name="RegistrationPasswordBox" AutomationProperties.AutomationId="ChatOS.Register.Password" AutomationProperties.Name="Password" PasswordChanged="OnPasswordChanged" PlaceholderText="{x:Bind ViewModel.Localization.MinimumPasswordPlaceholder, Mode=OneWay}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="5">
                                            <TextBlock Text="{x:Bind ViewModel.Localization.ConfirmPassword, Mode=OneWay}" Style="{StaticResource ChatOSBodyStrongTextStyle}" />
                                            <PasswordBox x:Name="RegistrationConfirmPasswordBox" AutomationProperties.AutomationId="ChatOS.Register.ConfirmPassword" AutomationProperties.Name="Confirm password" PasswordChanged="OnConfirmPasswordChanged" PlaceholderText="{x:Bind ViewModel.Localization.ConfirmPasswordPlaceholder, Mode=OneWay}" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock x:Name="RegistrationErrorText" AutomationProperties.AutomationId="ChatOS.Register.Error" Foreground="{StaticResource ChatOSFailureBrush}" Style="{StaticResource ChatOSSecondaryBodyTextStyle}" Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="RegistrationStatusText" AutomationProperties.AutomationId="ChatOS.Register.Status" Foreground="{StaticResource ChatOSSuccessBrush}" Style="{StaticResource ChatOSSecondaryBodyTextStyle}" Text="{x:Bind ViewModel.RegistrationMessage, Mode=OneWay}" TextWrapping="Wrap" />
                                    <Grid>
                                        <Button x:Name="RegisterButton" AutomationProperties.AutomationId="ChatOS.Register.Submit" AutomationProperties.Name="Create account" Height="44" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{x:Bind ViewModel.RegisterCommand}" Content="{x:Bind ViewModel.Localization.CreateAccount, Mode=OneWay}" Style="{StaticResource ChatOSPrimaryButtonStyle}" />
                                        <ProgressRing Width="20" Height="20" Margin="14,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" IsHitTestVisible="False" />
                                    </Grid>
                                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="6">
                                        <TextBlock VerticalAlignment="Center" Text="{x:Bind ViewModel.Localization.AlreadyHaveAccount, Mode=OneWay}" Style="{StaticResource ChatOSSecondaryBodyTextStyle}" />
                                        <Button AutomationProperties.AutomationId="ChatOS.Register.ShowLogin" Command="{x:Bind ViewModel.ShowLoginCommand}" Content="{x:Bind ViewModel.Localization.BackToSignIn, Mode=OneWay}" Style="{StaticResource ChatOSLinkButtonStyle}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>

        <Grid
            x:Name="ShellRoot"
            AutomationProperties.AutomationId="ChatOS.Shell.Root"
            AutomationProperties.Name="ChatOS workspace"
            Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="54" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid x:Name="AppTitleBar" Grid.Row="0" Background="{StaticResource ChatOSTitleBarBackgroundBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="244" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="16,0,0,0" VerticalAlignment="Center" Orientation="Horizontal" Spacing="10">
                    <Border Width="30" Height="30" Background="{StaticResource ChatOSAccentBrush}" CornerRadius="9">
                        <FontIcon Glyph="&#xE8BD;" FontSize="14" Foreground="White" />
                    </Border>
                    <TextBlock VerticalAlignment="Center" Text="ChatOS" Style="{StaticResource ChatOSTitleTextStyle}" />
                </StackPanel>

                <TextBlock Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center" Text="{x:Bind ViewModel.WorkspaceTitle, Mode=OneWay}" Style="{StaticResource ChatOSHeadlineTextStyle}" />

                <StackPanel Grid.Column="2" Margin="0,0,140,0" VerticalAlignment="Center" Orientation="Horizontal" Spacing="4">
                    <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Text="{x:Bind ViewModel.CurrentUserLabel, Mode=OneWay}" Style="{StaticResource ChatOSCaptionTextStyle}" />
                    <Button AutomationProperties.AutomationId="ChatOS.Shell.Notepad" AutomationProperties.Name="{x:Bind ViewModel.Localization.Notepad, Mode=OneWay}" Click="OnNotepadClicked" Style="{StaticResource ChatOSToolbarButtonStyle}" ToolTipService.ToolTip="{x:Bind ViewModel.Localization.Notepad, Mode=OneWay}">
                        <FontIcon Glyph="&#xE70B;" />
                    </Button>
                    <Button AutomationProperties.AutomationId="ChatOS.Shell.Artifacts" AutomationProperties.Name="{x:Bind ViewModel.Localization.Artifacts, Mode=OneWay}" Click="OnArtifactsClicked" Style="{StaticResource ChatOSToolbarButtonStyle}" ToolTipService.ToolTip="{x:Bind ViewModel.Localization.Artifacts, Mode=OneWay}">
                        <FontIcon Glyph="&#xE8B7;" />
                    </Button>
                    <Button AutomationProperties.AutomationId="ChatOS.Shell.ClipboardHistory" AutomationProperties.Name="Clipboard history" Click="OnClipboardHistoryClicked" Style="{StaticResource ChatOSToolbarButtonStyle}" ToolTipService.ToolTip="剪贴板历史">
                        <FontIcon Glyph="&#xE8C8;" />
                    </Button>
                    <Button AutomationProperties.AutomationId="ChatOS.Shell.AccountMenu" AutomationProperties.Name="{x:Bind ViewModel.Localization.AccountAndSettings, Mode=OneWay}" Style="{StaticResource ChatOSToolbarButtonStyle}" ToolTipService.ToolTip="{x:Bind ViewModel.Localization.AccountAndSettings, Mode=OneWay}">
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem AutomationProperties.AutomationId="ChatOS.Shell.Settings" Text="{x:Bind ViewModel.Localization.Settings, Mode=OneWay}" Click="OnSettingsClicked">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE713;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="{x:Bind ViewModel.Localization.SignOut, Mode=OneWay}" Command="{x:Bind ViewModel.LogoutCommand}">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8AC;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>
                        <FontIcon Glyph="&#xE77B;" />
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="244" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Background="{StaticResource ChatOSSidebarBackgroundBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="52" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="12,0" ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button AutomationProperties.AutomationId="ChatOS.Shell.Refresh" AutomationProperties.Name="{x:Bind ViewModel.Localization.RefreshResources, Mode=OneWay}" Command="{x:Bind ViewModel.RefreshWorkspaceCommand}" Style="{StaticResource ChatOSToolbarButtonStyle}" ToolTipService.ToolTip="{x:Bind ViewModel.Localization.RefreshResources, Mode=OneWay}">
                            <FontIcon Glyph="&#xE72C;" />
                        </Button>
                        <Button Grid.Column="1" AutomationProperties.AutomationId="ChatOS.Shell.CreateResource" AutomationProperties.Name="{x:Bind ViewModel.Localization.CreateResource, Mode=OneWay}" Style="{StaticResource ChatOSToolbarButtonStyle}" ToolTipService.ToolTip="{x:Bind ViewModel.Localization.CreateResource, Mode=OneWay}">
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="{x:Bind ViewModel.Localization.CreateLocalProject, Mode=OneWay}" Click="OnCreateLocalProjectClicked" />
                                    <MenuFlyoutItem Text="{x:Bind ViewModel.Localization.RenameLocalProject, Mode=OneWay}" Click="OnRenameLocalProjectClicked" />
                                    <MenuFlyoutItem Text="{x:Bind ViewModel.Localization.RemoveLocalProject, Mode=OneWay}" Click="OnRemoveLocalProjectClicked" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="{x:Bind ViewModel.Localization.CreateLocalTerminal, Mode=OneWay}" Click="OnCreateLocalTerminalClicked">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE756;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Button.Flyout>
                            <FontIcon Glyph="&#xE710;" />
                        </Button>
                        <TextBlock Grid.Column="2" Margin="7,0,0,0" VerticalAlignment="Center" Text="资源" Style="{StaticResource ChatOSBodyStrongTextStyle}" />
                        <ProgressRing Grid.Column="3" Width="18" Height="18" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Padding="10,4,10,22" Spacing="6">
                            <TextBlock Text="{x:Bind ViewModel.Localization.Contacts, Mode=OneWay}" Style="{StaticResource ChatOSSectionLabelTextStyle}" />
                            <ListView AutomationProperties.AutomationId="ChatOS.Shell.Contacts" AutomationProperties.Name="{x:Bind ViewModel.Localization.Contacts, Mode=OneWay}" ItemsSource="{x:Bind ViewModel.Contacts}" SelectedItem="{x:Bind ViewModel.SelectedResource, Mode=OneWay}" SelectionChanged="OnSidebarSelectionChanged" SelectionMode="Single" Style="{StaticResource ChatOSSidebarListStyle}" ItemContainerStyle="{StaticResource ChatOSSidebarItemStyle}" ItemTemplate="{StaticResource ShellResourceTemplate}" />

                            <TextBlock Margin="0,10,0,0" Text="{x:Bind ViewModel.Localization.Projects, Mode=OneWay}" Style="{StaticResource ChatOSSectionLabelTextStyle}" />
                            <TextBlock x:Name="ProjectsEmptyText" Margin="10,4,8,7" Text="项目保存在本机。点击上方 + 创建第一个项目。" TextWrapping="Wrap" Style="{StaticResource ChatOSCaptionTextStyle}" Visibility="Collapsed" />
                            <ListView AutomationProperties.AutomationId="ChatOS.Shell.Projects" AutomationProperties.Name="{x:Bind ViewModel.Localization.Projects, Mode=OneWay}" ItemsSource="{x:Bind ViewModel.Projects}" SelectedItem="{x:Bind ViewModel.SelectedResource, Mode=OneWay}" SelectionChanged="OnSidebarSelectionChanged" Style="{StaticResource ChatOSSidebarListStyle}" ItemContainerStyle="{StaticResource ChatOSSidebarItemStyle}" ItemTemplate="{StaticResource ShellResourceTemplate}" />

                            <TextBlock Margin="0,10,0,0" Text="工作台" Style="{StaticResource ChatOSSectionLabelTextStyle}" />
                            <ListView AutomationProperties.AutomationId="ChatOS.Shell.Applications" AutomationProperties.Name="{x:Bind ViewModel.Localization.Applications, Mode=OneWay}" ItemsSource="{x:Bind ViewModel.ApplicationResources}" SelectedItem="{x:Bind ViewModel.SelectedResource, Mode=OneWay}" SelectionChanged="OnSidebarSelectionChanged" Style="{StaticResource ChatOSSidebarListStyle}" ItemContainerStyle="{StaticResource ChatOSSidebarItemStyle}" ItemTemplate="{StaticResource ShellResourceTemplate}" />

                            <TextBlock Margin="0,10,0,0" Text="{x:Bind ViewModel.Localization.Local, Mode=OneWay}" Style="{StaticResource ChatOSSectionLabelTextStyle}" />
                            <ListView AutomationProperties.AutomationId="ChatOS.Shell.LocalResources" AutomationProperties.Name="{x:Bind ViewModel.Localization.Local, Mode=OneWay}" ItemsSource="{x:Bind ViewModel.LocalResources}" SelectedItem="{x:Bind ViewModel.SelectedResource, Mode=OneWay}" SelectionChanged="OnSidebarSelectionChanged" Style="{StaticResource ChatOSSidebarListStyle}" ItemContainerStyle="{StaticResource ChatOSSidebarItemStyle}" ItemTemplate="{StaticResource ShellResourceTemplate}" />

                            <TextBlock Margin="0,10,0,0" Text="{x:Bind ViewModel.Localization.Remote, Mode=OneWay}" Style="{StaticResource ChatOSSectionLabelTextStyle}" />
                            <TextBlock x:Name="RemoteEmptyText" Margin="10,4,8,7" Text="还没有远端连接" Style="{StaticResource ChatOSCaptionTextStyle}" Visibility="Collapsed" />
                            <ListView AutomationProperties.AutomationId="ChatOS.Shell.RemoteResources" AutomationProperties.Name="{x:Bind ViewModel.Localization.Remote, Mode=OneWay}" ItemsSource="{x:Bind ViewModel.RemoteResources}" SelectedItem="{x:Bind ViewModel.SelectedResource, Mode=OneWay}" SelectionChanged="OnSidebarSelectionChanged" Style="{StaticResource ChatOSSidebarListStyle}" ItemContainerStyle="{StaticResource ChatOSSidebarItemStyle}" ItemTemplate="{StaticResource ShellResourceTemplate}" />
                        </StackPanel>
                    </ScrollViewer>

                    <Border
                        x:Name="SidebarErrorCard"
                        Grid.Row="2"
                        Margin="10,0,10,12"
                        Padding="11"
                        Background="{StaticResource ChatOSWarningSoftBrush}"
                        CornerRadius="10"
                        Visibility="Collapsed">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE783;" FontSize="14" Foreground="{StaticResource ChatOSWarningBrush}" />
                            <TextBlock Grid.Column="1" MaxLines="3" Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" TextWrapping="Wrap" Style="{StaticResource ChatOSCaptionTextStyle}" />
                            <Button Grid.Column="2" Click="OnSidebarRetryClicked" Style="{StaticResource ChatOSToolbarButtonStyle}" ToolTipService.ToolTip="重试">
                                <FontIcon Glyph="&#xE72C;" />
                            </Button>
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Column="1" Background="{StaticResource ChatOSBorderBrush}" />

                <Grid Grid.Column="2" Background="{StaticResource ChatOSWorkspaceBackgroundBrush}">
                    <ContentControl x:Name="WorkspaceContent" AutomationProperties.AutomationId="ChatOS.Shell.Workspace" />
                    <Grid x:Name="EmptyWorkspaceState" Visibility="Collapsed">
                        <StackPanel MaxWidth="520" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
                            <Border Style="{StaticResource ChatOSEmptyStateIconStyle}">
                                <FontIcon Glyph="&#xE700;" FontSize="24" Foreground="{StaticResource ChatOSAccentBrush}" />
                            </Border>
                            <TextBlock HorizontalAlignment="Center" Text="选择一个资源开始" Style="{StaticResource ChatOSPageTitleTextStyle}" />
                            <TextBlock Text="联系人用于持续对话；项目包含文件、聊天、Git、运行设置、Agent 团队与需求调研。" TextAlignment="Center" TextWrapping="Wrap" Style="{StaticResource ChatOSSecondaryBodyTextStyle}" />
                            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="10">
                                <Button Click="OnCreateLocalProjectClicked" Content="新建项目" Style="{StaticResource ChatOSPrimaryButtonStyle}" />
                                <Button Click="OnSidebarRetryClicked" Content="刷新资源" Style="{StaticResource ChatOSSecondaryButtonStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <Border
            x:Name="ApprovalOverlay"
            AutomationProperties.AutomationId="ChatOS.Approval.Root"
            Width="520"
            MaxHeight="520"
            Margin="24"
            Padding="18"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Background="{StaticResource ChatOSContentBackgroundBrush}"
            BorderBrush="{StaticResource ChatOSBorderBrush}"
            BorderThickness="1"
            CornerRadius="14"
            Visibility="Collapsed">
            <Grid RowSpacing="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="3">
                        <TextBlock Text="{x:Bind ViewModel.Localization.LocalOperationAwaitingApproval, Mode=OneWay}" Style="{StaticResource ChatOSHeadlineTextStyle}" />
                        <TextBlock x:Name="ApprovalSourceText" Style="{StaticResource ChatOSCaptionTextStyle}" />
                    </StackPanel>
                    <Border
                        x:Name="ApprovalRiskBadge"
                        Grid.Column="1"
                        Padding="9,4"
                        VerticalAlignment="Top"
                        Background="{StaticResource ChatOSProcessBackgroundBrush}"
                        CornerRadius="10">
                        <TextBlock x:Name="ApprovalRiskText" Style="{StaticResource ChatOSBodyStrongTextStyle}" />
                    </Border>
                </Grid>

                <Border
                    Grid.Row="1"
                    Padding="12"
                    Background="{StaticResource ChatOSWorkspaceBackgroundBrush}"
                    CornerRadius="8">
                    <ScrollViewer MaxHeight="170" VerticalScrollBarVisibility="Auto">
                        <TextBlock
                            x:Name="ApprovalCommandText"
                            FontFamily="Cascadia Mono, Consolas"
                            FontSize="12"
                            IsTextSelectionEnabled="True"
                            TextWrapping="Wrap" />
                    </ScrollViewer>
                </Border>

                <StackPanel Grid.Row="2" Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8B7;" FontSize="12" Foreground="{StaticResource ChatOSSecondaryTextBrush}" />
                        <TextBlock
                            x:Name="ApprovalWorkingDirectoryText"
                            Style="{StaticResource ChatOSSecondaryBodyTextStyle}"
                            IsTextSelectionEnabled="True"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock
                        x:Name="ApprovalReasonText"
                        Foreground="{StaticResource ChatOSSecondaryTextBrush}"
                        Style="{StaticResource ChatOSSecondaryBodyTextStyle}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <TextBlock
                    x:Name="ApprovalQueueText"
                    Grid.Row="3"
                    Style="{StaticResource ChatOSCaptionTextStyle}" />

                <Grid Grid.Row="4" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button
                        x:Name="DeclineApprovalButton"
                        AutomationProperties.AutomationId="ChatOS.Approval.Deny"
                        Click="OnDeclineApproval"
                        Content="{x:Bind ViewModel.Localization.Deny, Mode=OneWay}" />
                    <ProgressRing
                        x:Name="ApprovalProgressRing"
                        Grid.Column="1"
                        Width="20"
                        Height="20"
                        HorizontalAlignment="Right"
                        IsActive="False" />
                    <Button
                        x:Name="AcceptApprovalButton"
                        AutomationProperties.AutomationId="ChatOS.Approval.AllowOnce"
                        Grid.Column="2"
                        Click="OnAcceptApproval"
                        Content="{x:Bind ViewModel.Localization.AllowOnce, Mode=OneWay}" />
                    <Button
                        x:Name="AcceptSessionApprovalButton"
                        AutomationProperties.AutomationId="ChatOS.Approval.AllowSession"
                        Grid.Column="3"
                        Click="OnAcceptSessionApproval"
                        Content="{x:Bind ViewModel.Localization.AllowForSession, Mode=OneWay}"
                        Style="{StaticResource ChatOSPrimaryButtonStyle}" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
