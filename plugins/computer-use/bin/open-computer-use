#!/usr/bin/env node

const { spawn, spawnSync } = require("node:child_process");
const crypto = require("node:crypto");
const fs = require("node:fs");
const os = require("node:os");
const path = require("node:path");

const packageRoot = path.resolve(__dirname, "..");
const packageMetadata = JSON.parse(
  fs.readFileSync(path.join(packageRoot, "package.json"), "utf8"),
);
const args = process.argv.slice(2);

function fail(message) {
  console.error(message);
  process.exit(1);
}

function sleep(milliseconds) {
  Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, milliseconds);
}

function sha256File(filePath) {
  return crypto.createHash("sha256").update(fs.readFileSync(filePath)).digest("hex");
}

function appFingerprint(appPath) {
  const fingerprintFiles = [
    path.join(appPath, "Contents", "Info.plist"),
    path.join(appPath, "Contents", "MacOS", "visual-computer-use-mcp"),
  ];
  const codeResources = path.join(
    appPath,
    "Contents",
    "_CodeSignature",
    "CodeResources",
  );
  if (fs.existsSync(codeResources)) fingerprintFiles.push(codeResources);
  return crypto
    .createHash("sha256")
    .update(fingerprintFiles.map(sha256File).join("\n"))
    .digest("hex");
}

function managedRuntimeRoot() {
  const configured = process.env.VISUAL_COMPUTER_USE_MANAGED_APP_ROOT;
  if (configured) {
    if (!path.isAbsolute(configured)) {
      fail("VISUAL_COMPUTER_USE_MANAGED_APP_ROOT must be an absolute path.");
    }
    return path.resolve(configured);
  }
  return path.join(
    os.homedir(),
    "Library",
    "Application Support",
    "Visual Computer Use",
    "runtime",
  );
}

function managedProcessIDs(executablePath) {
  const result = spawnSync("/bin/ps", ["-axo", "pid=,command="], {
    encoding: "utf8",
  });
  if (result.status !== 0 || typeof result.stdout !== "string") return [];
  return result.stdout
    .split("\n")
    .map((line) => line.trim())
    .filter(Boolean)
    .flatMap((line) => {
      const match = line.match(/^(\d+)\s+(.+)$/);
      if (!match) return [];
      const command = match[2];
      if (command !== executablePath && !command.startsWith(`${executablePath} `)) {
        return [];
      }
      const pid = Number(match[1]);
      return Number.isSafeInteger(pid) && pid > 1 && pid !== process.pid
        ? [pid]
        : [];
    });
}

function processIsRunning(pid) {
  try {
    process.kill(pid, 0);
    return true;
  } catch (error) {
    return Boolean(error && error.code === "EPERM");
  }
}

function terminateManagedProcesses(executablePath) {
  const pids = managedProcessIDs(executablePath);
  for (const pid of pids) {
    try {
      process.kill(pid, "SIGTERM");
    } catch (error) {
      if (!error || error.code !== "ESRCH") throw error;
    }
  }
  const deadline = Date.now() + 1500;
  while (Date.now() < deadline && pids.some(processIsRunning)) sleep(50);
  for (const pid of pids) {
    if (!processIsRunning(pid)) continue;
    try {
      process.kill(pid, "SIGKILL");
    } catch (error) {
      if (!error || error.code !== "ESRCH") throw error;
    }
  }
}

function ensureManagedApp() {
  if (process.platform !== "darwin") {
    fail("Visual Computer Use currently supports macOS only.");
  }

  const sourceApp = path.join(packageRoot, "dist", "Visual Computer Use.app");
  const runtimeRoot = managedRuntimeRoot();
  const managedApp = path.join(runtimeRoot, "Visual Computer Use.app");
  const executablePath = path.join(
    managedApp,
    "Contents",
    "MacOS",
    "visual-computer-use-mcp",
  );
  const lockPath = path.join(runtimeRoot, ".install-lock");

  if (!fs.existsSync(sourceApp)) {
    fail(`Missing bundled macOS app at ${sourceApp}.`);
  }
  fs.mkdirSync(runtimeRoot, { recursive: true, mode: 0o700 });

  const sourceFingerprint = appFingerprint(sourceApp);
  if (fs.existsSync(executablePath)) {
    try {
      if (appFingerprint(managedApp) === sourceFingerprint) return executablePath;
    } catch {}
  }

  let lockAcquired = false;
  for (let attempt = 0; attempt < 200; attempt += 1) {
    try {
      fs.mkdirSync(lockPath, { mode: 0o700 });
      lockAcquired = true;
      break;
    } catch (error) {
      if (error && error.code === "EEXIST") {
        sleep(50);
        continue;
      }
      throw error;
    }
  }
  if (!lockAcquired) fail(`Timed out waiting for ${lockPath}.`);

  const stagingApp = path.join(
    runtimeRoot,
    `.Visual Computer Use.app.staging-${process.pid}-${Date.now()}`,
  );
  const backupApp = path.join(
    runtimeRoot,
    `.Visual Computer Use.app.backup-${process.pid}-${Date.now()}`,
  );

  try {
    if (fs.existsSync(executablePath)) {
      try {
        if (appFingerprint(managedApp) === sourceFingerprint) return executablePath;
      } catch {}
    }

    fs.rmSync(stagingApp, { recursive: true, force: true });
    fs.cpSync(sourceApp, stagingApp, {
      recursive: true,
      dereference: false,
      preserveTimestamps: true,
    });
    if (appFingerprint(stagingApp) !== sourceFingerprint) {
      fail("Managed app staging fingerprint does not match the package app.");
    }

    terminateManagedProcesses(executablePath);
    let movedExisting = false;
    if (fs.existsSync(managedApp)) {
      fs.renameSync(managedApp, backupApp);
      movedExisting = true;
    }
    try {
      fs.renameSync(stagingApp, managedApp);
    } catch (error) {
      if (movedExisting && !fs.existsSync(managedApp)) {
        fs.renameSync(backupApp, managedApp);
      }
      throw error;
    }
    fs.rmSync(backupApp, { recursive: true, force: true });
  } finally {
    fs.rmSync(stagingApp, { recursive: true, force: true });
    fs.rmSync(lockPath, { recursive: true, force: true });
  }

  return executablePath;
}

function spawnAndExit(executablePath, executableArgs) {
  const child = spawn(executablePath, executableArgs, { stdio: "inherit" });
  child.on("error", (error) => {
    fail(`Failed to start Visual Computer Use: ${error.message}`);
  });
  for (const signal of ["SIGINT", "SIGTERM"]) {
    process.on(signal, () => child.kill(signal));
  }
  child.on("exit", (code, signal) => {
    process.exit(signal ? 1 : (code ?? 0));
  });
}

function readDiagnostics(executablePath) {
  const managedApp = path.resolve(executablePath, "..", "..", "..");
  const outputPath = path.join(
    os.tmpdir(),
    `visual-computer-use-doctor-${process.pid}-${Date.now()}.json`,
  );
  const result = spawnSync("/usr/bin/open", [
    "-W",
    "-n",
    managedApp,
    "--args",
    "--doctor-output",
    outputPath,
  ], {
    encoding: "utf8",
  });
  if (result.stderr) process.stderr.write(result.stderr);
  if (result.status !== 0) process.exit(result.status ?? 1);

  let diagnostics;
  try {
    diagnostics = JSON.parse(fs.readFileSync(outputPath, "utf8"));
  } catch {
    fail("Visual Computer Use LaunchServices doctor returned invalid JSON.");
  } finally {
    try {
      fs.unlinkSync(outputPath);
    } catch {}
  }
  process.stdout.write(`${JSON.stringify(diagnostics, null, 2)}\n`);
  return diagnostics;
}

function runDoctor(executablePath) {
  const diagnostics = readDiagnostics(executablePath);
  if (!diagnostics.allGranted) {
    const managedApp = path.resolve(executablePath, "..", "..", "..");
    const onboarding = spawn("/usr/bin/open", [
      "-n",
      managedApp,
      "--args",
      "--onboarding",
    ], {
      detached: true,
      stdio: "ignore",
    });
    onboarding.unref();
  }
}

if (args.includes("--version") || args.includes("-v") || args[0] === "version") {
  console.log(packageMetadata.version);
  process.exit(0);
}

const executablePath = ensureManagedApp();
const command = args[0] ?? "mcp";
if (command === "doctor" || command === "--doctor") {
  runDoctor(executablePath);
  process.exit(0);
}
if (command === "check-permissions") {
  readDiagnostics(executablePath);
  process.exit(0);
}
if (command === "onboarding" || command === "--onboarding") {
  const managedApp = path.resolve(executablePath, "..", "..", "..");
  spawnAndExit("/usr/bin/open", ["-W", "-n", managedApp, "--args", "--onboarding"]);
} else if (command === "mcp") {
  spawnAndExit(executablePath, []);
} else {
  spawnAndExit(executablePath, args);
}
