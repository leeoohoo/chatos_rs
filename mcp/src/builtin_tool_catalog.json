  "CodeMaintainerWrite": [
    {
      "description": "Open a write session for the current project workspace. Use one session, stage one or more edit batches against its in-memory snapshot, then finish with commit_edit_session or abort_edit_session. Set fresh=true after a stale-context or expected-match recovery when the previous session must be discarded and rebased from the latest workspace state.\nWrites enabled.\nPaths are relative to the current project workspace root.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "fresh": {
            "description": "Discard the reusable session for this run/conversation and create a new baseline from the current workspace.",
            "type": "boolean"
          },
          "purpose": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "name": "open_edit_session"
    },
    {
      "description": "Atomically commit the staged session snapshot to the current project workspace. The commit revalidates every touched path against the session baseline before making any change, so stale paths fail together instead of cascading. Writes enabled\nPaths are relative to the current project workspace root.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "session_id": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "session_id"
        ],
        "type": "object"
      },
      "name": "commit_edit_session"
    },
    {
      "description": "Abort a write session and discard its staged in-memory snapshot without touching the file system.\nPaths are relative to the current project workspace root.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "session_id": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "session_id"
        ],
        "type": "object"
      },
      "name": "abort_edit_session"
    },
    {
      "description": "Stage one or more ordered edit operations into an existing write session without touching the file system yet. Multiple operations may target the same file; they will be applied sequentially to the session snapshot. For the first operation that touches a path, expected_sha256 must match the latest successful read of the current file, or be null only when the path is confirmed absent (and for directory deletes).\nSupported operation kinds: write, replace_text, append, delete.\nPaths are relative to the current project workspace root.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "operations": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "after_context": {
                  "description": "Optional exact anchor expected immediately after old_text or within the following 12 lines.",
                  "type": "string"
                },
                "before_context": {
                  "description": "Optional exact anchor expected immediately before old_text or within the preceding 12 lines.",
                  "type": "string"
                },
                "content": {
                  "type": "string"
                },
                "end_line": {
                  "description": "Optional inclusive upper bound for the first line where old_text may start; multi-line old_text may extend beyond it.",
                  "minimum": 1,
                  "type": "integer"
                },
                "expected_matches": {
                  "minimum": 1,
                  "type": "integer"
                },
                "expected_sha256": {
                  "pattern": "^[0-9a-f]{64}$",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "kind": {
                  "enum": [
                    "write",
                    "replace_text",
                    "append",
                    "delete"
                  ],
                  "type": "string"
                },
                "new_text": {
                  "type": "string"
                },
                "old_text": {
                  "type": "string"
                },
                "path": {
                  "type": "string"
                },
                "start_line": {
                  "description": "Optional inclusive lower bound for the first line where old_text may start.",
                  "minimum": 1,
                  "type": "integer"
                }
              },
              "required": [
                "kind",
                "path"
              ],
              "type": "object"
            },
            "minItems": 1,
            "type": "array"
          },
          "session_id": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "session_id",
          "operations"
        ],
        "type": "object"
      },
      "name": "stage_edit_batch"
    }
  ],
