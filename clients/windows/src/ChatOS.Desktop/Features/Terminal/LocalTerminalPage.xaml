<UserControl
    x:Class="ChatOS.Desktop.Features.Terminal.LocalTerminalPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid AutomationProperties.AutomationId="ChatOS.LocalTerminal.Root" AutomationProperties.Name="Local terminal" Background="{StaticResource ChatOSContentBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="1" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Padding="12,0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button AutomationProperties.AutomationId="ChatOS.LocalTerminal.Back" AutomationProperties.Name="{x:Bind Localization.Back, Mode=OneWay}" Click="OnCloseClicked" Style="{StaticResource ChatOSToolbarButtonStyle}" ToolTipService.ToolTip="{x:Bind Localization.Back, Mode=OneWay}">
                <FontIcon Glyph="&#xE72B;" />
            </Button>
            <StackPanel Grid.Column="1" Margin="6,0" VerticalAlignment="Center" Spacing="1">
                <TextBlock x:Name="TitleText" Style="{StaticResource ChatOSHeadlineTextStyle}" />
                <TextBlock x:Name="PathText" Style="{StaticResource ChatOSCaptionTextStyle}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Button AutomationProperties.AutomationId="ChatOS.LocalTerminal.Stop" Grid.Column="2" Click="OnStopClicked" Content="{x:Bind Localization.StopTerminal, Mode=OneWay}" />
        </Grid>
        <Border Grid.Row="1" Background="{StaticResource ChatOSBorderBrush}" />
        <TextBox
            x:Name="OutputText"
            Grid.Row="2"
            Padding="14"
            AcceptsReturn="True"
            FontFamily="Cascadia Mono, Consolas"
            FontSize="12"
            IsReadOnly="True"
            TextWrapping="NoWrap"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Auto" />
        <Grid Grid.Row="3" Padding="12" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                x:Name="InputText"
                AutomationProperties.AutomationId="ChatOS.LocalTerminal.Input"
                AutomationProperties.Name="{x:Bind Localization.TerminalCommandPlaceholder, Mode=OneWay}"
                PlaceholderText="{x:Bind Localization.TerminalCommandPlaceholder, Mode=OneWay}"
                KeyDown="OnInputKeyDown" />
            <Button AutomationProperties.AutomationId="ChatOS.LocalTerminal.Send" Grid.Column="1" Click="OnSendClicked" Content="{x:Bind Localization.Send, Mode=OneWay}" Style="{StaticResource ChatOSPrimaryButtonStyle}" />
        </Grid>
    </Grid>
</UserControl>
