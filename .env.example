# Root `.env` is now reserved for host-side Local Connector Client settings.
# Cloud/server bootstrap settings live in `docker/bootstrap.conf.example`.

LOCAL_CONNECTOR_SERVICE_PORT=39230
LOCAL_CONNECTOR_CORE_API_PORT=39232
LOCAL_CONNECTOR_CLIENT_FRONTEND_PORT=39233

LOCAL_CONNECTOR_CLOUD_BASE_URL=https://local-connector.jgoool.com
LOCAL_CONNECTOR_USER_SERVICE_BASE_URL=
LOCAL_CONNECTOR_CHATOS_WEB_URL=https://app.jgoool.com

LOCAL_CONNECTOR_ACCESS_TOKEN=
LOCAL_CONNECTOR_DEVICE_NAME=
LOCAL_CONNECTOR_PUBLIC_KEY=
LOCAL_CONNECTOR_WORKSPACE_PATH=
LOCAL_CONNECTOR_WORKSPACE_ALIAS=
LOCAL_CONNECTOR_STATE_PATH=

LOCAL_CONNECTOR_CLIENT_CARGO_TARGET_DIR=local_connector_client/target
LOCAL_CONNECTOR_DOCKER_MAINTENANCE_ENABLED=true
LOCAL_CONNECTOR_DOCKER_BUILD_CACHE_MAX_USED_SPACE=32gb
LOCAL_CONNECTOR_DOCKER_BUILD_CACHE_RESERVED_SPACE=8gb
LOCAL_CONNECTOR_DOCKER_BUILD_CACHE_TIMEOUT_SECS=180

# Shared AI transport timeouts used by the local Task Runner runtime.
CHATOS_AI_CONNECT_TIMEOUT_SECS=15
CHATOS_AI_READ_TIMEOUT_SECS=7200

# Optional shared user-service endpoint for the host-side client.
USER_SERVICE_PORT=39190
CHATOS_USER_SERVICE_BASE_URL=http://127.0.0.1:39190
