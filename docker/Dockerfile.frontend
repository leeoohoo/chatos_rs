ARG NODE_IMAGE=node:24-bookworm-slim
ARG NGINX_IMAGE=nginx:1.30-alpine

FROM ${NODE_IMAGE} AS builder

WORKDIR /src
COPY . .

ARG APP_DIR
ARG VITE_API_BASE_URL=
ARG VITE_MEMORY_ENGINE_API_BASE=
ARG VITE_USER_SERVICE_API_BASE=
ARG VITE_CONFIG_CENTER_URL=
ARG VITE_BASE_PATH=/
ARG NPM_REGISTRY=https://registry.npmjs.org

ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
ENV VITE_MEMORY_ENGINE_API_BASE=${VITE_MEMORY_ENGINE_API_BASE}
ENV VITE_USER_SERVICE_API_BASE=${VITE_USER_SERVICE_API_BASE}
ENV VITE_CONFIG_CENTER_URL=${VITE_CONFIG_CENTER_URL}
ENV VITE_BASE_PATH=${VITE_BASE_PATH}

WORKDIR /src/${APP_DIR}
RUN npm config set registry "$NPM_REGISTRY" \
    && npm config set replace-registry-host always \
    && if [ -f package-lock.json ]; then npm ci --legacy-peer-deps; else npm install --legacy-peer-deps; fi
RUN npm run build

FROM ${NGINX_IMAGE}

ARG APP_DIR

RUN sed -i \
      -e 's|https://dl-cdn.alpinelinux.org|https://mirrors.aliyun.com|g' \
      -e 's|http://dl-cdn.alpinelinux.org|http://mirrors.aliyun.com|g' \
      /etc/apk/repositories \
    && apk upgrade --no-cache

COPY docker/nginx/default.conf.template /etc/nginx/templates/default.conf.template
COPY --from=builder /src/${APP_DIR}/dist /usr/share/nginx/html

ENV API_PROXY_PASS=http://127.0.0.1:1
ENV MEMORY_ENGINE_PROXY_PASS=http://127.0.0.1:1
ENV USER_SERVICE_PROXY_PASS=http://127.0.0.1:1
ENV SANDBOX_MANAGER_FRONTEND_PROXY_CLIENT_ID=
ENV SANDBOX_MANAGER_FRONTEND_PROXY_CLIENT_KEY=

EXPOSE 80
