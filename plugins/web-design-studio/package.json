{
  "name": "@chatos/web-design-studio",
  "version": "0.10.0",
  "description": "AI-editable visual website design workbench for ChatOS and Codex.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "chatos-web-design-studio": "bin/chatos-web-design-studio"
  },
  "files": [
    "assets/",
    "bin/",
    "dist/",
    "!dist/*.test.mjs",
    "docs/",
    "skills/",
    "ui/",
    ".codex-plugin/",
    ".mcp.json",
    "chatos.plugin.json",
    "README.md"
  ],
  "scripts": {
    "dev": "vite",
    "sync:inspira": "node scripts/sync-inspira-registry.mjs",
    "sync:antd": "node scripts/sync-antd-registry.mjs",
    "sync:chakra": "node scripts/sync-chakra-registry.mjs",
    "sync:shadcn": "node scripts/sync-shadcn-registry.mjs",
    "sync:magicui": "node scripts/sync-magicui-registry.mjs",
    "sync:spell": "node scripts/sync-spell-registry.mjs",
    "sync:daisyui": "node scripts/sync-daisyui-registry.mjs",
    "build": "vite build && node scripts/build.mjs",
    "studio": "node bin/chatos-web-design-studio studio",
    "studio:dev": "npm run build && npm run studio",
    "mcp": "node dist/mcp-server.mjs mcp",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "pack:verify": "npm run test && npm pack --dry-run"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.4",
    "@base-ui/react": "^1.8.0",
    "@chakra-ui/react": "3.37.0",
    "@emotion/react": "11.14.0",
    "@formisch/react": "^1.0.0",
    "@hookform/resolvers": "^5.9.1",
    "@iconify-icons/devicon": "^2.0.0",
    "@iconify-icons/heroicons": "^2.0.1",
    "@iconify-icons/logos": "^2.0.0",
    "@iconify-icons/lucide": "^2.0.5",
    "@iconify-icons/mdi": "^2.0.0",
    "@iconify-icons/simple-icons": "^2.0.1",
    "@iconify-icons/tabler": "^2.0.0",
    "@iconify/vue": "^5.0.1",
    "@icons-pack/react-simple-icons": "^13.8.0",
    "@inspira-ui/plugins": "0.0.2",
    "@internationalized/date": "3.12.3",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@number-flow/vue": "^0.5.2",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-slot": "^1.2.3",
