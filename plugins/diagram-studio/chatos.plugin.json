{
  "schemaVersion": 3,
  "name": "chatos-diagram-studio",
  "version": "0.2.0",
  "description": "Create and edit architecture diagrams, flowcharts, swimlane diagrams, topology maps, and sequence diagrams with complete PlantUML interoperability.",
  "author": {
    "name": "Chatos"
  },
  "license": "Apache-2.0",
  "keywords": ["architecture", "flowchart", "swimlane", "topology", "sequence", "plantuml", "diagram", "mcp"],
  "mcpServers": {
    "diagram-mcp": {
      "type": "stdio",
      "bin": "chatos-diagram-studio",
      "args": ["mcp"],
      "env": {}
    }
  },
  "skills": [
    "./skills/diagram-studio",
    "./skills/diagram-architecture",
    "./skills/diagram-flowchart",
    "./skills/diagram-swimlane",
    "./skills/diagram-topology",
    "./skills/diagram-sequence"
  ],
  "ui": [
    {
      "componentKey": "diagram-workbench",
      "source": "./ui/index.html",
      "title": "Diagram Studio",
      "surface": "workbench",
      "assets": ["./ui/assets/app.js", "./ui/assets/app.css"],
      "bridgeCapabilities": [
        "host.context.read",
        "artifact.list",
        "artifact.read",
        "artifact.download",
        "artifact.create",
        "artifact.update"
      ],
      "artifactMimeTypes": [
        "application/vnd.chatos.diagram+json",
        "application/json",
        "text/vnd.plantuml",
        "text/plain",
        "image/svg+xml",
        "image/png"
      ],
      "runtime": {
        "type": "local_http",
        "bin": "chatos-diagram-studio",
        "args": ["studio"],
        "healthPath": "/api/health",
        "launchTimeoutMs": 15000
      }
    }
  ],
  "interface": {
    "displayName": "Diagram Studio",
    "shortDescription": "Technical diagrams with PlantUML interoperability",
    "longDescription": "A native-feeling visual workbench for creating structured diagrams by hand or through AI tools. Architecture, flowchart, swimlane, topology, and sequence diagrams support bidirectional PlantUML source while canvas layout and styling remain editable.",
    "developerName": "Chatos",
    "category": "Productivity",
    "capabilities": [
      "Architecture diagrams",
      "Flowcharts",
      "Swimlane diagrams",
      "Topology maps",
      "Sequence diagrams",
      "PlantUML Sequence, Activity, Component, and Deployment import and export",
      "AI-editable structured documents",
      "SVG, PNG, JSON, and PlantUML export"
    ],
    "defaultPrompt": [
      "Analyze this project and create an architecture diagram.",
      "Turn this process description into a flowchart.",
      "Create a swimlane diagram for this workflow.",
      "Create an editable architecture or topology diagram from this PlantUML source.",
      "Create an editable sequence diagram from this PlantUML source."
    ],
    "brandColor": "#6E57D8",
    "logo": "./assets/logo.svg",
    "logoDark": "./assets/logo.svg"
  },
  "dependencies": {
    "minimumHostVersion": ">=2.2.0",
    "supportedPlatforms": ["macos", "windows", "linux"]
  },
  "runtimeContext": {
    "scope": "project",
    "components": ["diagram-mcp", "diagram-workbench"],
    "required": [],
    "optional": ["project.id", "workspace.id", "workspace.root"],
    "storageIsolation": "project",
    "missingContext": "device"
  },
  "permissions": [
    {
      "permission": "process.spawn",
      "required": true,
      "reason": "Launch the installed Diagram Studio MCP and local application service.",
      "components": ["diagram-mcp", "diagram-workbench"]
    },
    {
      "permission": "artifact.create",
      "required": true,
      "reason": "Export diagram documents as JSON, SVG, PNG, and PlantUML deliverables.",
      "components": ["diagram-mcp", "diagram-workbench"]
    }
  ]
}
