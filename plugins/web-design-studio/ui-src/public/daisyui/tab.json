{
  "slug": "tab",
  "title": "Tabs",
  "description": "Tabs can be used to show a list of links in a tabbed format.",
  "demos": [
    {
      "id": "tab-1",
      "label": "tabs",
      "html": "<div role=\"tablist\" class=\"tabs\">\n  <a role=\"tab\" class=\"tab\">Tab 1</a>\n  <a role=\"tab\" class=\"tab tab-active\">Tab 2</a>\n  <a role=\"tab\" class=\"tab\">Tab 3</a>\n</div>"
    },
