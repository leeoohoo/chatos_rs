{
  "name": "open-computer-use",
  "version": "0.9.0",
  "description": "Visual-first macOS Computer Use MCP server for ChatOS.",
  "license": "MIT",
  "bin": {
    "open-computer-use": "bin/open-computer-use"
  },
  "scripts": {
    "test": "swift test",
    "test:packaging": "node --test ./scripts/package-support.test.mjs ./scripts/skill-platform-support.test.mjs",
    "audit:skill-gates": "node ./scripts/audit-skill-gates.mjs",
    "build:app": "./scripts/build-macos-app.sh",
    "build:windows": "node ./scripts/build-windows-worker.mjs",
    "smoke:windows": "node ./scripts/smoke-windows-worker.mjs",
    "smoke:windows:screen": "node ./scripts/smoke-windows-worker.mjs --screen",
    "pack:chatos": "npm run pack:macos",
    "pack:macos": "node ./scripts/build-chatos-package.mjs --platform macos",
    "pack:windows": "node ./scripts/build-chatos-package.mjs --platform windows"
  },
  "files": [
    "bin/",
    "chatos.plugin.json",
    "dist/Visual Computer Use.app/",
    "skills/",
    "README.md",
    "LICENSE"
  ]
}
