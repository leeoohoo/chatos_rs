<Page
    x:Class="ChatOS.Desktop.Features.AgentTeams.AgentWorkspacePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:domain="using:ChatOS.Core.Domain"
    xmlns:presentation="using:ChatOS.Presentation.AgentTeams"
    xmlns:shell="using:ChatOS.Desktop.AppShell"
    AutomationProperties.AutomationId="ChatOS.AgentWorkspace.Root"
    AutomationProperties.Name="Agent 工作区">

    <Grid Background="{StaticResource ChatOSWorkspaceBackgroundBrush}">
        <Grid Padding="28,22,28,26" RowSpacing="12">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="11">
                    <Border Width="38" Height="38" Background="{StaticResource ChatOSPurpleSoftBrush}" CornerRadius="11">
                        <FontIcon Glyph="&#xE716;" FontSize="19" Foreground="{StaticResource ChatOSPurpleBrush}" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Agent" Style="{StaticResource ChatOSPageTitleTextStyle}" />
                        <TextBlock Text="管理 Agent、继续私聊，或进入项目团队" Style="{StaticResource ChatOSCaptionTextStyle}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                    <Button Click="OnNewAgentClick" Content="新建 Agent" Style="{StaticResource ChatOSPrimaryButtonStyle}" />
                    <Button Click="OnRunAgentsClick" Style="{StaticResource ChatOSToolbarButtonStyle}" ToolTipService.ToolTip="运行等待队列"><FontIcon Glyph="&#xE768;" /></Button>
                    <Button Click="OnRefreshClick" Style="{StaticResource ChatOSToolbarButtonStyle}" ToolTipService.ToolTip="刷新"><FontIcon Glyph="&#xE72C;" /></Button>
                </StackPanel>
            </Grid>

            <InfoBar x:Name="NoticeBar" Grid.Row="1" IsClosable="False" />

            <Grid Grid.Row="2" ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="250" /><ColumnDefinition Width="250" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

                <Border Style="{StaticResource ChatOSSectionCardStyle}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="1" /><RowDefinition Height="*" /><RowDefinition Height="1" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <StackPanel Padding="15,13" Spacing="2">
                            <TextBlock Text="我的 Agent" Style="{StaticResource ChatOSHeadlineTextStyle}" />
                            <TextBlock Text="点击即可打开私聊" Style="{StaticResource ChatOSCaptionTextStyle}" />
                        </StackPanel>
                        <Border Grid.Row="1" Background="{StaticResource ChatOSBorderBrush}" />
                        <ListView Grid.Row="2" Padding="7" Background="Transparent" BorderThickness="0" IsItemClickEnabled="True" ItemClick="OnAgentClicked" ItemsSource="{x:Bind ViewModel.Agents}" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="domain:AgentProfile">
                                    <Grid Padding="8" ColumnSpacing="9">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <Border Width="32" Height="32" Background="{StaticResource ChatOSPurpleSoftBrush}" CornerRadius="10"><FontIcon Glyph="&#xE77B;" FontSize="14" Foreground="{StaticResource ChatOSPurpleBrush}" /></Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                            <TextBlock FontWeight="SemiBold" Text="{x:Bind Draft.Name}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Draft.Description}" TextTrimming="CharacterEllipsis" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="3">
                                            <Button Click="OnEditAgentClick" Style="{StaticResource ChatOSToolbarButtonStyle}" ToolTipService.ToolTip="编辑"><FontIcon Glyph="&#xE70F;" FontSize="12" /></Button>
                                            <Button Click="OnArchiveAgentClick" Style="{StaticResource ChatOSToolbarButtonStyle}" ToolTipService.ToolTip="归档"><FontIcon Glyph="&#xE74D;" FontSize="12" /></Button>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <Border Grid.Row="3" Background="{StaticResource ChatOSBorderBrush}" />
                        <StackPanel Grid.Row="4" Padding="14,12" Spacing="8">
                            <TextBlock Text="项目团队" Style="{StaticResource ChatOSHeadlineTextStyle}" />
                            <ItemsControl ItemsSource="{x:Bind Shell.Projects}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="shell:ShellResourceViewModel">
                                        <Button Margin="0,0,0,5" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="OnProjectClicked" Style="{StaticResource ChatOSSecondaryButtonStyle}">
                                            <StackPanel><TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" /><TextBlock Text="打开 Agent 团队" Style="{StaticResource ChatOSCaptionTextStyle}" /></StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource ChatOSSectionCardStyle}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="1" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <StackPanel Padding="15,13" Spacing="2">
                            <TextBlock Text="私聊" Style="{StaticResource ChatOSHeadlineTextStyle}" />
                            <TextBlock Text="所有 Agent 私聊都保存在本机" Style="{StaticResource ChatOSCaptionTextStyle}" />
                        </StackPanel>
                        <Border Grid.Row="1" Background="{StaticResource ChatOSBorderBrush}" />
                        <ListView Grid.Row="2" Padding="7" Background="Transparent" BorderThickness="0" ItemsSource="{x:Bind ViewModel.Rooms}" SelectedItem="{x:Bind ViewModel.SelectedRoom, Mode=TwoWay}" SelectionChanged="OnRoomSelectionChanged">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="domain:AgentRoom">
                                    <StackPanel Padding="8" Spacing="2">
                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind Draft.Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Draft.Goal}" TextTrimming="CharacterEllipsis" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource ChatOSSectionCardStyle}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="1" /><RowDefinition Height="*" /><RowDefinition Height="1" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <StackPanel Padding="17,13" Spacing="3">
                            <TextBlock Text="{x:Bind SelectedRoomName, Mode=OneWay}" Style="{StaticResource ChatOSHeadlineTextStyle}" />
                            <TextBlock Text="{x:Bind SelectedRoomGoal, Mode=OneWay}" TextWrapping="Wrap" Style="{StaticResource ChatOSCaptionTextStyle}" />
                        </StackPanel>
                        <Border Grid.Row="1" Background="{StaticResource ChatOSBorderBrush}" />
                        <ListView Grid.Row="2" Padding="14,8" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" ItemsSource="{x:Bind ViewModel.MessageItems}" SelectionMode="None">
                            <ListView.Header>
                                <Grid Padding="0,4,0,7" Visibility="{x:Bind ViewModel.HasEarlierMessages, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Button HorizontalAlignment="Center" Click="OnLoadEarlierMessagesClick" Content="加载更早消息" Style="{StaticResource ChatOSSecondaryButtonStyle}" Visibility="{x:Bind ViewModel.IsLoadingEarlierMessages, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                    <ProgressRing Width="20" Height="20" HorizontalAlignment="Center" IsActive="{x:Bind ViewModel.IsLoadingEarlierMessages, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsLoadingEarlierMessages, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </Grid>
                            </ListView.Header>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="IsTabStop" Value="False" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="presentation:AgentMessageItemViewModel">
                                    <Border MaxWidth="640" Margin="0,4" Padding="12" HorizontalAlignment="{x:Bind IsHuman, Converter={StaticResource AgentMessageAlignmentConverter}}" Background="{x:Bind IsHuman, Converter={StaticResource AgentMessageBubbleBrushConverter}}" CornerRadius="11">
                                        <StackPanel Spacing="5">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Border Width="25" Height="25" Background="{StaticResource ChatOSPurpleSoftBrush}" CornerRadius="8" Visibility="{x:Bind IsHuman, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                                    <FontIcon Glyph="{x:Bind SenderGlyph}" FontSize="12" Foreground="{StaticResource ChatOSPurpleBrush}" />
                                                </Border>
                                                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{x:Bind SenderLabel}" />
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind Content}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                            <ItemsControl ItemsSource="{x:Bind Attachments}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="domain:AgentMessageAttachment">
                                                        <Button Click="OnDownloadAttachmentClick" Content="{x:Bind Name}" Style="{StaticResource ChatOSSecondaryButtonStyle}" FontSize="11" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="{x:Bind TimestampLabel}" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <Border Grid.Row="3" Background="{StaticResource ChatOSBorderBrush}" />
                        <StackPanel Grid.Row="4" Padding="14" Spacing="8">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.PendingAttachments}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="domain:AgentMessageAttachment">
                                        <Button Click="OnRemoveAttachmentClick" Content="{x:Bind Name}" Style="{StaticResource ChatOSSecondaryButtonStyle}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Button Click="OnAddAttachmentClick" Style="{StaticResource ChatOSToolbarButtonStyle}" ToolTipService.ToolTip="添加附件"><FontIcon Glyph="&#xE723;" /></Button>
                                <TextBox Grid.Column="1" AcceptsReturn="True" MaxHeight="130" PlaceholderText="给 Agent 发消息…" Text="{x:Bind ViewModel.MessageText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" />
                                <Button Grid.Column="2" VerticalAlignment="Bottom" Click="OnSendClick" Content="发送" IsEnabled="{x:Bind ViewModel.HasRoom, Mode=OneWay}" Style="{StaticResource ChatOSPrimaryButtonStyle}" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
