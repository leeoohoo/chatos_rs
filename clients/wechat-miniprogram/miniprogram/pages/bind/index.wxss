.bind-page { display: flex; flex-direction: column; align-items: center; padding-top: 82rpx; }
.brand-mark { display: flex; width: 88rpx; height: 88rpx; align-items: center; justify-content: center; border-radius: 23rpx; background: linear-gradient(145deg,#168bff,#006edc); box-shadow: 0 12rpx 30rpx rgba(0,122,255,.20); color: #fff; font-size: 42rpx; font-weight: 700; }
.bind-page .large-title { margin-top: 28rpx; text-align: center; }
.subtitle { margin: 7rpx 0 38rpx; color: #76767c; font-size: 24rpx; }
.state-card { box-sizing: border-box; width: 100%; padding: 38rpx 28rpx; text-align: center; }
.state-title { margin-top: 17rpx; font-size: 30rpx; font-weight: 650; }
.state-copy { margin: 15rpx 0 28rpx; color: #6f6f75; font-size: 24rpx; line-height: 1.6; }
.waiting-symbol { display: flex; width: 66rpx; height: 66rpx; margin: 0 auto; align-items: center; justify-content: center; border-radius: 50%; background: #eaf8ee; color: #28a745; font-size: 34rpx; }
.spinner { box-sizing: border-box; width: 52rpx; height: 52rpx; margin: 0 auto; border: 5rpx solid #d9eaff; border-top-color: #0a84ff; border-radius: 50%; animation: spin .9s linear infinite; }
.error { margin: 18rpx 0; font-size: 23rpx; line-height: 1.5; }
.transient-state { margin-top: -8rpx; color: #8e8e93; font-size: 22rpx; line-height: 1.5; }
.development-card { box-sizing: border-box; width: 100%; text-align: left; }
.development-card .state-title { margin-top: 14rpx; }
.development-card .state-copy { margin-bottom: 22rpx; }
.development-badge { display: inline-flex; padding: 6rpx 12rpx; border-radius: 999rpx; background: #fff1cf; color: #805400; font-size: 19rpx; font-weight: 600; }
.development-input { box-sizing: border-box; width: 100%; height: 78rpx; margin-bottom: 15rpx; padding: 0 20rpx; border: 1rpx solid rgba(60,60,67,.12); border-radius: 16rpx; background: #f7f7f9; font-size: 26rpx; }
.development-error { margin: 3rpx 3rpx 16rpx; font-size: 22rpx; line-height: 1.5; }
.development-note { margin-top: 18rpx; color: #8e8e93; font-size: 20rpx; line-height: 1.5; text-align: center; }
.privacy { margin-top: auto; padding: 30rpx 24rpx; color: #8e8e93; font-size: 20rpx; line-height: 1.5; text-align: center; }
@keyframes spin { to { transform: rotate(360deg); } }
