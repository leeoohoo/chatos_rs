<view class="page">
  <view class="page-header">
    <view class="large-title">设备</view>
    <view class="page-caption">{{onlineCount}} 台在线 · 下拉即可刷新状态</view>
  </view>

  <view class="error-text error-card" wx:if="{{error}}" bindtap="loadDevices">{{error}}，轻触重试</view>
  <view class="card skeleton" wx:if="{{loading}}"></view>
  <empty-state wx:elif="{{devices.length === 0}}" title="没有已连接设备" description="请先在电脑上登录 ChatOS 并启动 Local Connector" />

  <view class="list-group" wx:if="{{!loading && devices.length}}">
    <view class="device" wx:for="{{devices}}" wx:key="id" data-id="{{item.id}}" bindtap="openDevice" hover-class="device-pressed">
      <view class="device-icon">⌘</view>
      <view class="device-main">
        <view class="device-heading">
          <view class="device-name">{{item.display_name}}</view>
          <view class="status-dot {{item.is_online ? 'online' : ''}}"></view>
        </view>
        <view class="muted device-meta">{{item.os || '未知系统'}} · {{item.is_online ? '现在在线' : item.lastSeenLabel}}</view>
        <view class="version" wx:if="{{item.client_version}}">ChatOS {{item.client_version}}</view>
      </view>
      <view class="opening" wx:if="{{openingDeviceId === item.id}}">•••</view>
      <view class="chevron" wx:else>›</view>
    </view>
  </view>
</view>
