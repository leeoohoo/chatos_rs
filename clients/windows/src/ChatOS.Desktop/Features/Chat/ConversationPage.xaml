<UserControl
    x:Class="ChatOS.Desktop.Features.Chat.ConversationPage"
    x:Name="ConversationRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:chat="using:ChatOS.Presentation.Chat"
    xmlns:chatControls="using:ChatOS.Desktop.Features.Chat"
    xmlns:core="using:ChatOS.Core.Domain"
    xmlns:designSystem="using:ChatOS.Desktop.DesignSystem"
    xmlns:tasks="using:ChatOS.Presentation.Tasks"
    mc:Ignorable="d"
    SizeChanged="OnConversationPageSizeChanged">

    <UserControl.Resources>
        <DataTemplate x:Key="GuidanceMessageTemplate" x:DataType="chat:ConversationUserMessageItemViewModel">
            <StackPanel
                MaxWidth="760"
                Margin="0,4,0,4"
                HorizontalAlignment="Left"
                AutomationProperties.AutomationId="{x:Bind GuidanceAutomationId}"
                AutomationProperties.Name="{x:Bind Text}"
                Orientation="Horizontal"
                Spacing="10">
                <FontIcon Glyph="&#xE77B;" FontSize="19" Foreground="{StaticResource ChatOSSecondaryTextBrush}" />
                <Border Padding="13" Background="{StaticResource ChatOSUserBubbleBrush}" BorderBrush="#292F6FED" BorderThickness="1" CornerRadius="12">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="你" Style="{StaticResource ChatOSBodyStrongTextStyle}" />
                            <TextBlock Text="{x:Bind TimeLabel}" Foreground="{StaticResource ChatOSTertiaryTextBrush}" Style="{StaticResource ChatOSCaptionTextStyle}" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Style="{StaticResource ChatOSSecondaryBodyTextStyle}" Foreground="{StaticResource ChatOSPrimaryTextBrush}" />
                        <ItemsControl ItemsSource="{x:Bind Attachments}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="chat:ConversationAttachmentItemViewModel">
                                    <StackPanel Margin="0,2">
                                        <Button Padding="0" HorizontalAlignment="Left" Background="Transparent" BorderThickness="0" Click="OnPreviewHistoryAttachmentClicked" ToolTipService.ToolTip="{x:Bind Name}" Visibility="{x:Bind HasImagePreview, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Border BorderBrush="{StaticResource ChatOSBorderBrush}" BorderThickness="1" CornerRadius="10">
                                                <designSystem:ConversationAttachmentReferenceThumbnail Width="300" Height="180" Attachment="{x:Bind Attachment}" />
                                            </Border>
                                        </Button>
                                        <Border Padding="9,7" Background="#22FFFFFF" CornerRadius="8" Visibility="{x:Bind IsFileChip, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <FontIcon Glyph="&#xE8A5;" FontSize="13" Foreground="{StaticResource ChatOSPurpleBrush}" />
                                                <StackPanel Spacing="1">
                                                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                                    <TextBlock Text="{x:Bind SizeLabel}" Foreground="{StaticResource ChatOSTertiaryTextBrush}" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="AssistantReplyTemplate" x:DataType="chat:ConversationReplyItemViewModel">
            <StackPanel
                MaxWidth="820"
                Margin="0,2,44,0"
                HorizontalAlignment="Left"
                AutomationProperties.AutomationId="{x:Bind AssistantAutomationId}"
                AutomationProperties.HelpText="{x:Bind AutomationStatus}"
                AutomationProperties.Name="{x:Bind Text}"
                Orientation="Horizontal"
                Spacing="10">
                <FontIcon Glyph="&#xE945;" FontSize="18" Foreground="{StaticResource ChatOSPurpleBrush}" />
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="叽咕狸" Style="{StaticResource ChatOSBodyStrongTextStyle}" />
                        <TextBlock Text="{x:Bind TimeLabel}" Foreground="{StaticResource ChatOSTertiaryTextBrush}" Style="{StaticResource ChatOSCaptionTextStyle}" />
                        <Border Padding="7,2" Background="{StaticResource ChatOSProcessBackgroundBrush}" CornerRadius="8" Visibility="{x:Bind IsTaskCallback, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{x:Bind TaskStatus}" Foreground="{StaticResource ChatOSPurpleBrush}" Style="{StaticResource ChatOSCaptionTextStyle}" />
                        </Border>
                    </StackPanel>
                    <designSystem:MarkdownRichTextBlock Markdown="{x:Bind Text}" />
                    <StackPanel
                        HorizontalAlignment="Left"
                        Orientation="Horizontal"
                        Spacing="10"
                        Visibility="{x:Bind IsTaskCallback, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Button Click="OnTaskCallbackClicked" Style="{StaticResource ChatOSSecondaryButtonStyle}" Tag="Process">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE9D9;" FontSize="12" Foreground="{StaticResource ChatOSPurpleBrush}" />
                                <TextBlock Text="{Binding ExecutionProcess, Source={StaticResource ChatOSLocalization}}" Style="{StaticResource ChatOSCaptionTextStyle}" />
                            </StackPanel>
                        </Button>
                        <Button Click="OnTaskCallbackClicked" Style="{StaticResource ChatOSSecondaryButtonStyle}" Tag="Detail">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8A5;" FontSize="12" Foreground="{StaticResource ChatOSPurpleBrush}" />
                                <TextBlock Text="{Binding TaskDetails, Source={StaticResource ChatOSLocalization}}" Style="{StaticResource ChatOSCaptionTextStyle}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <Border
                        MaxWidth="760"
                        Padding="14"
                        Background="{StaticResource ChatOSProcessBackgroundBrush}"
                        BorderBrush="{StaticResource ChatOSBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Visibility="{x:Bind HasInspector, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Spacing="10">
                            <ProgressRing
                                Width="22"
                                Height="22"
                                HorizontalAlignment="Left"
                                IsActive="{x:Bind IsInspectorLoading, Mode=OneWay}"
                                Visibility="{x:Bind IsInspectorLoading, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <TextBlock
                                Text="{x:Bind InspectorError, Mode=OneWay}"
                                TextWrapping="Wrap"
                                Foreground="{StaticResource ChatOSFailureBrush}"
                                Style="{StaticResource ChatOSCaptionTextStyle}"
                                Visibility="{x:Bind InspectorError, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />
                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{x:Bind InspectorTask.Title, Mode=OneWay}" TextWrapping="Wrap" Style="{StaticResource ChatOSHeadlineTextStyle}" />
                                    <TextBlock Text="{x:Bind InspectorTask.Status, Mode=OneWay}" Foreground="{StaticResource ChatOSPurpleBrush}" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind InspectorTask.Objective, Mode=OneWay}" TextWrapping="Wrap" Style="{StaticResource ChatOSSecondaryBodyTextStyle}" />
                            </StackPanel>
                            <StackPanel Spacing="7" Visibility="{x:Bind IsProcessExpanded, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <designSystem:MarkdownRichTextBlock Markdown="{x:Bind InspectorTask.ProcessLog, Mode=OneWay}" />
                                <ItemsControl ItemsSource="{x:Bind InspectorRun.Events, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="core:MessageTaskRunEvent">
                                            <Border Margin="0,2" Padding="9" Background="#14FFFFFF" CornerRadius="7">
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="{x:Bind EventType}" Style="{StaticResource ChatOSBodyStrongTextStyle}" />
                                                    <TextBlock Text="{x:Bind Message}" TextWrapping="Wrap" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <StackPanel Spacing="7" Visibility="{x:Bind IsDetailExpanded, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{x:Bind InspectorTask.Description, Mode=OneWay}" TextWrapping="Wrap" Style="{StaticResource ChatOSSecondaryBodyTextStyle}" />
                                <TextBlock Text="{x:Bind InspectorTask.ResultSummary, Mode=OneWay}" TextWrapping="Wrap" Style="{StaticResource ChatOSBodyStrongTextStyle}" />
                                <designSystem:MarkdownRichTextBlock Markdown="{x:Bind InspectorRun.Run.ReportContent, Mode=OneWay}" />
                                <TextBlock Text="{x:Bind InspectorRun.Run.ErrorMessage, Mode=OneWay}" TextWrapping="Wrap" Foreground="{StaticResource ChatOSFailureBrush}" Style="{StaticResource ChatOSCaptionTextStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </DataTemplate>
        <chatControls:ConversationMessageTemplateSelector x:Key="ConversationMessageTemplates" UserTemplate="{StaticResource GuidanceMessageTemplate}" ReplyTemplate="{StaticResource AssistantReplyTemplate}" />
    </UserControl.Resources>

    <Grid
        AutomationProperties.AutomationId="ChatOS.Chat.Root"
        AutomationProperties.HelpText="{x:Bind ViewModel.AutomationIdentity, Mode=OneWay}"
        AutomationProperties.ItemStatus="{x:Bind ViewModel.AutomationStatus, Mode=OneWay}"
        AutomationProperties.Name="ChatOS conversation"
        Background="{StaticResource ChatOSContentBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="1" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="18,0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center" Spacing="1">
                <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" Style="{StaticResource ChatOSHeadlineTextStyle}" />
                <TextBlock
                    Text="{x:Bind Localization.RunningGuidanceAvailable, Mode=OneWay}"
                    Foreground="{StaticResource ChatOSPurpleBrush}"
                    Style="{StaticResource ChatOSCaptionTextStyle}"
                    Visibility="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>

            <Button
                AutomationProperties.AutomationId="ChatOS.Chat.Refresh"
                AutomationProperties.Name="{x:Bind Localization.RefreshConversation, Mode=OneWay}"
                Grid.Column="1"
                Command="{x:Bind ViewModel.RefreshLatestCommand}"
                Style="{StaticResource ChatOSToolbarButtonStyle}"
                ToolTipService.ToolTip="{x:Bind Localization.RefreshConversation, Mode=OneWay}">
                <FontIcon Glyph="&#xE72C;" />
            </Button>
        </Grid>

        <Border Grid.Row="1" Background="{StaticResource ChatOSBorderBrush}" />

        <Border
            AutomationProperties.AutomationId="ChatOS.Chat.PluginInstallerBoundary"
            AutomationProperties.Name="Plugin installer capability boundary"
            Grid.Row="2"
            Margin="20,12,20,0"
            Padding="12,9"
            Background="{StaticResource ChatOSProcessBackgroundBrush}"
            BorderBrush="{StaticResource ChatOSBorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Visibility="{x:Bind ViewModel.IsPluginInstaller, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal" Spacing="9">
                <FontIcon Glyph="&#xE72E;" Foreground="{StaticResource ChatOSPurpleBrush}" />
                <TextBlock
                    MaxWidth="780"
                    Text="{x:Bind ViewModel.PluginInstallerBoundaryText, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Style="{StaticResource ChatOSCaptionTextStyle}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border
                AutomationProperties.AutomationId="ChatOS.Chat.LiveProcesses"
                Grid.Row="0"
                Margin="20,12,20,0"
                Padding="12"
                Background="{StaticResource ChatOSProcessBackgroundBrush}"
                CornerRadius="10"
                Visibility="{x:Bind ViewModel.HasLiveProcesses, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Spacing="8">
                    <TextBlock Text="{x:Bind Localization.AiExecutionProcess, Mode=OneWay}" Style="{StaticResource ChatOSBodyStrongTextStyle}" Foreground="{StaticResource ChatOSPurpleBrush}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.LiveProcesses}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="chat:TurnProcessItemViewModel">
                                <Grid
                                    Margin="0,2"
                                    AutomationProperties.AutomationId="{x:Bind LiveAutomationId}"
                                    AutomationProperties.ItemStatus="{x:Bind Status}"
                                    AutomationProperties.Name="{x:Bind Title}"
                                    ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ProgressRing Width="14" Height="14" IsActive="True" />
                                    <StackPanel Grid.Column="1" Spacing="1">
                                        <TextBlock Text="{x:Bind Title}" Style="{StaticResource ChatOSBodyStrongTextStyle}" />
                                        <TextBlock Text="{x:Bind Detail}" Style="{StaticResource ChatOSCaptionTextStyle}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <ListView
                x:Name="TimelineList"
                AutomationProperties.AutomationId="ChatOS.Chat.Timeline"
                Grid.Row="1"
                Padding="24,18,24,18"
                HorizontalContentAlignment="Stretch"
                ItemsSource="{x:Bind ViewModel.Turns}"
                SelectionMode="None">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,18" />
                        <Setter Property="IsTabStop" Value="False" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="chat:ConversationTurnItemViewModel">
                        <StackPanel
                            AutomationProperties.AutomationId="{x:Bind AutomationId}"
                            AutomationProperties.ItemStatus="{x:Bind AutomationStatus}"
                            Spacing="10">
                            <StackPanel
                                MaxWidth="760"
                                HorizontalAlignment="Left"
                                AutomationProperties.AutomationId="{x:Bind UserMessageAutomationId}"
                                AutomationProperties.Name="{x:Bind UserText}"
                                Orientation="Horizontal"
                                Spacing="10">
                                <FontIcon Glyph="&#xE77B;" FontSize="19" Foreground="{StaticResource ChatOSSecondaryTextBrush}" />
                                <Border Padding="13" Background="{StaticResource ChatOSUserBubbleBrush}" BorderBrush="#292F6FED" BorderThickness="1" CornerRadius="12">
                                    <StackPanel Spacing="8">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="你" Style="{StaticResource ChatOSBodyStrongTextStyle}" />
                                            <TextBlock Text="{x:Bind UserTimeLabel}" Foreground="{StaticResource ChatOSTertiaryTextBrush}" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind UserText}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Style="{StaticResource ChatOSSecondaryBodyTextStyle}" Foreground="{StaticResource ChatOSPrimaryTextBrush}" />
                                         <ItemsControl ItemsSource="{x:Bind Attachments}">
                                             <ItemsControl.ItemTemplate>
                                                 <DataTemplate x:DataType="chat:ConversationAttachmentItemViewModel">
                                                     <StackPanel Margin="0,2">
                                                         <Button
                                                             Padding="0"
                                                             HorizontalAlignment="Left"
                                                             Background="Transparent"
                                                             BorderThickness="0"
                                                             Click="OnPreviewHistoryAttachmentClicked"
                                                             ToolTipService.ToolTip="{x:Bind Name}"
                                                             Visibility="{x:Bind HasImagePreview, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                             <Border BorderBrush="{StaticResource ChatOSBorderBrush}" BorderThickness="1" CornerRadius="10">
                                                                 <designSystem:ConversationAttachmentReferenceThumbnail Width="300" Height="180" Attachment="{x:Bind Attachment}" />
                                                             </Border>
                                                         </Button>
                                                         <Border
                                                             Padding="9,7"
                                                             Background="#22FFFFFF"
                                                             CornerRadius="8"
                                                             Visibility="{x:Bind IsFileChip, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                             <StackPanel Orientation="Horizontal" Spacing="7">
                                                                 <FontIcon Glyph="&#xE8A5;" FontSize="13" Foreground="{StaticResource ChatOSPurpleBrush}" />
                                                                 <StackPanel Spacing="1">
                                                                     <TextBlock Text="{x:Bind Name}" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                                                     <TextBlock Text="{x:Bind SizeLabel}" Foreground="{StaticResource ChatOSTertiaryTextBrush}" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                                                 </StackPanel>
                                                             </StackPanel>
                                                         </Border>
                                                     </StackPanel>
                                                 </DataTemplate>
                                             </ItemsControl.ItemTemplate>
                                         </ItemsControl>
                                         <StackPanel Orientation="Horizontal" Spacing="8">
                                             <Button
                                                 AutomationProperties.AutomationId="{x:Bind ProcessToggleAutomationId}"
                                                 AutomationProperties.Name="{Binding ViewProcess, Source={StaticResource ChatOSLocalization}}"
                                                 Command="{x:Bind ToggleProcessCommand}"
                                                 Content="{Binding ViewProcess, Source={StaticResource ChatOSLocalization}}"
                                                 Style="{StaticResource ChatOSSecondaryButtonStyle}"
                                                 Visibility="{x:Bind HasProcessEvents, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                             <Button
                                                 AutomationProperties.AutomationId="{x:Bind TaskGraphAutomationId}"
                                                 AutomationProperties.Name="{Binding TaskGraphLabel, Source={StaticResource ChatOSLocalization}}"
                                                 Click="OnTurnTaskGraphClicked"
                                                 Content="{Binding TaskGraphLabel, Source={StaticResource ChatOSLocalization}}"
                                                 Style="{StaticResource ChatOSSecondaryButtonStyle}"
                                                 Visibility="{x:Bind IsTaskGraphAvailable, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                         </StackPanel>
                                     </StackPanel>
                                 </Border>
                             </StackPanel>

                             <ItemsControl
                                 ItemsSource="{x:Bind ProcessEvents}"
                                 Visibility="{x:Bind IsProcessExpanded, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="chat:TurnProcessItemViewModel">
                                        <Border
                                            Margin="28,0,0,0"
                                            Padding="10"
                                            AutomationProperties.AutomationId="{x:Bind HistoryAutomationId}"
                                            AutomationProperties.ItemStatus="{x:Bind Status}"
                                            AutomationProperties.Name="{x:Bind Title}"
                                            Background="{StaticResource ChatOSProcessBackgroundBrush}"
                                            CornerRadius="8">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{x:Bind Title}" Style="{StaticResource ChatOSBodyStrongTextStyle}" />
                                                <TextBlock Text="{x:Bind Detail}" Style="{StaticResource ChatOSCaptionTextStyle}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{x:Bind TimelineMessages}" ItemTemplateSelector="{StaticResource ConversationMessageTemplates}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel
                AutomationProperties.AutomationId="ChatOS.Chat.Empty"
                Grid.Row="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8"
                Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <FontIcon Glyph="&#xE8F2;" FontSize="34" Foreground="{StaticResource ChatOSTertiaryTextBrush}" />
                <TextBlock Text="{x:Bind Localization.StartNewConversation, Mode=OneWay}" Style="{StaticResource ChatOSHeadlineTextStyle}" />
                <TextBlock Text="{x:Bind Localization.NoConversationMessages, Mode=OneWay}" Style="{StaticResource ChatOSCaptionTextStyle}" />
            </StackPanel>

            <Button
                Grid.Row="2"
                Margin="0,0,0,10"
                HorizontalAlignment="Center"
                Click="OnUnreadNewerClicked"
                Content="{x:Bind ViewModel.UnreadNewerLabel, Mode=OneWay}"
                Style="{StaticResource ChatOSPrimaryButtonStyle}"
                Visibility="{x:Bind ViewModel.HasUnreadNewer, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </Grid>

        <StackPanel Grid.Row="4">
            <ItemsControl
                Margin="20,0,20,10"
                ItemsSource="{x:Bind ViewModel.PendingPrompts}"
                Visibility="{x:Bind ViewModel.HasPendingPrompts, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="chat:AskUserPromptViewModel">
                        <Border
                            Margin="0,4"
                            Padding="18"
                            Width="760"
                            MaxWidth="760"
                            HorizontalAlignment="Left"
                            AutomationProperties.AutomationId="{x:Bind PromptAutomationId}"
                            AutomationProperties.Name="{x:Bind Title}"
                            BorderBrush="{StaticResource ChatOSPurpleBrush}"
                            CornerRadius="16"
                            Style="{StaticResource ChatOSCardStyle}">
                            <StackPanel Spacing="10">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="{x:Bind Title, Mode=OneWay}" Style="{StaticResource ChatOSHeadlineTextStyle}" />
                                        <TextBlock Text="{x:Bind WaitingLabel, Mode=OneWay}" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                    </StackPanel>
                                    <Border
                                        Grid.Column="1"
                                        Padding="10,4"
                                        VerticalAlignment="Top"
                                        Background="{StaticResource ChatOSPurpleSoftBrush}"
                                        CornerRadius="10">
                                        <TextBlock Foreground="{StaticResource ChatOSPurpleBrush}" Text="{x:Bind PendingLabel, Mode=OneWay}" />
                                    </Border>
                                </Grid>

                                <TextBlock Text="{x:Bind Message, Mode=OneWay}" TextWrapping="Wrap" Style="{StaticResource ChatOSSecondaryBodyTextStyle}" />

                                <ItemsControl ItemsSource="{x:Bind Fields}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="chat:AskUserFieldInputViewModel">
                                            <StackPanel Margin="0,3" Spacing="4">
                                                <StackPanel Orientation="Horizontal" Spacing="3">
                                                    <TextBlock Text="{x:Bind Label}" Style="{StaticResource ChatOSBodyStrongTextStyle}" />
                                                    <TextBlock
                                                        Foreground="{StaticResource ChatOSFailureBrush}"
                                                        Text="*"
                                                        Visibility="{x:Bind IsRequired, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                </StackPanel>
                                                <TextBlock Text="{x:Bind Description}" Style="{StaticResource ChatOSCaptionTextStyle}" TextWrapping="Wrap" />
                                                <TextBox
                                                    AcceptsReturn="{x:Bind IsMultiline}"
                                                    AutomationProperties.AutomationId="{x:Bind TextAutomationId}"
                                                    AutomationProperties.Name="{x:Bind Label}"
                                                    MinHeight="{x:Bind InputMinHeight}"
                                                    PlaceholderText="{x:Bind Placeholder}"
                                                    Text="{x:Bind Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    TextWrapping="Wrap"
                                                    Visibility="{x:Bind IsSecret, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                                <PasswordBox
                                                    AutomationProperties.AutomationId="{x:Bind SecretAutomationId}"
                                                    AutomationProperties.Name="{x:Bind Label}"
                                                    Password="{x:Bind Value, Mode=OneWay}"
                                                    PasswordChanged="OnAskUserSecretChanged"
                                                    PlaceholderText="{x:Bind Placeholder}"
                                                    Visibility="{x:Bind IsSecret, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <StackPanel Spacing="6" Visibility="{x:Bind HasChoice, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{x:Bind ChoiceLabel, Mode=OneWay}" Style="{StaticResource ChatOSBodyStrongTextStyle}" />
                                        <TextBlock Text="{x:Bind ChoiceHint, Mode=OneWay}" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                    </StackPanel>
                                    <ComboBox
                                        AutomationProperties.AutomationId="ChatOS.Chat.AskUser.SingleChoice"
                                        AutomationProperties.Name="{x:Bind ChoiceLabel, Mode=OneWay}"
                                        DisplayMemberPath="Label"
                                        ItemsSource="{x:Bind Options}"
                                        SelectedItem="{x:Bind SelectedSingleOption, Mode=TwoWay}"
                                        Visibility="{x:Bind IsSingleChoice, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                    <ItemsControl
                                        ItemsSource="{x:Bind Options}"
                                        Visibility="{x:Bind AllowsMultiple, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="chat:AskUserChoiceOptionViewModel">
                                                <CheckBox
                                                    AutomationProperties.AutomationId="{x:Bind OptionAutomationId}"
                                                    AutomationProperties.Name="{x:Bind Label}"
                                                    IsChecked="{x:Bind IsSelected, Mode=TwoWay}">
                                                    <StackPanel>
                                                        <TextBlock Text="{x:Bind Label}" Style="{StaticResource ChatOSBodyStrongTextStyle}" />
                                                        <TextBlock Text="{x:Bind Description}" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                                    </StackPanel>
                                                </CheckBox>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <TextBlock
                                    Text="{x:Bind ErrorMessage, Mode=OneWay}"
                                    Foreground="{StaticResource ChatOSFailureBrush}"
                                    Style="{StaticResource ChatOSCaptionTextStyle}"
                                    Visibility="{x:Bind ErrorMessage, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />

                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                                    <ProgressRing Width="20" Height="20" IsActive="{x:Bind IsSubmitting, Mode=OneWay}" Visibility="{x:Bind IsSubmitting, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <Button
                                        AutomationProperties.AutomationId="ChatOS.Chat.AskUser.Cancel"
                                        AutomationProperties.Name="{x:Bind CancelLabel, Mode=OneWay}"
                                        Command="{x:Bind CancelCommand}"
                                        Content="{x:Bind CancelLabel, Mode=OneWay}"
                                        Style="{StaticResource ChatOSSecondaryButtonStyle}"
                                        Visibility="{x:Bind AllowsCancel, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <Button
                                        AutomationProperties.AutomationId="ChatOS.Chat.AskUser.Submit"
                                        AutomationProperties.Name="{x:Bind SubmitLabel, Mode=OneWay}"
                                        Command="{x:Bind SubmitCommand}"
                                        Content="{x:Bind SubmitLabel, Mode=OneWay}"
                                        Style="{StaticResource ChatOSPrimaryButtonStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock
                AutomationProperties.AutomationId="ChatOS.Chat.Error"
                AutomationProperties.Name="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Margin="20,0,20,8"
                Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Foreground="{StaticResource ChatOSFailureBrush}"
                Style="{StaticResource ChatOSCaptionTextStyle}"
                Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />

            <TextBlock
                AutomationProperties.AutomationId="ChatOS.Chat.AttachmentError"
                AutomationProperties.Name="{x:Bind ViewModel.AttachmentError, Mode=OneWay}"
                Margin="20,0,20,8"
                Text="{x:Bind ViewModel.AttachmentError, Mode=OneWay}"
                Foreground="{StaticResource ChatOSFailureBrush}"
                Style="{StaticResource ChatOSCaptionTextStyle}"
                Visibility="{x:Bind ViewModel.AttachmentError, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />

            <Border
                AutomationProperties.AutomationId="ChatOS.Chat.ComposerSurface"
                Margin="16,0,16,16"
                Padding="10"
                AllowDrop="True"
                DragOver="OnComposerDragOver"
                Drop="OnComposerDrop"
                Style="{StaticResource ChatOSCardStyle}">
                <StackPanel Spacing="8">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ComboBox
                            x:Name="ModelPicker"
                            AutomationProperties.AutomationId="ChatOS.Chat.ModelPicker"
                            AutomationProperties.Name="{x:Bind Localization.Models, Mode=OneWay}"
                            MinWidth="150"
                            DisplayMemberPath="DisplayName"
                            ItemsSource="{x:Bind ViewModel.Models}"
                            SelectedItem="{x:Bind ViewModel.SelectedModel, Mode=OneWay}"
                            SelectionChanged="OnModelSelectionChanged" />
                        <ComboBox
                            AutomationProperties.AutomationId="ChatOS.Chat.RemotePicker"
                            AutomationProperties.Name="{x:Bind Localization.ConversationRemote, Mode=OneWay}"
                            Grid.Column="1"
                            MinWidth="140"
                            DisplayMemberPath="DisplayName"
                            ItemsSource="{x:Bind ViewModel.RemoteConnections}"
                            SelectedItem="{x:Bind ViewModel.SelectedRemoteConnection, Mode=OneWay}"
                            SelectionChanged="OnRemoteSelectionChanged" />
                        <ToggleSwitch
                            AutomationProperties.AutomationId="ChatOS.Chat.Reasoning"
                            AutomationProperties.Name="{x:Bind Localization.ReasoningOn, Mode=OneWay}"
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            OffContent="{x:Bind Localization.ReasoningOff, Mode=OneWay}"
                            OnContent="{x:Bind Localization.ReasoningOn, Mode=OneWay}"
                            IsOn="{x:Bind ViewModel.ReasoningEnabled, Mode=OneWay}"
                            Toggled="OnReasoningToggled" />
                        <ComboBox
                            x:Name="ReasoningLevelPicker"
                            AutomationProperties.AutomationId="ChatOS.Chat.ReasoningLevel"
                            AutomationProperties.Name="Reasoning level"
                            Grid.Column="3"
                            HorizontalAlignment="Left"
                            MinWidth="120"
                            ItemsSource="{x:Bind ViewModel.ReasoningLevels}"
                            SelectedItem="{x:Bind ViewModel.SelectedThinkingLevel, Mode=OneWay}"
                            SelectionChanged="OnReasoningLevelSelectionChanged"
                            Visibility="{x:Bind ViewModel.HasReasoningLevels, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>
                    <ComboBox
                        AutomationProperties.AutomationId="ChatOS.Chat.CapabilityPicker"
                        AutomationProperties.Name="{x:Bind ViewModel.CapabilityPickerLabel, Mode=OneWay}"
                        Header="{x:Bind ViewModel.CapabilityPickerLabel, Mode=OneWay}"
                        HorizontalAlignment="Left"
                        MinWidth="240"
                        DisplayMemberPath="DisplayName"
                        ItemsSource="{x:Bind ViewModel.Capabilities}"
                        SelectedItem="{x:Bind ViewModel.SelectedCapability, Mode=TwoWay}"
                        Visibility="{x:Bind ViewModel.HasCapabilityOptions, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Grid Visibility="{x:Bind ViewModel.HasAttachments, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{x:Bind ViewModel.AttachmentTotalSizeLabel, Mode=OneWay}" Style="{StaticResource ChatOSCaptionTextStyle}" />
                        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Attachments}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="6" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                     <DataTemplate x:DataType="core:ConversationAttachmentDraft">
                                         <Border Padding="8,5" Background="{StaticResource ChatOSProcessBackgroundBrush}" CornerRadius="7">
                                             <Grid ColumnSpacing="5">
                                                 <Grid.ColumnDefinitions>
                                                     <ColumnDefinition Width="Auto" />
                                                     <ColumnDefinition Width="Auto" />
                                                 </Grid.ColumnDefinitions>
                                                 <Button
                                                     Padding="0"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     AutomationProperties.Name="{x:Bind Name}"
                                                     Click="OnPreviewAttachmentClicked">
                                                     <StackPanel Orientation="Horizontal" Spacing="7">
                                                         <designSystem:ConversationAttachmentThumbnail Width="32" Height="32" Attachment="{Binding}" />
                                                         <StackPanel MaxWidth="220" VerticalAlignment="Center" Spacing="1">
                                                             <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                                             <TextBlock Text="{x:Bind MimeType}" TextTrimming="CharacterEllipsis" Style="{StaticResource ChatOSCaptionTextStyle}" Foreground="{StaticResource ChatOSTertiaryTextBrush}" />
                                                         </StackPanel>
                                                     </StackPanel>
                                                 </Button>
                                                 <Button Grid.Column="1" AutomationProperties.Name="{Binding RemoveAttachment, Source={StaticResource ChatOSLocalization}}" Click="OnRemoveAttachmentClicked" Style="{StaticResource ChatOSToolbarButtonStyle}" ToolTipService.ToolTip="{Binding RemoveAttachment, Source={StaticResource ChatOSLocalization}}">
                                                     <FontIcon Glyph="&#xE711;" FontSize="10" />
                                                 </Button>
                                             </Grid>
                                         </Border>
                                     </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button AutomationProperties.AutomationId="ChatOS.Chat.AddAttachment" AutomationProperties.Name="{x:Bind Localization.AddAttachment, Mode=OneWay}" Click="OnAddAttachmentClicked" Style="{StaticResource ChatOSToolbarButtonStyle}" ToolTipService.ToolTip="{x:Bind Localization.AddAttachment, Mode=OneWay}">
                            <FontIcon Glyph="&#xE723;" />
                        </Button>

                        <TextBox
                            x:Name="ComposerTextBox"
                            AutomationProperties.AutomationId="ChatOS.Chat.Composer"
                            AutomationProperties.Name="{x:Bind Localization.MessageComposerPlaceholder, Mode=OneWay}"
                            Grid.Column="3"
                            MinHeight="38"
                            MaxHeight="160"
                            AcceptsReturn="True"
                            BorderThickness="0"
                            Header=""
                            Paste="OnComposerPaste"
                            PreviewKeyDown="OnComposerPreviewKeyDown"
                            PlaceholderText="{x:Bind Localization.MessageComposerPlaceholder, Mode=OneWay}"
                            Text="{x:Bind ViewModel.Draft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            TextWrapping="Wrap" />

                        <Button
                            AutomationProperties.AutomationId="ChatOS.Chat.Stop"
                            Grid.Column="1"
                            Command="{x:Bind ViewModel.StopCommand}"
                            Content="{x:Bind Localization.Cancel, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />

                         <Button
                             AutomationProperties.AutomationId="ChatOS.Chat.Send"
                             AutomationProperties.Name="{x:Bind Localization.Send, Mode=OneWay}"
                             Grid.Column="2"
                             Width="34"
                             Height="34"
                             Padding="0"
                             Command="{x:Bind ViewModel.SendCommand}"
                             IsEnabled="{x:Bind ViewModel.CanSendDraft, Mode=OneWay}"
                             CornerRadius="17"
                             Style="{StaticResource ChatOSPrimaryButtonStyle}"
                             ToolTipService.ToolTip="{x:Bind Localization.Send, Mode=OneWay}">
                             <TextBlock FontSize="19" FontWeight="SemiBold" Text="↑" />
                         </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>

        <Grid
            AutomationProperties.AutomationId="ChatOS.Chat.TaskDetail"
            Grid.RowSpan="4"
            Background="{StaticResource ChatOSContentBackgroundBrush}"
            Visibility="{x:Bind ViewModel.IsOpen, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                <FontIcon Glyph="&#xE8F2;" FontSize="38" Foreground="{StaticResource ChatOSTertiaryTextBrush}" />
                <TextBlock Text="{x:Bind Localization.NoAvailableConversation, Mode=OneWay}" Style="{StaticResource ChatOSHeadlineTextStyle}" />
                <TextBlock Text="{x:Bind Localization.ConversationPreparationNotice, Mode=OneWay}" Style="{StaticResource ChatOSCaptionTextStyle}" />
            </StackPanel>
        </Grid>

        <Grid
            Grid.RowSpan="4"
            Background="#66FBFBFC"
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ProgressRing Width="32" Height="32" IsActive="True" />
        </Grid>

        <Grid
            x:Name="TaskGraphOverlay"
            Grid.RowSpan="4"
            Background="#33000000"
            Visibility="{x:Bind TaskGraph.IsOpen, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border
                x:Name="TaskGraphWorkspace"
                HorizontalAlignment="Right"
                AutomationProperties.AutomationId="ChatOS.Chat.TaskGraph.Workspace"
                Background="{StaticResource ChatOSContentBackgroundBrush}"
                BorderBrush="{StaticResource ChatOSBorderBrush}"
                BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="52" />
                        <RowDefinition Height="1" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Padding="16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="{x:Bind Localization.TaskDetails, Mode=OneWay}" Style="{StaticResource ChatOSHeadlineTextStyle}" />
                            <TextBlock Text="{x:Bind Localization.AuthoritativeTaskStatus, Mode=OneWay}" Style="{StaticResource ChatOSCaptionTextStyle}" />
                        </StackPanel>
                        <Button Grid.Column="1"
                            AutomationProperties.AutomationId="ChatOS.Chat.TaskGraph.Refresh"
                            AutomationProperties.Name="{x:Bind Localization.Refresh, Mode=OneWay}"
                            Command="{x:Bind TaskGraph.RefreshCommand}" Style="{StaticResource ChatOSToolbarButtonStyle}">
                            <FontIcon Glyph="&#xE72C;" />
                        </Button>
                        <Button Grid.Column="2"
                            AutomationProperties.AutomationId="ChatOS.Chat.TaskGraph.Close"
                            AutomationProperties.Name="{x:Bind Localization.Close, Mode=OneWay}"
                            Command="{x:Bind TaskGraph.CloseCommand}" Style="{StaticResource ChatOSToolbarButtonStyle}">
                            <FontIcon Glyph="&#xE711;" />
                        </Button>
                    </Grid>

                    <Border Grid.Row="1" Background="{StaticResource ChatOSBorderBrush}" />

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="TaskGraphNodeColumn" Width="220" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid
                            x:Name="TaskGraphCanvasHost"
                            AutomationProperties.AutomationId="ChatOS.Chat.TaskGraph.CanvasHost"
                            AutomationProperties.Name="{x:Bind Localization.TaskGraphLabel, Mode=OneWay}">
                            <ScrollViewer
                                x:Name="TaskGraphCanvasViewport"
                                AutomationProperties.AutomationId="ChatOS.Chat.TaskGraph.CanvasViewport"
                                HorizontalScrollBarVisibility="Auto"
                                HorizontalScrollMode="Enabled"
                                VerticalScrollBarVisibility="Auto"
                                VerticalScrollMode="Enabled"
                                ZoomMode="Enabled"
                                MinZoomFactor="0.25"
                                MaxZoomFactor="2"
                                ViewChanged="OnTaskGraphCanvasViewChanged">
                                <Canvas
                                    x:Name="TaskGraphCanvas"
                                    Width="800"
                                    Height="520"
                                    Background="{StaticResource ChatOSSurfaceSubtleBrush}"
                                    AutomationProperties.AutomationId="ChatOS.Chat.TaskGraph.Canvas" />
                            </ScrollViewer>

                            <Border
                                Margin="10"
                                Padding="5"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Background="{StaticResource ChatOSContentBackgroundBrush}"
                                BorderBrush="{StaticResource ChatOSBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <Button
                                        AutomationProperties.AutomationId="ChatOS.Chat.TaskGraph.ZoomOut"
                                        Click="OnTaskGraphZoomOutClicked"
                                        Content="&#x2212;" />
                                    <Button
                                        x:Name="TaskGraphZoomLabel"
                                        MinWidth="58"
                                        AutomationProperties.AutomationId="ChatOS.Chat.TaskGraph.ZoomReset"
                                        Click="OnTaskGraphZoomResetClicked"
                                        Content="100%" />
                                    <Button
                                        AutomationProperties.AutomationId="ChatOS.Chat.TaskGraph.ZoomIn"
                                        Click="OnTaskGraphZoomInClicked"
                                        Content="+" />
                                    <Button
                                        Width="24"
                                        Padding="0"
                                        AutomationProperties.AutomationId="ChatOS.Chat.TaskGraph.Center"
                                        Click="OnTaskGraphCenterClicked">
                                        <FontIcon Glyph="&#xE8B0;" />
                                    </Button>
                                    <Button
                                        Width="24"
                                        Padding="0"
                                        AutomationProperties.AutomationId="ChatOS.Chat.TaskGraph.Fit"
                                        Click="OnTaskGraphFitClicked">
                                        <FontIcon Glyph="&#xE9A6;" />
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Grid.Column="1" Background="{StaticResource ChatOSBorderBrush}" />

                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <ScrollViewer Padding="16"
                                AutomationProperties.AutomationId="ChatOS.Chat.TaskGraph.Inspector"
                                VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="12">
                                <ProgressRing Width="24" Height="24" HorizontalAlignment="Left"
                                    IsActive="{x:Bind TaskGraph.IsLoading, Mode=OneWay}"
                                    AutomationProperties.Name="{x:Bind Localization.LoadingTaskDetails, Mode=OneWay}"
                                    Visibility="{x:Bind TaskGraph.IsLoading, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <TextBlock Text="{x:Bind Localization.WaitingForTaskGraph, Mode=OneWay}"
                                    TextWrapping="Wrap" Style="{StaticResource ChatOSSecondaryBodyTextStyle}"
                                    Visibility="{x:Bind TaskGraph.IsAwaitingInitialGraph, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <TextBlock Text="{x:Bind Localization.UsingPreviousTaskGraph, Mode=OneWay}"
                                    TextWrapping="Wrap" Style="{StaticResource ChatOSSecondaryBodyTextStyle}"
                                    Visibility="{x:Bind TaskGraph.IsUsingPreviousGraph, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <StackPanel Spacing="4"
                                    Visibility="{x:Bind TaskGraph.HasRealtimeError, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="{x:Bind Localization.TaskGraphRealtimeInterrupted, Mode=OneWay}"
                                        TextWrapping="Wrap" Style="{StaticResource ChatOSSecondaryBodyTextStyle}" />
                                    <TextBlock Text="{x:Bind TaskGraph.RealtimeErrorMessage, Mode=OneWay}"
                                        TextWrapping="Wrap" Foreground="{StaticResource ChatOSFailureBrush}" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                </StackPanel>
                                <StackPanel Spacing="8"
                                    Visibility="{x:Bind TaskGraph.ShowsEmptyGraph, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="{x:Bind Localization.EmptyTaskGraph, Mode=OneWay}"
                                        TextWrapping="Wrap" Style="{StaticResource ChatOSHeadlineTextStyle}" />
                                    <TextBlock Text="{x:Bind Localization.EmptyTaskGraphHint, Mode=OneWay}"
                                        TextWrapping="Wrap" Style="{StaticResource ChatOSSecondaryBodyTextStyle}" />
                                    <Button Content="{x:Bind Localization.Refresh, Mode=OneWay}"
                                        Command="{x:Bind TaskGraph.RefreshCommand}"
                                        AutomationProperties.AutomationId="ChatOS.Chat.TaskGraph.RefreshEmpty" />
                                </StackPanel>
                                <StackPanel Spacing="8"
                                    Visibility="{x:Bind TaskGraph.ShowsGraphLoadError, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="{x:Bind Localization.TaskGraphLoadFailed, Mode=OneWay}"
                                        TextWrapping="Wrap" Style="{StaticResource ChatOSHeadlineTextStyle}" />
                                    <Button Content="{x:Bind Localization.Refresh, Mode=OneWay}"
                                        Command="{x:Bind TaskGraph.RefreshCommand}"
                                        AutomationProperties.AutomationId="ChatOS.Chat.TaskGraph.RefreshFailed" />
                                </StackPanel>
                                <Border Visibility="{x:Bind TaskGraph.HasTask, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                    <TextBlock Text="{x:Bind TaskGraph.ErrorMessage, Mode=OneWay}"
                                        TextWrapping="Wrap" Foreground="{StaticResource ChatOSFailureBrush}"
                                        Style="{StaticResource ChatOSCaptionTextStyle}"
                                        Visibility="{x:Bind TaskGraph.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />
                                </Border>
                                <StackPanel Spacing="12"
                                    Visibility="{x:Bind TaskGraph.HasTask, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="{x:Bind TaskGraph.SelectedTask.Title, Mode=OneWay}" TextWrapping="Wrap" Style="{StaticResource ChatOSPageTitleTextStyle}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind TaskGraph.SelectedTask.Status, Mode=OneWay}" Foreground="{StaticResource ChatOSPurpleBrush}" Style="{StaticResource ChatOSBodyStrongTextStyle}" />
                                        <TextBlock Text="{x:Bind TaskGraph.RunDetail.Run.Id, Mode=OneWay}"
                                            Style="{StaticResource ChatOSCaptionTextStyle}"
                                            Visibility="{x:Bind TaskGraph.HasRun, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind TaskGraph.SelectedTask.Description, Mode=OneWay}" TextWrapping="Wrap" Style="{StaticResource ChatOSSecondaryBodyTextStyle}" />
                                    <TextBlock Text="{x:Bind TaskGraph.SelectedTask.Objective, Mode=OneWay}" TextWrapping="Wrap" Style="{StaticResource ChatOSSecondaryBodyTextStyle}" />
                                </StackPanel>

                                <Border Style="{StaticResource ChatOSCardStyle}"
                                    AutomationProperties.AutomationId="ChatOS.Chat.TaskGraph.FrozenModel"
                                    Visibility="{x:Bind TaskGraph.HasFrozenModel, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{x:Bind Localization.FrozenTaskModel, Mode=OneWay}" Style="{StaticResource ChatOSBodyStrongTextStyle}" />
                                        <TextBlock Text="{x:Bind TaskGraph.FrozenModelDisplay, Mode=OneWay}" TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Spacing="6"
                                            Visibility="{x:Bind TaskGraph.HasFrozenThinkingLevel, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="{x:Bind Localization.FrozenTaskReasoning, Mode=OneWay}" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                            <TextBlock Text="{x:Bind TaskGraph.FrozenThinkingLevelDisplay, Mode=OneWay}" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind TaskGraph.FrozenModelRevisionDisplay, Mode=OneWay}"
                                            AutomationProperties.Name="{x:Bind Localization.FrozenTaskModelRevision, Mode=OneWay}"
                                            TextWrapping="Wrap" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                        <TextBlock Text="{x:Bind Localization.FrozenTaskModelNotice, Mode=OneWay}" TextWrapping="Wrap" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource ChatOSCardStyle}"
                                    AutomationProperties.AutomationId="ChatOS.Chat.TaskGraph.RequirementPlan"
                                    Visibility="{x:Bind TaskGraph.HasRequirementPlan, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel Spacing="9">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind Localization.FrozenRequirementPlan, Mode=OneWay}" Style="{StaticResource ChatOSHeadlineTextStyle}" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind Localization.RequirementPlanVersion, Mode=OneWay}" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind TaskGraph.RequirementPlanRevisionLabel, Mode=OneWay}" Style="{StaticResource ChatOSBodyStrongTextStyle}" />
                                        </Grid>
                                        <TextBlock Text="{x:Bind TaskGraph.RequirementPlan.Snapshot.Title, Mode=OneWay}" TextWrapping="Wrap" Style="{StaticResource ChatOSBodyStrongTextStyle}" />
                                        <TextBlock Text="{x:Bind Localization.FrozenRequirementPlanNotice, Mode=OneWay}" TextWrapping="Wrap" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                        <designSystem:MarkdownRichTextBlock Markdown="{x:Bind TaskGraph.RequirementPlan.Snapshot.Markdown, Mode=OneWay}" />
                                        <TextBlock Text="{x:Bind Localization.RequirementPlanScope, Mode=OneWay}" Style="{StaticResource ChatOSBodyStrongTextStyle}" />
                                        <TextBlock Text="{x:Bind Localization.RequirementPlanPrompt, Mode=OneWay}" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                        <TextBlock Text="{x:Bind TaskGraph.RequirementPlan.TaskScope.Prompt, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Style="{StaticResource ChatOSSecondaryBodyTextStyle}" />
                                        <TextBlock Text="{x:Bind Localization.RequirementPlanExpectedOutputs, Mode=OneWay}" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                        <TextBlock Text="{x:Bind TaskGraph.RequirementPlan.TaskScope.ExpectedOutputs, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Style="{StaticResource ChatOSSecondaryBodyTextStyle}" />
                                        <TextBlock Text="{x:Bind Localization.RequirementPlanAcceptanceCriteria, Mode=OneWay}" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                        <TextBlock Text="{x:Bind TaskGraph.RequirementPlan.TaskScope.AcceptanceCriteria, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Style="{StaticResource ChatOSSecondaryBodyTextStyle}" />
                                        <TextBlock Text="{x:Bind Localization.RequirementPlanHash, Mode=OneWay}" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                        <TextBlock Text="{x:Bind TaskGraph.RequirementPlan.MarkdownSha256, Mode=OneWay}" TextWrapping="WrapWholeWords" IsTextSelectionEnabled="True" FontFamily="Consolas" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource ChatOSCardStyle}"
                                    AutomationProperties.AutomationId="ChatOS.Chat.TaskGraph.AcceptanceReport"
                                    Visibility="{x:Bind TaskGraph.HasAcceptanceReport, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="{x:Bind Localization.TaskAcceptanceResult, Mode=OneWay}" Style="{StaticResource ChatOSHeadlineTextStyle}" />
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{x:Bind Localization.TaskAcceptanceStatus, Mode=OneWay}" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                            <TextBlock Text="{x:Bind TaskGraph.AcceptanceReport.Status, Mode=OneWay}" Foreground="{StaticResource ChatOSPurpleBrush}" Style="{StaticResource ChatOSBodyStrongTextStyle}" />
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind Localization.TaskAcceptanceReason, Mode=OneWay}" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                        <TextBlock Text="{x:Bind TaskGraph.AcceptanceReport.Reason, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Style="{StaticResource ChatOSSecondaryBodyTextStyle}" />
                                        <ItemsControl ItemsSource="{x:Bind TaskGraph.AcceptanceReport.Checks, Mode=OneWay}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="core:MessageTaskAcceptanceCheck">
                                                    <Border Margin="0,2" Padding="9" Background="{StaticResource ChatOSProcessBackgroundBrush}" CornerRadius="7">
                                                        <StackPanel Spacing="3">
                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                <TextBlock Text="{x:Bind DisplayIndex}" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                                                <TextBlock Text="{x:Bind Status}" Foreground="{StaticResource ChatOSPurpleBrush}" Style="{StaticResource ChatOSBodyStrongTextStyle}" />
                                                            </StackPanel>
                                                            <TextBlock Text="{x:Bind Criterion}" TextWrapping="Wrap" Style="{StaticResource ChatOSBodyStrongTextStyle}" />
                                                            <TextBlock Text="{x:Bind Evidence}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Style="{StaticResource ChatOSSecondaryBodyTextStyle}" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{x:Bind Localization.TaskAcceptanceFinalResponse, Mode=OneWay}" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                        <TextBlock Text="{x:Bind TaskGraph.AcceptanceReport.FinalResponse, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Style="{StaticResource ChatOSSecondaryBodyTextStyle}" />
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{x:Bind Localization.TaskAcceptanceCharacterCount, Mode=OneWay}" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                            <TextBlock Text="{x:Bind TaskGraph.AcceptanceCharacterCountLabel, Mode=OneWay}" Style="{StaticResource ChatOSBodyStrongTextStyle}" />
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind Localization.TaskAcceptanceWorkerNotice, Mode=OneWay}" TextWrapping="Wrap" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource ChatOSCardStyle}"
                                    AutomationProperties.AutomationId="ChatOS.Chat.TaskGraph.AcceptanceMissing"
                                    Visibility="{x:Bind TaskGraph.ShowsMissingAcceptanceReport, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="{x:Bind Localization.TaskAcceptanceReportMissing, Mode=OneWay}"
                                        TextWrapping="Wrap" Foreground="{StaticResource ChatOSFailureBrush}" Style="{StaticResource ChatOSSecondaryBodyTextStyle}" />
                                </Border>

                                <Border Style="{StaticResource ChatOSCardStyle}"
                                    Visibility="{x:Bind TaskGraph.HasRun, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{x:Bind Localization.RunResult, Mode=OneWay}" Style="{StaticResource ChatOSHeadlineTextStyle}" />
                                        <TextBlock Text="{x:Bind TaskGraph.RunDetail.Run.ResultSummary, Mode=OneWay}" TextWrapping="Wrap" Style="{StaticResource ChatOSSecondaryBodyTextStyle}" />
                                        <TextBlock Text="{x:Bind TaskGraph.RunDetail.Run.ReportContent, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Style="{StaticResource ChatOSSecondaryBodyTextStyle}" />
                                        <TextBlock Text="{x:Bind TaskGraph.RunDetail.Run.ErrorMessage, Mode=OneWay}" TextWrapping="Wrap" Foreground="{StaticResource ChatOSFailureBrush}" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="{x:Bind Localization.NoTaskRunYet, Mode=OneWay}"
                                    TextWrapping="Wrap" Style="{StaticResource ChatOSSecondaryBodyTextStyle}"
                                    AutomationProperties.AutomationId="ChatOS.Chat.TaskGraph.NoRun"
                                    Visibility="{x:Bind TaskGraph.HasRun, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />

                                <StackPanel Spacing="6">
                                    <TextBlock Text="{x:Bind Localization.PrerequisiteTasks, Mode=OneWay}"
                                        Style="{StaticResource ChatOSHeadlineTextStyle}" />
                                    <TextBlock Text="{x:Bind Localization.NoPrerequisiteTasks, Mode=OneWay}"
                                        Style="{StaticResource ChatOSSecondaryBodyTextStyle}"
                                        Visibility="{x:Bind TaskGraph.HasPrerequisites, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                    <ItemsControl ItemsSource="{x:Bind TaskGraph.Prerequisites, Mode=OneWay}"
                                        AutomationProperties.AutomationId="ChatOS.Chat.TaskGraph.Prerequisites"
                                        Visibility="{x:Bind TaskGraph.HasPrerequisites, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="core:MessageTaskReference">
                                                <Border Margin="0,2" Padding="9" Background="{StaticResource ChatOSProcessBackgroundBrush}" CornerRadius="7">
                                                    <StackPanel Spacing="2">
                                                        <TextBlock Text="{x:Bind Title}" TextWrapping="Wrap" Style="{StaticResource ChatOSBodyStrongTextStyle}" />
                                                        <TextBlock Text="{x:Bind Id}" TextTrimming="CharacterEllipsis" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                                        <TextBlock Text="{x:Bind Status}" Style="{StaticResource ChatOSCaptionTextStyle}" Foreground="{StaticResource ChatOSPurpleBrush}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind Localization.ExecutionProcess, Mode=OneWay}" Style="{StaticResource ChatOSHeadlineTextStyle}" />
                                        <TextBlock
                                            AutomationProperties.AutomationId="ChatOS.Chat.TaskGraph.EventCount"
                                            Text="{x:Bind TaskGraph.EventsCountLabel, Mode=OneWay}"
                                            Style="{StaticResource ChatOSCaptionTextStyle}" />
                                    </StackPanel>
                                    <TextBlock
                                        Text="{x:Bind Localization.NoTaskRunEvents, Mode=OneWay}"
                                        Style="{StaticResource ChatOSCaptionTextStyle}"
                                        Visibility="{x:Bind TaskGraph.HasRunEvents, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                    <ItemsControl ItemsSource="{x:Bind TaskGraph.RunEvents}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="core:MessageTaskRunEvent">
                                                <Border Margin="0,2" Padding="9" Background="{StaticResource ChatOSProcessBackgroundBrush}" CornerRadius="7">
                                                    <StackPanel Spacing="2">
                                                        <TextBlock Text="{x:Bind EventType}" Style="{StaticResource ChatOSBodyStrongTextStyle}" />
                                                        <TextBlock Text="{x:Bind Message}" TextWrapping="Wrap" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ProgressRing Width="20" Height="20" HorizontalAlignment="Left"
                                        IsActive="{x:Bind TaskGraph.IsLoadingMoreEvents, Mode=OneWay}"
                                        AutomationProperties.Name="{x:Bind Localization.LoadingTaskEvents, Mode=OneWay}"
                                        Visibility="{x:Bind TaskGraph.IsLoadingMoreEvents, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <Button
                                        HorizontalAlignment="Left"
                                        Command="{x:Bind TaskGraph.LoadMoreEventsCommand}"
                                        Content="{x:Bind Localization.LoadMoreRunEvents, Mode=OneWay}"
                                        Visibility="{x:Bind TaskGraph.EventsHasMore, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>

                                </StackPanel>
                                </StackPanel>
                            </ScrollViewer>

                            <Border
                                x:Name="TaskGraphActions"
                                Grid.Row="1"
                                Padding="16,12"
                                AutomationProperties.AutomationId="ChatOS.Chat.TaskGraph.Actions"
                                Background="{StaticResource ChatOSContentBackgroundBrush}"
                                BorderBrush="{StaticResource ChatOSBorderBrush}"
                                BorderThickness="0,1,0,0"
                                Visibility="{x:Bind TaskGraph.HasTask, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{x:Bind Localization.TaskActions, Mode=OneWay}" Style="{StaticResource ChatOSHeadlineTextStyle}" />
                                    <ProgressRing Width="20" Height="20" HorizontalAlignment="Left"
                                        IsActive="{x:Bind TaskGraph.IsApplyingAction, Mode=OneWay}"
                                        AutomationProperties.Name="{x:Bind Localization.ApplyingTaskAction, Mode=OneWay}"
                                        Visibility="{x:Bind TaskGraph.IsApplyingAction, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox PlaceholderText="{x:Bind Localization.OptionalCancelReason, Mode=OneWay}" Text="{x:Bind TaskGraph.CancelReason, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button
                                            Grid.Column="1"
                                            AutomationProperties.AutomationId="ChatOS.Chat.TaskGraph.CancelTask"
                                            Command="{x:Bind TaskGraph.CancelTaskCommand}"
                                            Content="{x:Bind Localization.CancelTask, Mode=OneWay}"
                                            IsEnabled="{x:Bind TaskGraph.CanCancel, Mode=OneWay}" />
                                    </Grid>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox PlaceholderText="{x:Bind Localization.OptionalRetryInstruction, Mode=OneWay}" Text="{x:Bind TaskGraph.RetryInstruction, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button
                                            Grid.Column="1"
                                            AutomationProperties.AutomationId="ChatOS.Chat.TaskGraph.RetryRun"
                                            AutomationProperties.Name="{x:Bind Localization.RetryRun, Mode=OneWay}"
                                            Click="OnRetryTaskRunClicked"
                                            Content="{x:Bind Localization.RetryRun, Mode=OneWay}"
                                            IsEnabled="{x:Bind TaskGraph.CanRetry, Mode=OneWay}"
                                            Style="{StaticResource ChatOSPrimaryButtonStyle}" />
                                    </Grid>
                                    <TextBlock Text="{x:Bind TaskGraph.ErrorMessage, Mode=OneWay}"
                                        TextWrapping="Wrap" Foreground="{StaticResource ChatOSFailureBrush}"
                                        Style="{StaticResource ChatOSCaptionTextStyle}"
                                        Visibility="{x:Bind TaskGraph.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <ProgressRing Grid.RowSpan="3" Width="30" Height="30" IsActive="{x:Bind TaskGraph.IsLoading, Mode=OneWay}" Visibility="{x:Bind TaskGraph.IsLoading, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
