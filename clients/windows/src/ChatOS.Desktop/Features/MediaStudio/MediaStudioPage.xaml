                                                        <TextBlock Text="{x:Bind StoryViewModel.OptimizationTitle, Mode=OneWay}" Style="{StaticResource ChatOSHeadlineTextStyle}" />
                                                        <TextBlock Text="{x:Bind StoryViewModel.OptimizationRationale, Mode=OneWay}" TextWrapping="Wrap" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                                        <TextBox AcceptsReturn="True" IsReadOnly="True" MaxHeight="220" Text="{x:Bind StoryViewModel.OptimizationText, Mode=OneWay}" TextWrapping="Wrap" />
                                                        <Grid ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                            <Button Click="OnApplyStoryOptimizationClick" Content="采用候选" HorizontalAlignment="Stretch" IsEnabled="{x:Bind StoryViewModel.CanApplyOptimization, Mode=OneWay}" Style="{StaticResource ChatOSPrimaryButtonStyle}" />
