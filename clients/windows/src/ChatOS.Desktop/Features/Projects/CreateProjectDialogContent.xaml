<UserControl
    x:Class="ChatOS.Desktop.Features.Projects.CreateProjectDialogContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AutomationProperties.AutomationId="ChatOS.CreateProject.Root"
    AutomationProperties.Name="新建本地项目"
    xmlns:core="using:ChatOS.Core.Domain">

    <ScrollViewer x:Name="FormScroller" MaxHeight="650" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="700" HorizontalAlignment="Stretch" Spacing="16">
            <StackPanel Spacing="3">
                <TextBlock Text="项目保存在本机。Git 由本机管理，聊天可在创建后单独准备。" TextWrapping="Wrap" Style="{StaticResource ChatOSCaptionTextStyle}" />
                <TextBlock x:Name="NoWorkspaceNotice" AutomationProperties.AutomationId="ChatOS.CreateProject.NoWorkspace" Text="请先在设置中为本机 Connector 添加授权工作区。" Foreground="{StaticResource ChatOSWarningBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
            </StackPanel>

            <ComboBox
                x:Name="WorkspacePicker"
                AutomationProperties.AutomationId="ChatOS.CreateProject.Workspace"
                Header="授权工作区"
                HorizontalAlignment="Stretch"
                DisplayMemberPath="Alias"
                ItemsSource="{x:Bind ViewModel.Workspaces}"
                SelectionChanged="OnWorkspaceSelectionChanged" />

            <Border BorderBrush="{StaticResource ChatOSBorderBrush}" BorderThickness="1" CornerRadius="12">
                <Grid Height="292">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="1" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Padding="10,6" ColumnSpacing="7" RowSpacing="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="32" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="ParentButton" AutomationProperties.AutomationId="ChatOS.CreateProject.Parent" AutomationProperties.Name="返回上一级" Click="OnParentClicked" Style="{StaticResource ChatOSToolbarButtonStyle}" ToolTipService.ToolTip="返回上一级">
                            <FontIcon Glyph="&#xE72B;" />
                        </Button>
                        <FontIcon Grid.Column="1" Glyph="&#xE8B7;" Foreground="{StaticResource ChatOSAccentBrush}" />
                        <TextBlock Grid.Column="2" AutomationProperties.AutomationId="ChatOS.CreateProject.CurrentLocation" VerticalAlignment="Center" Text="{x:Bind ViewModel.DisplayedLocation, Mode=OneWay}" TextTrimming="CharacterEllipsis" Style="{StaticResource ChatOSBodyStrongTextStyle}" />
                        <Grid Grid.Row="1" Grid.ColumnSpan="3" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="1">
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        x:Name="AddressPathBox"
                                        AutomationProperties.AutomationId="ChatOS.CreateProject.AbsolutePath"
                                        AutomationProperties.Name="当前目录绝对路径"
                                        Height="30"
                                        Padding="8,2"
                                        Text="{x:Bind ViewModel.CurrentPath, Mode=OneWay}"
                                        KeyDown="OnAddressPathKeyDown" />
                                    <Button
                                        Grid.Column="1"
                                        AutomationProperties.AutomationId="ChatOS.CreateProject.OpenAbsolutePath"
                                        AutomationProperties.Name="打开绝对目录路径"
                                        Click="OnOpenAbsolutePathClicked"
                                        Content="前往"
                                        Style="{StaticResource ChatOSToolbarButtonStyle}" />
                                </Grid>
                                <TextBlock
                                    AutomationProperties.AutomationId="ChatOS.CreateProject.EntrySummary"
                                    AutomationProperties.Name="当前目录项统计"
                                    Text="{x:Bind ViewModel.DirectoryListingSummary, Mode=OneWay}"
                                    Style="{StaticResource ChatOSCaptionTextStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="6">
                                <Button x:Name="HiddenButton" AutomationProperties.AutomationId="ChatOS.CreateProject.ToggleHidden" AutomationProperties.Name="显示隐藏与系统目录" Click="OnToggleHiddenClicked" Style="{StaticResource ChatOSToolbarButtonStyle}" ToolTipService.ToolTip="显示隐藏与系统目录">
                                    <FontIcon x:Name="HiddenIcon" Glyph="&#xED1A;" />
                                </Button>
                                <Button x:Name="NewFolderButton" AutomationProperties.AutomationId="ChatOS.CreateProject.NewFolder" AutomationProperties.Name="在当前目录新建文件夹" Click="OnShowNewFolderClicked" Style="{StaticResource ChatOSToolbarButtonStyle}" ToolTipService.ToolTip="在当前目录新建文件夹">
                                    <FontIcon Glyph="&#xE8F4;" />
                                </Button>
                                <Button x:Name="RefreshButton" AutomationProperties.AutomationId="ChatOS.CreateProject.Refresh" AutomationProperties.Name="刷新目录" Click="OnRefreshClicked" Style="{StaticResource ChatOSToolbarButtonStyle}" ToolTipService.ToolTip="刷新目录">
                                    <FontIcon Glyph="&#xE72C;" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <Border Grid.Row="1" Background="{StaticResource ChatOSBorderBrush}" />

                    <StackPanel x:Name="NewFolderPanel" Grid.Row="2" Margin="10,8,10,0" Spacing="4" Visibility="Collapsed">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="NewFolderNameBox" AutomationProperties.AutomationId="ChatOS.CreateProject.NewFolderName" PlaceholderText="文件夹名称" KeyDown="OnNewFolderNameKeyDown" />
                            <Button Grid.Column="1" AutomationProperties.AutomationId="ChatOS.CreateProject.CreateFolder" Content="创建" Click="OnCreateFolderClicked" Style="{StaticResource ChatOSPrimaryButtonStyle}" />
                            <Button Grid.Column="2" AutomationProperties.AutomationId="ChatOS.CreateProject.CancelFolder" Content="取消" Click="OnCancelFolderClicked" />
                        </Grid>
                        <TextBlock
                            x:Name="NewFolderErrorText"
                            AutomationProperties.AutomationId="ChatOS.CreateProject.NewFolderError"
                            Foreground="{StaticResource ChatOSFailureBrush}"
                            TextWrapping="Wrap"
                            Visibility="Collapsed" />
                    </StackPanel>

                    <Grid Grid.Row="3" Margin="6">
                        <ListView
                            x:Name="FolderList"
                            AutomationProperties.AutomationId="ChatOS.CreateProject.Folders"
                            IsItemClickEnabled="True"
                            ItemClick="OnFolderClicked"
                            ItemsSource="{x:Bind ViewModel.Entries}"
                            SelectionMode="None">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                                    <Setter Property="AutomationProperties.HelpText" Value="{Binding Path}" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="core:ProjectFileEntry">
                                    <Grid Padding="8,5" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE8B7;" FontSize="14" Foreground="{StaticResource ChatOSAccentBrush}" />
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                        <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="11" Foreground="{StaticResource ChatOSSecondaryTextBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <StackPanel x:Name="LoadingPanel" AutomationProperties.AutomationId="ChatOS.CreateProject.Loading" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Visibility="Collapsed">
                            <ProgressRing Width="24" Height="24" IsActive="True" />
                            <TextBlock Text="正在读取本机目录…" Style="{StaticResource ChatOSCaptionTextStyle}" />
                        </StackPanel>

                        <StackPanel x:Name="EmptyPanel" AutomationProperties.AutomationId="ChatOS.CreateProject.Empty" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="7" Visibility="Collapsed">
                            <FontIcon Glyph="&#xE8B7;" FontSize="28" Foreground="{StaticResource ChatOSSecondaryTextBrush}" />
                            <TextBlock Text="当前目录没有子文件夹" HorizontalAlignment="Center" Style="{StaticResource ChatOSBodyStrongTextStyle}" />
                            <TextBlock Text="可以直接使用当前目录，或在这里新建文件夹。" Style="{StaticResource ChatOSCaptionTextStyle}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <TextBox
                x:Name="ProjectNameBox"
                AutomationProperties.AutomationId="ChatOS.CreateProject.Name"
                Header="项目名称"
                PlaceholderText="项目名称"
                Text="{x:Bind ViewModel.ProjectName, Mode=OneWay}"
                TextChanged="OnProjectNameChanged" />

            <TextBox
                AutomationProperties.AutomationId="ChatOS.CreateProject.Description"
                Header="项目说明（可选）"
                AcceptsReturn="True"
                MinHeight="64"
                MaxHeight="110"
                PlaceholderText="简要说明这个项目的用途"
                Text="{x:Bind ViewModel.ProjectDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                TextWrapping="Wrap" />

            <StackPanel Spacing="6">
                <ComboBox
                    AutomationProperties.AutomationId="ChatOS.CreateProject.Type"
                    Header="项目类型"
                    HorizontalAlignment="Stretch"
                    DisplayMemberPath="DisplayLabel"
                    ItemsSource="{x:Bind ViewModel.ProjectTypes}"
                    SelectedItem="{x:Bind ViewModel.SelectedProjectType, Mode=TwoWay}" />
                <TextBlock
                    AutomationProperties.AutomationId="ChatOS.CreateProject.TypeDescription"
                    Text="{x:Bind ViewModel.SelectedProjectType.Description, Mode=OneWay, FallbackValue=''}"
                    TextWrapping="Wrap"
                    Style="{StaticResource ChatOSCaptionTextStyle}" />
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock Text="不会上传代码或创建托管仓库，也不要求 Git remote 或默认联系人。" TextWrapping="Wrap" Style="{StaticResource ChatOSCaptionTextStyle}" />
                <TextBlock
                    x:Name="ErrorText"
                    AutomationProperties.AutomationId="ChatOS.CreateProject.Error"
                    Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                    Foreground="{StaticResource ChatOSFailureBrush}"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
