{
  "slug": "dropdown",
  "title": "Dropdown",
  "description": "Dropdown can open a menu or any other element when the button is clicked.",
  "demos": [
    {
      "id": "dropdown-1",
      "label": "Dropdown using details and summary",
      "html": "<details class=\"dropdown\">\n  <summary class=\"btn m-1\">open or close</summary>\n  <ul class=\"menu dropdown-content bg-base-100 rounded-box z-1 w-52 p-2 shadow-sm\">\n    <li><a>Item 1</a></li>\n    <li><a>Item 2</a></li>\n  </ul>\n</details>"
    },
    {
      "id": "dropdown-2",
      "label": "Dropdown using popover API and anchor positioning",
      "html": "<!-- change popover-1 and --anchor-1 names. Use unique names for each dropdown -->\n<button class=\"btn\" popovertarget=\"popover-1\" style=\"anchor-name:--anchor-1\">\n  Button\n</button>\n<ul class=\"dropdown menu w-52 rounded-box bg-base-100 shadow-sm\"\n  popover id=\"popover-1\" style=\"position-anchor:--anchor-1\">\n  <li><a>Item 1</a></li>\n  <li><a>Item 2</a></li>\n</ul>"
    },
    {
      "id": "dropdown-3",
      "label": "Dropdown menu",
      "html": "<div class=\"dropdown\">\n  <div tabindex=\"0\" role=\"button\" class=\"btn m-1\">Click</div>\n  <ul tabindex=\"-1\" class=\"dropdown-content menu bg-base-100 rounded-box z-1 w-52 p-2 shadow-sm\">\n    <li><a>Item 1</a></li>\n    <li><a>Item 2</a></li>\n  </ul>\n</div>"
    },
