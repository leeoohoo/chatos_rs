{
  "schemaVersion": 3,
  "name": "sentry",
  "version": "1.0.0",
  "description": "Inspect Sentry issues, releases, traces, and regression evidence without exposing event secrets.",
  "author": {
    "name": "Example Observability Publisher",
    "url": "https://plugins.example.com"
  },
  "homepage": "https://plugins.example.com/sentry",
  "repository": "https://plugins.example.com/sentry/source",
  "license": "LicenseRef-Pending-Redistribution-Review",
  "keywords": ["observability", "errors", "releases"],
  "mcpServers": {
    "sentry-api": {
      "type": "http",
      "url": "https://sentry-mcp.plugins.example.com/mcp",
      "oauthResource": "sentry"
    }
  },
  "agents": [
    {
      "componentKey": "incident-triage",
      "source": "./agents/incident-triage.md",
      "description": "Correlate selected Sentry issues with releases and produce a bounded triage report.",
      "baseAgent": "task_runner_run_phase",
      "allowedTools": ["plugin_sentry_issue_read", "plugin_sentry_release_read", "plugin_sentry_trace_read"],
      "maxIterations": 12
    }
  ],
  "ui": [
    {
      "componentKey": "issue-panel",
      "source": "./ui/issue-panel.html",
      "title": "Sentry Issue",
      "surface": "detail_panel",
      "assets": ["./ui/issue-panel.js", "./ui/issue-panel.css"],
      "bridgeCapabilities": ["host.context.read", "artifact.list", "artifact.read"],
      "artifactMimeTypes": ["application/json", "text/markdown"]
    }
  ],
  "interface": {
    "displayName": "Sentry",
    "shortDescription": "Triage Sentry issues and releases.",
    "longDescription": "Connect a reviewed Sentry adapter to inspect selected issues, releases, and traces while keeping credentials and raw event payloads out of audit logs.",
    "developerName": "Example Observability Publisher",
    "category": "Developer Tools",
    "capabilities": ["incident.triage", "release.regression", "trace.inspect"],
    "websiteURL": "https://plugins.example.com/sentry",
    "privacyPolicyURL": "https://plugins.example.com/privacy",
    "termsOfServiceURL": "https://plugins.example.com/terms",
    "defaultPrompt": ["Use Sentry only for selected organizations, projects, issues, and releases."],
    "brandColor": "#362D59"
  },
  "dependencies": {
    "minimumHostVersion": "2.0.9"
  },
  "permissions": [
    {
      "permission": "sentry.issue.read",
      "required": true,
      "reason": "Read selected issue metadata and bounded event summaries.",
      "components": ["sentry-api", "incident-triage", "issue-panel"]
    },
    {
      "permission": "sentry.release.read",
      "required": true,
      "reason": "Correlate issues with selected releases.",
      "components": ["sentry-api", "incident-triage"]
    },
    {
      "permission": "sentry.issue.mutate",
      "required": false,
      "reason": "Prepare assignment or resolve actions that still require explicit approval.",
      "components": ["sentry-api"]
    }
  ]
}
