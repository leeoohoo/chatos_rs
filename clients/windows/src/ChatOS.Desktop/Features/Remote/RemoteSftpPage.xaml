<UserControl x:Class="ChatOS.Desktop.Features.Remote.RemoteSftpPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:core="using:ChatOS.Core.Domain">
    <Grid Background="{StaticResource ChatOSContentBackgroundBrush}">
        <Grid.RowDefinitions><RowDefinition Height="54" /><RowDefinition Height="1" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid Padding="14,0" ColumnSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Button Click="OnBackClick" Style="{StaticResource ChatOSToolbarButtonStyle}"><FontIcon Glyph="&#xE72B;" /></Button><TextBlock Grid.Column="1" Margin="6,0" VerticalAlignment="Center" Text="{x:Bind ViewModel.ConnectionName, Mode=OneWay}" Style="{StaticResource ChatOSHeadlineTextStyle}" /><TextBox Grid.Column="2" Margin="12,0" VerticalAlignment="Center" Text="{x:Bind ViewModel.CurrentPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" /><Button Grid.Column="3" Command="{x:Bind ViewModel.UpCommand}" Content="{x:Bind Localization.ParentDirectory, Mode=OneWay}" /><Button Grid.Column="4" Command="{x:Bind ViewModel.RefreshCommand}" Style="{StaticResource ChatOSToolbarButtonStyle}"><FontIcon Glyph="&#xE72C;" /></Button><Button Grid.Column="5" Click="OnCreateDirectoryClick" Content="{x:Bind Localization.NewDirectory, Mode=OneWay}" /><Button Grid.Column="6" Click="OnUploadClick" Content="{x:Bind Localization.Upload, Mode=OneWay}" Style="{StaticResource ChatOSPrimaryButtonStyle}" /></Grid>
        <Border Grid.Row="1" Background="{StaticResource ChatOSBorderBrush}" />
        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="420" /><ColumnDefinition Width="1" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <ListView ItemsSource="{x:Bind ViewModel.Entries}" IsItemClickEnabled="True" ItemClick="OnEntryClick" Padding="10" SelectionMode="Single"><ListView.ItemTemplate><DataTemplate x:DataType="core:RemoteFileEntry"><Grid Padding="5" ColumnSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><FontIcon Glyph="{x:Bind IsDirectory, Converter={StaticResource RemoteFileGlyphConverter}}" FontSize="12" /><StackPanel Grid.Column="1" Spacing="1"><TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" Style="{StaticResource ChatOSBodyStrongTextStyle}" /><TextBlock Text="{x:Bind FullPath}" TextTrimming="CharacterEllipsis" Style="{StaticResource ChatOSCaptionTextStyle}" /></StackPanel><Button Grid.Column="2" Click="OnDownloadClick" Style="{StaticResource ChatOSToolbarButtonStyle}"><FontIcon Glyph="&#xE896;" FontSize="11" /></Button><Button Grid.Column="3" Click="OnRenameClick" Style="{StaticResource ChatOSToolbarButtonStyle}"><FontIcon Glyph="&#xE70F;" FontSize="11" /></Button><Button Grid.Column="4" Click="OnDeleteClick" Style="{StaticResource ChatOSToolbarButtonStyle}"><FontIcon Glyph="&#xE74D;" FontSize="11" /></Button></Grid></DataTemplate></ListView.ItemTemplate></ListView>
            <Border Grid.Column="1" Background="{StaticResource ChatOSBorderBrush}" />
            <Grid Grid.Column="2" Padding="18"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><StackPanel Spacing="8"><TextBlock Text="{x:Bind Localization.FilePreview, Mode=OneWay}" Style="{StaticResource ChatOSSectionLabelTextStyle}" /><Border Padding="10" Background="{StaticResource ChatOSProcessBackgroundBrush}" CornerRadius="8" Visibility="{x:Bind ViewModel.HasVerificationChallenge, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"><StackPanel Spacing="6"><TextBlock Text="{x:Bind ViewModel.VerificationPrompt, Mode=OneWay}" /><TextBox PlaceholderText="{x:Bind Localization.SshVerificationRefreshPlaceholder, Mode=OneWay}" Text="{x:Bind ViewModel.VerificationCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" /></StackPanel></Border></StackPanel><TextBox Grid.Row="1" Margin="0,12,0,0" Text="{x:Bind ViewModel.PreviewText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" FontFamily="Cascadia Mono, Consolas" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" /></Grid>
        </Grid>
        <StackPanel Grid.Row="3" Margin="14,6" Spacing="2"><ProgressRing Width="18" Height="18" HorizontalAlignment="Left" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" /><TextBlock Text="{x:Bind ViewModel.ActionMessage, Mode=OneWay}" Foreground="{StaticResource ChatOSSuccessBrush}" Visibility="{x:Bind ViewModel.ActionMessage, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" /><TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" Foreground="{StaticResource ChatOSFailureBrush}" Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" /></StackPanel>
    </Grid>
</UserControl>
