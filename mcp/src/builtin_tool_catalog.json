            "type": "string"
          }
        },
        "type": "object"
      },
      "name": "list_dir"
    },
    {
      "description": "Return UTF-8 file content from the current project workspace.\nwith_line_numbers defaults to true; set false to skip structured numbered lines.\nPaths are relative to the current project workspace root.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "path": {
