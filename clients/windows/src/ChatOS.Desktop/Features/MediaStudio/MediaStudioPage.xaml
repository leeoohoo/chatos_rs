                                                                            <Button Click="OnStoryRelationResourceClick" Content="{x:Bind Header}" HorizontalAlignment="Stretch" IsEnabled="{x:Bind CanSelectResource}" Style="{StaticResource ChatOSSecondaryButtonStyle}" />
                                                                            <TextBlock Text="{x:Bind KindLabel}" Foreground="{StaticResource ChatOSPurpleBrush}" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                                                            <TextBlock Text="{x:Bind UsageLabel}" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                                                            <ItemsControl ItemsSource="{x:Bind Links}">
                                                                                <ItemsControl.ItemTemplate>
                                                                                    <DataTemplate x:DataType="media:StorySegmentRelationLink">
                                                                                        <Button Margin="0,3,0,0" Click="OnStoryRelationSegmentClick" Content="{x:Bind Label}" HorizontalAlignment="Stretch" Style="{StaticResource ChatOSSecondaryButtonStyle}" />
                                                                                    </DataTemplate>
                                                                                </ItemsControl.ItemTemplate>
                                                                            </ItemsControl>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Expander>
                                                <Expander Header="{x:Bind StoryViewModel.ContinuitySummary, Mode=OneWay}">
                                                    <StackPanel Padding="0,8,0,0" Spacing="8">
                                                        <Button Click="OnAutoFillStoryContinuityClick" Content="补齐缺失衔接和基础镜头计划" HorizontalAlignment="Stretch" IsEnabled="{x:Bind StoryViewModel.CanAutoFillContinuity, Mode=OneWay}" Style="{StaticResource ChatOSSecondaryButtonStyle}" />
                                                        <TextBlock Text="检查结果会随编辑实时更新；点击问题可定位分段。" TextWrapping="Wrap" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                                        <ItemsControl ItemsSource="{x:Bind StoryViewModel.ContinuityIssues}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="media:StoryContinuityIssue">
                                                                    <Button Margin="0,0,0,6" Click="OnStoryContinuityIssueClick" HorizontalAlignment="Stretch" Style="{StaticResource ChatOSSecondaryButtonStyle}">
                                                                        <StackPanel HorizontalAlignment="Left" Spacing="2">
                                                                            <TextBlock Text="{x:Bind SegmentLabel}" Style="{StaticResource ChatOSBodyStrongTextStyle}" />
                                                                            <TextBlock Text="{x:Bind Title}" Foreground="{StaticResource ChatOSPurpleBrush}" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                                                            <TextBlock Text="{x:Bind Detail}" MaxLines="3" TextWrapping="Wrap" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                                                        </StackPanel>
                                                                    </Button>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Expander>
                                                <Expander Header="{x:Bind StoryViewModel.ProjectVideoSummary, Mode=OneWay}">
                                                    <StackPanel Padding="0,8,0,0" Spacing="8">
                                                        <Grid ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                            <Button Click="OnPlayStoryPlaylistClick" Content="连续播放已完成分段" HorizontalAlignment="Stretch" IsEnabled="{x:Bind StoryViewModel.CanPlayStoryPlaylist, Mode=OneWay}" Style="{StaticResource ChatOSPrimaryButtonStyle}" />
                                                            <Button Grid.Column="1" Click="OnStopStoryPlaylistClick" Content="停止连播" IsEnabled="{x:Bind StoryViewModel.IsPlaylistActive, Mode=OneWay}" Style="{StaticResource ChatOSSecondaryButtonStyle}" />
                                                        </Grid>
                                                        <TextBlock Text="{x:Bind StoryViewModel.PlaylistStatusLabel, Mode=OneWay}" TextWrapping="Wrap" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                                        <TextBlock Text="项目图片" Style="{StaticResource ChatOSBodyStrongTextStyle}" />
                                                        <ListView MaxHeight="260" Background="Transparent" BorderThickness="0" IsItemClickEnabled="True" ItemClick="OnStoryProjectImageClick" ItemsSource="{x:Bind StoryViewModel.ProjectImages}" SelectionMode="None">
                                                            <ListView.ItemTemplate>
                                                                <DataTemplate x:DataType="media:StoryProjectImageItem">
                                                                    <Border Margin="0,0,0,6" Padding="7" Background="{StaticResource ChatOSSurfaceSubtleBrush}" CornerRadius="8">
                                                                        <Grid ColumnSpacing="9">
                                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="68" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                                            <Image Width="68" Height="48" Source="{Binding FilePath, Converter={StaticResource FilePathToImageSourceConverter}}" Stretch="UniformToFill" />
                                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                                                <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" Style="{StaticResource ChatOSBodyStrongTextStyle}" />
                                                                                <TextBlock Text="{x:Bind KindLabel}" Foreground="{StaticResource ChatOSPurpleBrush}" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                                                            </StackPanel>
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ListView.ItemTemplate>
                                                        </ListView>
                                                        <TextBlock Text="分段视频" Style="{StaticResource ChatOSBodyStrongTextStyle}" />
                                                        <ListView MaxHeight="220" Background="Transparent" BorderThickness="0" IsItemClickEnabled="True" ItemClick="OnStoryProjectVideoClick" ItemsSource="{x:Bind StoryViewModel.ProjectVideos}" SelectionMode="None">
                                                            <ListView.ItemTemplate>
                                                                <DataTemplate x:DataType="media:StoryProjectVideoItem">
                                                                    <Border Margin="0,0,0,6" Padding="9" Background="{StaticResource ChatOSSurfaceSubtleBrush}" CornerRadius="8">
                                                                        <StackPanel Spacing="2">
                                                                            <TextBlock Text="{x:Bind Title}" Style="{StaticResource ChatOSBodyStrongTextStyle}" />
                                                                            <TextBlock Text="{x:Bind SequenceLabel}" Foreground="{StaticResource ChatOSPurpleBrush}" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                                                        </StackPanel>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ListView.ItemTemplate>
                                                        </ListView>
                                                    </StackPanel>
                                                </Expander>
                                            </StackPanel>
                                        </ScrollViewer>

                                        <Grid x:Name="StorySegmentsSection" Grid.ColumnSpan="2" ColumnSpacing="12" Visibility="Collapsed">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="250" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <Grid>
                                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                                <Grid Margin="0,0,0,10">
                                                    <TextBlock VerticalAlignment="Center" Text="拍摄分段" Style="{StaticResource ChatOSHeadlineTextStyle}" />
                                                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="5">
                                                        <Button Click="OnMoveStorySegmentUpClick" Content="↑" IsEnabled="{x:Bind StoryViewModel.CanMoveSegmentUp, Mode=OneWay}" Style="{StaticResource ChatOSToolbarButtonStyle}" ToolTipService.ToolTip="上移并重建相邻衔接" />
                                                        <Button Click="OnMoveStorySegmentDownClick" Content="↓" IsEnabled="{x:Bind StoryViewModel.CanMoveSegmentDown, Mode=OneWay}" Style="{StaticResource ChatOSToolbarButtonStyle}" ToolTipService.ToolTip="下移并重建相邻衔接" />
                                                        <Button Click="OnAddStorySegmentClick" Style="{StaticResource ChatOSToolbarButtonStyle}" ToolTipService.ToolTip="添加分段"><FontIcon Glyph="&#xE710;" /></Button>
                                                        <Button Click="OnRemoveStorySegmentClick" Style="{StaticResource ChatOSToolbarButtonStyle}" ToolTipService.ToolTip="移除所选分段"><FontIcon Glyph="&#xE74D;" /></Button>
                                                    </StackPanel>
                                                </Grid>
                                                <ListView
                                                    Grid.Row="1"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    ItemsSource="{x:Bind StoryViewModel.Segments}"
                                                    SelectedItem="{x:Bind StoryViewModel.SelectedSegment, Mode=TwoWay}"
                                                    SelectionMode="Single">
                                                    <ListView.ItemTemplate>
                                                        <DataTemplate x:DataType="media:StorySegmentEditor">
                                                            <Border Margin="0,0,0,7" Padding="10" Background="{StaticResource ChatOSSurfaceSubtleBrush}" CornerRadius="9">
                                                                <Grid ColumnSpacing="10">
                                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{x:Bind NumberLabel, Mode=OneWay}" Foreground="{StaticResource ChatOSPurpleBrush}" Style="{StaticResource ChatOSBodyStrongTextStyle}" />
                                                                    <StackPanel Grid.Column="1" Spacing="3">
                                                                        <Grid ColumnSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="{x:Bind KindLabel, Mode=OneWay}" Foreground="{StaticResource ChatOSPurpleBrush}" Style="{StaticResource ChatOSCaptionTextStyle}" /><TextBlock Grid.Column="1" Text="{x:Bind Title, Mode=OneWay}" TextTrimming="CharacterEllipsis" Style="{StaticResource ChatOSBodyStrongTextStyle}" /></Grid>
                                                                        <TextBlock Text="{x:Bind VideoStatus, Mode=OneWay}" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ListView.ItemTemplate>
                                                </ListView>
                                            </Grid>

                                            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                                                <StackPanel Spacing="12">
                                                    <StackPanel x:Name="StorySegmentEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="9">
                                                        <Border Style="{StaticResource MediaStudioEmptyIconStyle}" Background="{StaticResource ChatOSPurpleSoftBrush}"><FontIcon Glyph="&#xE8FD;" FontSize="30" Foreground="{StaticResource ChatOSPurpleBrush}" /></Border>
                                                        <TextBlock Text="选择或添加一个分段" Style="{StaticResource ChatOSHeadlineTextStyle}" />
                                                    </StackPanel>
                                                    <StackPanel x:Name="StorySegmentEditorPanel" DataContext="{x:Bind StoryViewModel.SelectedSegment, Mode=OneWay}" Spacing="12">
                                                        <TextBox Header="分段标题" MaxLength="200" Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                        <ComboBox Header="分段类型" DisplayMemberPath="Name" ItemsSource="{x:Bind StoryViewModel.SegmentKinds}" SelectedValue="{Binding Kind, Mode=TwoWay}" SelectedValuePath="Kind" />
                                                        <Grid ColumnSpacing="10">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
                                                            <TextBox Header="剧情内容" AcceptsReturn="True" MaxLength="8000" MinHeight="100" Text="{Binding Narrative, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" />
                                                            <NumberBox Grid.Column="1" Header="时长（秒）" Minimum="2" Maximum="15" SpinButtonPlacementMode="Compact" Value="{Binding Seconds, Mode=TwoWay}" />
                                                        </Grid>
                                                        <Button Click="OnRefineStorySegmentClick" Content="AI 细化本段镜头（先生成候选）" HorizontalAlignment="Stretch" IsEnabled="{x:Bind StoryViewModel.CanRefineSelectedSegment, Mode=OneWay}" Style="{StaticResource ChatOSPrimaryButtonStyle}" />
                                                        <Border Padding="12" Background="{StaticResource ChatOSPurpleSoftBrush}" CornerRadius="10" Visibility="{x:Bind StoryViewModel.HasSegmentRefinement, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <StackPanel Spacing="8">
                                                                <TextBlock Text="{x:Bind StoryViewModel.SegmentRefinementTitle, Mode=OneWay}" Style="{StaticResource ChatOSHeadlineTextStyle}" />
                                                                <TextBlock Text="{x:Bind StoryViewModel.SegmentRefinementRationale, Mode=OneWay}" TextWrapping="Wrap" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                                                <TextBox AcceptsReturn="True" IsReadOnly="True" MaxHeight="260" Text="{x:Bind StoryViewModel.SegmentRefinementPreview, Mode=OneWay}" TextWrapping="Wrap" />
                                                                <Grid ColumnSpacing="8">
                                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                                    <Button Click="OnApplyStorySegmentRefinementClick" Content="采用并保存镜头计划" HorizontalAlignment="Stretch" IsEnabled="{x:Bind StoryViewModel.CanApplySegmentRefinement, Mode=OneWay}" Style="{StaticResource ChatOSPrimaryButtonStyle}" />
                                                                    <Button Grid.Column="1" Click="OnDiscardStorySegmentRefinementClick" Content="放弃候选" Style="{StaticResource ChatOSSecondaryButtonStyle}" />
                                                                </Grid>
                                                                <TextBlock Text="已有首帧、尾帧或视频时禁止细化，避免镜头计划与已生成媒体不一致。" TextWrapping="Wrap" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                                            </StackPanel>
                                                        </Border>
                                                        <TextBox Header="衔接起点" AcceptsReturn="True" MaxLength="2000" MinHeight="60" PlaceholderText="人物位置、动作、服装、光线及上一段延续状态" Text="{Binding ContinuityIn, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" />
                                                        <TextBox Header="镜头计划" AcceptsReturn="True" MaxLength="8000" MinHeight="75" PlaceholderText="按时间描述动作、构图与镜头运动" Text="{Binding ShotPlan, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" />
                                                        <TextBox Header="衔接终点" AcceptsReturn="True" MaxLength="2000" MinHeight="60" PlaceholderText="本段结束时留给下一段的人物与画面状态" Text="{Binding ContinuityOut, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" />
                                                        <TextBox Header="画面提示词" AcceptsReturn="True" MaxLength="7000" MinHeight="90" Text="{Binding ImagePrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" />
                                                        <TextBox Header="关联素材 ID（逗号分隔）" PlaceholderText="例如 character-lead, scene-home" Text="{Binding ResourceIdsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                        <Grid ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                            <StackPanel Spacing="6">
                                                                <Button Click="OnGenerateStoryFirstFrameClick" Content="生成首帧" HorizontalAlignment="Stretch" IsEnabled="{x:Bind StoryViewModel.CanGenerateFrame, Mode=OneWay}" Style="{StaticResource ChatOSSecondaryButtonStyle}" />
                                                                <Button Click="OnImportStoryFirstFrameClick" Content="导入首帧" HorizontalAlignment="Stretch" IsEnabled="{x:Bind StoryViewModel.CanImportSegmentAsset, Mode=OneWay}" Style="{StaticResource ChatOSSecondaryButtonStyle}" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1" Spacing="6">
                                                                <Button Click="OnGenerateStoryLastFrameClick" Content="生成尾帧" HorizontalAlignment="Stretch" IsEnabled="{x:Bind StoryViewModel.CanGenerateFrame, Mode=OneWay}" Style="{StaticResource ChatOSSecondaryButtonStyle}" />
                                                                <Button Click="OnImportStoryLastFrameClick" Content="导入尾帧" HorizontalAlignment="Stretch" IsEnabled="{x:Bind StoryViewModel.CanImportSegmentAsset, Mode=OneWay}" Style="{StaticResource ChatOSSecondaryButtonStyle}" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="2" Spacing="6">
                                                                <TextBlock Text="成片末帧" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                                                <Button Click="OnExtractStoryVideoLastFrameClick" Content="从视频提取" HorizontalAlignment="Stretch" IsEnabled="{x:Bind StoryViewModel.CanExtractSelectedVideoLastFrame, Mode=OneWay}" Style="{StaticResource ChatOSSecondaryButtonStyle}" />
                                                            </StackPanel>
                                                        </Grid>
                                                        <Grid ColumnSpacing="10">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                            <Border Height="135" Background="{StaticResource ChatOSSurfaceSubtleBrush}" CornerRadius="10"><Image Source="{Binding FirstFramePath, Converter={StaticResource FilePathToImageSourceConverter}}" Stretch="Uniform" /></Border>
                                                            <Border Grid.Column="1" Height="135" Background="{StaticResource ChatOSSurfaceSubtleBrush}" CornerRadius="10"><Image Source="{Binding LastFramePath, Converter={StaticResource FilePathToImageSourceConverter}}" Stretch="Uniform" /></Border>
                                                            <Border Grid.Column="2" Height="135" Background="{StaticResource ChatOSSurfaceSubtleBrush}" CornerRadius="10"><Image Source="{Binding ActualVideoLastFramePath, Converter={StaticResource FilePathToImageSourceConverter}}" Stretch="Uniform" /></Border>
                                                        </Grid>
                                                        <Expander Header="首尾帧历史版本" IsEnabled="{x:Bind StoryViewModel.CanRestoreArchivedFrame, Mode=OneWay}">
                                                            <ItemsControl ItemsSource="{Binding ArchivedFrames}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate x:DataType="media:StoryArchivedFrameEditor">
                                                                        <Grid Margin="0,4" ColumnSpacing="8">
                                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                                            <TextBlock VerticalAlignment="Center" Text="{x:Bind Label}" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                                                            <Button Grid.Column="1" Click="OnRestoreStoryFrameVersionClick" Content="恢复" Style="{StaticResource ChatOSSecondaryButtonStyle}" />
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </Expander>
                                                        <TextBox Header="视频提示词" AcceptsReturn="True" MaxLength="7000" MinHeight="90" Text="{Binding VideoPrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" />
                                                        <Grid ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                            <Button Click="OnGenerateStoryVideoClick" Content="{x:Bind StoryViewModel.GenerateVideoActionLabel, Mode=OneWay}" IsEnabled="{x:Bind StoryViewModel.CanGenerateVideo, Mode=OneWay}" Style="{StaticResource ChatOSPrimaryButtonStyle}" />
                                                            <Button Grid.Column="1" Click="OnImportStoryVideoClick" Content="导入视频" IsEnabled="{x:Bind StoryViewModel.CanImportSegmentAsset, Mode=OneWay}" Style="{StaticResource ChatOSSecondaryButtonStyle}" />
                                                            <Button Grid.Column="2" Click="OnCancelStoryGenerationClick" Content="停止等待" IsEnabled="{x:Bind StoryViewModel.IsBusy, Mode=OneWay}" Style="{StaticResource ChatOSSecondaryButtonStyle}" />
                                                        </Grid>
                                                        <TextBlock Text="{x:Bind StoryViewModel.SelectedVideoJobLabel, Mode=OneWay}" TextWrapping="Wrap" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                                        <Grid ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                            <Button Click="OnResumeStoryVideoClick" Content="继续查询并下载已有任务" IsEnabled="{x:Bind StoryViewModel.CanResumeSelectedVideo, Mode=OneWay}" Style="{StaticResource ChatOSPrimaryButtonStyle}" />
                                                            <Button Grid.Column="1" Click="OnAbandonStoryVideoJobClick" Content="清除任务记录" IsEnabled="{x:Bind StoryViewModel.CanAbandonSelectedVideoJob, Mode=OneWay}" Style="{StaticResource ChatOSSecondaryButtonStyle}" ToolTipService.ToolTip="只有确认不再需要服务端旧任务时才清除；清除后允许重新提交并可能再次计费。" />
                                                        </Grid>
                                                        <TextBlock Text="{x:Bind StoryViewModel.VideoProgressLabel, Mode=OneWay}" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                                        <MediaPlayerElement x:Name="StoryVideoPlayer" Height="220" AreTransportControlsEnabled="True" AutoPlay="False" Stretch="Uniform" />
                                                        <Expander Header="视频历史版本" IsEnabled="{x:Bind StoryViewModel.CanRestoreArchivedVideo, Mode=OneWay}">
                                                            <ItemsControl ItemsSource="{Binding ArchivedVideos}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate x:DataType="media:StoryArchivedVideoEditor">
                                                                        <Grid Margin="0,4" ColumnSpacing="8">
                                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                                            <StackPanel><TextBlock Text="{x:Bind Label}" Style="{StaticResource ChatOSBodyStrongTextStyle}" /><TextBlock Text="{x:Bind ArchivedAtLabel}" Style="{StaticResource ChatOSCaptionTextStyle}" /></StackPanel>
                                                                            <Button Grid.Column="1" Click="OnRestoreStoryVideoVersionClick" Content="恢复此版本" Style="{StaticResource ChatOSSecondaryButtonStyle}" />
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </Expander>
                                                    </StackPanel>
                                                </StackPanel>
                                            </ScrollViewer>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </PivotItem>

                <PivotItem Header="记录">
                    <ScrollViewer AutomationProperties.AutomationId="ChatOS.MediaStudio.History" VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="1180" HorizontalAlignment="Center" Spacing="22">
                            <StackPanel Spacing="4">
                                <TextBlock Text="创作记录" FontSize="24" FontWeight="SemiBold" />
                                <TextBlock Text="图片、视频和剧情作品均已自动保存到本机" Style="{StaticResource ChatOSCaptionTextStyle}" />
                            </StackPanel>

                            <StackPanel x:Name="HistoryLoadingState" MinHeight="360" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                                <ProgressRing Width="34" Height="34" IsActive="True" />
                                <TextBlock Text="正在加载创作记录" Style="{StaticResource ChatOSCaptionTextStyle}" />
                            </StackPanel>

                            <StackPanel x:Name="HistoryEmptyState" MinHeight="420" HorizontalAlignment="Stretch" VerticalAlignment="Center" Spacing="14">
                                <Border Style="{StaticResource MediaStudioEmptyIconStyle}" Background="{StaticResource ChatOSPurpleSoftBrush}">
                                    <FontIcon Glyph="&#xE823;" FontSize="30" Foreground="{StaticResource ChatOSPurpleBrush}" />
                                </Border>
                                <TextBlock HorizontalAlignment="Center" Text="还没有创作记录" Style="{StaticResource ChatOSHeadlineTextStyle}" />
                                <TextBlock HorizontalAlignment="Center" Text="生成图片、视频或剧情作品后，会统一显示在这里。" Style="{StaticResource ChatOSCaptionTextStyle}" />
                            </StackPanel>

                            <StackPanel x:Name="StoryHistorySection" Spacing="12">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="剧情作品" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock Text="按项目查看剧情分段进度，打开后可播放和继续制作。" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                </StackPanel>
                                <ItemsControl ItemsSource="{x:Bind StoryViewModel.Projects}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="media:StoryProjectCard">
                                            <Border Margin="0,0,0,14" Style="{StaticResource MediaStudioCardStyle}">
                                                <StackPanel Spacing="14">
                                                    <Grid ColumnSpacing="14">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                        <Border Width="44" Height="44" Background="{StaticResource ChatOSPurpleSoftBrush}" CornerRadius="12">
                                                            <FontIcon Glyph="&#xE714;" Foreground="{StaticResource ChatOSPurpleBrush}" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Spacing="4">
                                                            <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" Style="{StaticResource ChatOSHeadlineTextStyle}" />
                                                            <TextBlock Text="{x:Bind MediaSummary}" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                                            <TextBlock Text="{x:Bind Description}" MaxLines="2" TextWrapping="Wrap" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" HorizontalAlignment="Right" Spacing="7">
                                                            <TextBlock HorizontalAlignment="Right" Text="{x:Bind UpdatedAtLabel}" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                                <Button Click="OnStoryHistoryProjectClick" Content="打开项目" Style="{StaticResource ChatOSSecondaryButtonStyle}" />
                                                                <Button Click="OnStoryHistoryPlayClick" Content="{x:Bind PlayActionLabel}" IsEnabled="{x:Bind CanPlay}" Style="{StaticResource ChatOSPrimaryButtonStyle}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Grid>
                                                    <ItemsControl ItemsSource="{x:Bind PreviewImages}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="1" /></ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="media:StoryProjectThumbnail">
                                                                <Border Width="132" Height="92" Margin="0,0,11,0" Background="{StaticResource ChatOSSurfaceSubtleBrush}" CornerRadius="9">
                                                                    <Image Source="{Binding FilePath, Converter={StaticResource FilePathToImageSourceConverter}}" Stretch="UniformToFill" />
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button HorizontalAlignment="Center" Click="OnLoadMoreStoryProjectsClick" Content="加载更早剧情"
                                        Style="{StaticResource ChatOSSecondaryButtonStyle}"
                                        IsEnabled="{x:Bind StoryViewModel.CanLoadMoreProjects, Mode=OneWay}"
                                        Visibility="{x:Bind StoryViewModel.HasMoreProjects, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>

                            <StackPanel x:Name="VideoHistorySection" Spacing="12">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="视频" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock Text="独立视频创作结果" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                </StackPanel>
                                <ItemsControl ItemsSource="{x:Bind ViewModel.VideoHistory}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="media:MediaStudioVideoHistoryItem">
                                            <Border Margin="0,0,0,10" Style="{StaticResource MediaStudioCardStyle}">
                                                <Grid ColumnSpacing="16">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <Border Width="44" Height="44" Background="{StaticResource ChatOSPurpleSoftBrush}" CornerRadius="12">
                                                        <FontIcon Glyph="&#xE714;" Foreground="{StaticResource ChatOSPurpleBrush}" />
                                                    </Border>
                                                    <Button Grid.Column="1" Padding="0" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" Click="OnVideoHistoryCardClick">
                                                        <StackPanel Spacing="5">
                                                            <TextBlock Text="{x:Bind Prompt}" MaxLines="2" TextWrapping="Wrap" Style="{StaticResource ChatOSHeadlineTextStyle}" />
                                                            <TextBlock Text="{x:Bind ModelName}" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                                            <TextBlock Text="{x:Bind CreatedAtLabel}" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Grid.Column="2" Click="OnSaveVideoClick" Content="另存为" Style="{StaticResource ChatOSSecondaryButtonStyle}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button HorizontalAlignment="Center" Click="OnLoadMoreVideoHistoryClick" Content="加载更早视频"
                                        Style="{StaticResource ChatOSSecondaryButtonStyle}"
                                        IsEnabled="{x:Bind ViewModel.CanLoadMoreVideoHistory, Mode=OneWay}"
                                        Visibility="{x:Bind ViewModel.HasMoreVideoHistory, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>

                            <StackPanel x:Name="ImageHistorySection" Spacing="12">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="图片" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock Text="独立图片创作结果" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                </StackPanel>
                                <ItemsControl ItemsSource="{x:Bind ViewModel.History}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="media:MediaStudioHistoryItem">
                                            <Button Margin="0,0,0,10" Padding="0" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" Click="OnImageHistoryCardClick">
                                                <Border Style="{StaticResource MediaStudioCardStyle}">
                                                    <Grid ColumnSpacing="16">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                        <ItemsControl ItemsSource="{x:Bind Images}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="1" /></ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="media:MediaStudioImageItem">
                                                                    <Image Width="76" Height="76" Margin="0,0,6,0" Source="{Binding FilePath, Converter={StaticResource FilePathToImageSourceConverter}}" Stretch="UniformToFill" />
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5">
                                                            <TextBlock Text="{x:Bind Prompt}" MaxLines="3" TextWrapping="Wrap" Style="{StaticResource ChatOSHeadlineTextStyle}" />
                                                            <TextBlock Text="{x:Bind ModelName}" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                                            <TextBlock Text="{x:Bind CreatedAtLabel}" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                                        </StackPanel>
                                                        <FontIcon Grid.Column="2" VerticalAlignment="Center" Glyph="&#xE76C;" Foreground="{StaticResource ChatOSSecondaryTextBrush}" />
                                                    </Grid>
                                                </Border>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button HorizontalAlignment="Center" Click="OnLoadMoreHistoryClick" Content="加载更早图片"
                                        Style="{StaticResource ChatOSSecondaryButtonStyle}"
                                        IsEnabled="{x:Bind ViewModel.CanLoadMoreHistory, Mode=OneWay}"
                                        Visibility="{x:Bind ViewModel.HasMoreHistory, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </PivotItem>
            </Pivot>
        </Grid>
    </Grid>
</Page>
