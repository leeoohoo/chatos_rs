[Version]
Signature="$WINDOWS NT$"
Class=WFPCALLOUTS
ClassGuid={57465043-616C-6C6F-7574-5F636C617373}
Provider=%ProviderName%
DriverVer=08/30/2026,1.0.0.0
CatalogFile=ChatOS.NetworkGuard.Driver.cat
PnpLockdown=1

[DefaultInstall.NTamd64]
CopyFiles=DriverCopy

[DefaultInstall.NTarm64]
CopyFiles=DriverCopy

[DefaultInstall.NTamd64.Services]
AddService=ChatOSNetworkGuard,0x00000002,ServiceInstall

[DefaultInstall.NTarm64.Services]
AddService=ChatOSNetworkGuard,0x00000002,ServiceInstall

[DefaultUninstall.NTamd64]
DelFiles=DriverCopy

[DefaultUninstall.NTarm64]
DelFiles=DriverCopy

[DefaultUninstall.NTamd64.Services]
DelService=ChatOSNetworkGuard,0x200

[DefaultUninstall.NTarm64.Services]
DelService=ChatOSNetworkGuard,0x200

[DestinationDirs]
DriverCopy=12

[DriverCopy]
ChatOS.NetworkGuard.Driver.sys

[ServiceInstall]
DisplayName=%ServiceName%
ServiceType=1
StartType=2
ErrorControl=1
ServiceBinary=%12%\ChatOS.NetworkGuard.Driver.sys
LoadOrderGroup=PNP_TDI

[Strings]
ProviderName="ChatOS"
ServiceName="ChatOS NetworkGuard Driver"
