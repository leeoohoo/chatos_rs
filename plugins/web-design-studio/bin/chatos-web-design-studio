#!/usr/bin/env node

const command = process.argv[2];
const entry = command === 'studio' || command === 'serve'
  ? '../dist/studio-server.mjs'
  : '../dist/mcp-server.mjs';

import(entry).catch((error) => {
  const message = error instanceof Error ? error.message : String(error);
  process.stderr.write(`Failed to start Web Design Studio: ${message}\n`);
  process.exitCode = 1;
});
