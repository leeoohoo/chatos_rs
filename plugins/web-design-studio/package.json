    "@tiptap/starter-kit": "3.6.6",
    "@uiw/color-convert": "^2.10.3",
    "@vueuse/core": "14.2.1",
    "antd": "6.6.2",
    "canvas-confetti": "^1.9.3",
    "class-variance-authority": "0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cobe": "^0.6.4",
