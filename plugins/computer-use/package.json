{
  "name": "open-computer-use",
  "version": "0.9.0",
  "description": "Visual-first macOS and Windows Computer Use MCP server for ChatOS.",
  "license": "MIT",
  "bin": {
    "open-computer-use": "bin/open-computer-use"
  },
  "scripts": {
    "test": "swift test",
    "test:packaging": "node --test ./scripts/package-support.test.mjs ./scripts/skill-platform-support.test.mjs",
    "audit:skill-gates": "node ../../scripts/audit-plugin-skill-gates.mjs --manifest chatos.plugin.json --cwd . -- swift run visual-computer-use-mcp",
    "build:app": "./scripts/build-macos-app.sh",
    "build:windows": "node ./scripts/build-windows-worker.mjs",
    "smoke:windows": "node ./scripts/smoke-windows-worker.mjs",
    "pack:chatos": "npm run audit:skill-gates && node ./scripts/build-chatos-package.mjs"
  },
  "files": [
    "bin/",
    "chatos.plugin.json",
    "dist/Visual Computer Use.app/",
    "skills/",
    "README.md",
    "LICENSE"
  ]
}
