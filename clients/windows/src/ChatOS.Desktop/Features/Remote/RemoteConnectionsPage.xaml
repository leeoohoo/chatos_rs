<UserControl
    x:Class="ChatOS.Desktop.Features.Remote.RemoteConnectionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:ChatOS.Core.Domain"
    xmlns:remote="using:ChatOS.Presentation.Remote">
    <Grid Background="{StaticResource ChatOSContentBackgroundBrush}">
        <Grid.RowDefinitions><RowDefinition Height="54" /><RowDefinition Height="1" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid Padding="16,0" ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Spacing="2"><TextBlock Text="{x:Bind Localization.RemoteConnections, Mode=OneWay}" Style="{StaticResource ChatOSHeadlineTextStyle}" /><TextBlock Text="{x:Bind Localization.RemoteCredentialNotice, Mode=OneWay}" Style="{StaticResource ChatOSCaptionTextStyle}" /></StackPanel>
            <Button Grid.Column="1" Command="{x:Bind ViewModel.NewCommand}" Content="{x:Bind Localization.New, Mode=OneWay}" />
            <Button Grid.Column="2" Click="OnOpenSftpClick" Content="{x:Bind Localization.SftpFiles, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.IsEditingExisting, Mode=OneWay}" />
            <Button Grid.Column="3" Click="OnOpenTerminalClick" Content="{x:Bind Localization.RemoteTerminal, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.IsEditingExisting, Mode=OneWay}" />
            <Button Grid.Column="4" Click="OnRefreshClick" Style="{StaticResource ChatOSToolbarButtonStyle}"><FontIcon Glyph="&#xE72C;" /></Button>
        </Grid>
        <Border Grid.Row="1" Background="{StaticResource ChatOSBorderBrush}" />
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="280" /><ColumnDefinition Width="1" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <ListView ItemsSource="{x:Bind ViewModel.Connections}" IsItemClickEnabled="True" ItemClick="OnConnectionClick" Padding="10" SelectionMode="Single">
                <ListView.ItemTemplate><DataTemplate x:DataType="core:RemoteConnection">
                    <Grid Padding="6" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="26" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><FontIcon Glyph="&#xE968;" FontSize="13" /><StackPanel Grid.Column="1" Spacing="2"><TextBlock Text="{x:Bind Name}" Style="{StaticResource ChatOSBodyStrongTextStyle}" /><TextBlock><Run Text="{x:Bind Username}" /><Run Text="@" /><Run Text="{x:Bind Host}" /></TextBlock></StackPanel></Grid>
                </DataTemplate></ListView.ItemTemplate>
            </ListView>
            <Border Grid.Column="1" Background="{StaticResource ChatOSBorderBrush}" />
            <ScrollViewer Grid.Column="2" Padding="20" VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="760" HorizontalAlignment="Center" Spacing="16">
                    <TextBlock Text="{x:Bind Localization.ConnectionInformation, Mode=OneWay}" Style="{StaticResource ChatOSSectionLabelTextStyle}" />
                    <Border Style="{StaticResource ChatOSCardStyle}"><Grid RowSpacing="12" ColumnSpacing="12">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="140" /></Grid.ColumnDefinitions>
                        <TextBox Header="{x:Bind Localization.Name, Mode=OneWay}" Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Production server" /><ComboBox x:Name="WorkspacePicker" Grid.Column="1" Header="{x:Bind Localization.LocalWorkspace, Mode=OneWay}" ItemsSource="{x:Bind ViewModel.Workspaces}" DisplayMemberPath="Label" SelectedItem="{x:Bind ViewModel.SelectedWorkspace, Mode=TwoWay}" />
                        <TextBox Grid.Row="1" Header="{x:Bind Localization.Host, Mode=OneWay}" Text="{x:Bind ViewModel.Host, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="server.example.com" /><NumberBox Grid.Row="1" Grid.Column="1" Header="{x:Bind Localization.Port, Mode=OneWay}" Minimum="1" Maximum="65535" Value="{x:Bind ViewModel.Port, Mode=TwoWay}" />
                        <TextBox Grid.Row="2" Header="{x:Bind Localization.Username, Mode=OneWay}" Text="{x:Bind ViewModel.Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" /><ComboBox x:Name="AuthenticationPicker" Grid.Row="2" Grid.Column="1" Header="{x:Bind Localization.AuthenticationMethod, Mode=OneWay}" SelectionChanged="OnAuthenticationChanged"><ComboBoxItem Content="{x:Bind Localization.PrivateKey, Mode=OneWay}" Tag="PrivateKey" /><ComboBoxItem Content="{x:Bind Localization.PrivateKeyAndCertificate, Mode=OneWay}" Tag="PrivateKeyCertificate" /><ComboBoxItem Content="{x:Bind Localization.Password, Mode=OneWay}" Tag="Password" /></ComboBox>
                        <PasswordBox x:Name="PasswordInput" Grid.Row="3" Grid.ColumnSpan="2" Header="{x:Bind Localization.LocalOnlyPassword, Mode=OneWay}" PasswordChanged="OnPasswordChanged" />
                        <Grid x:Name="KeyFields" Grid.Row="4" Grid.ColumnSpan="2" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox Header="{x:Bind Localization.PrivateKeyPath, Mode=OneWay}" Text="{x:Bind ViewModel.PrivateKeyPath, Mode=TwoWay}" /><Button Grid.Column="1" Tag="private" Click="OnPickKeyClick" VerticalAlignment="Bottom" Content="{x:Bind Localization.Select, Mode=OneWay}" /><TextBox Grid.Column="2" Header="{x:Bind Localization.CertificatePath, Mode=OneWay}" Text="{x:Bind ViewModel.CertificatePath, Mode=TwoWay}" /><Button Grid.Column="3" Tag="certificate" Click="OnPickKeyClick" VerticalAlignment="Bottom" Content="{x:Bind Localization.Select, Mode=OneWay}" /></Grid>
                        <Grid Grid.Row="5" Grid.ColumnSpan="2" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions><TextBox Header="{x:Bind Localization.DefaultRemoteDirectory, Mode=OneWay}" Text="{x:Bind ViewModel.DefaultRemotePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="/srv/app" /><ComboBox x:Name="HostKeyPicker" Grid.Column="1" Header="{x:Bind Localization.HostKeyPolicy, Mode=OneWay}" SelectionChanged="OnHostKeyPolicyChanged"><ComboBoxItem Content="{x:Bind Localization.StrictVerification, Mode=OneWay}" Tag="Strict" /><ComboBoxItem Content="{x:Bind Localization.AcceptFirstUse, Mode=OneWay}" Tag="AcceptNew" /></ComboBox></Grid>
                    </Grid></Border>
                    <TextBlock Text="{x:Bind Localization.JumpHost, Mode=OneWay}" Style="{StaticResource ChatOSSectionLabelTextStyle}" />
                    <Border Style="{StaticResource ChatOSCardStyle}"><StackPanel Spacing="12"><ToggleSwitch x:Name="JumpSwitch" Header="{x:Bind Localization.ConnectThroughJumpHost, Mode=OneWay}" IsOn="{x:Bind ViewModel.JumpEnabled, Mode=TwoWay}" Toggled="OnJumpToggled" /><StackPanel x:Name="JumpFields" Spacing="12"><ComboBox x:Name="JumpConnectionPicker" Header="{x:Bind Localization.ReuseSavedConnection, Mode=OneWay}" ItemsSource="{x:Bind ViewModel.Connections}" DisplayMemberPath="Name" SelectionChanged="OnJumpConnectionChanged" /><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBox Header="{x:Bind Localization.JumpHostAddress, Mode=OneWay}" Text="{x:Bind ViewModel.JumpHost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" /><NumberBox Grid.Column="1" Header="{x:Bind Localization.Port, Mode=OneWay}" Minimum="1" Maximum="65535" Value="{x:Bind ViewModel.JumpPort, Mode=TwoWay}" /><TextBox Grid.Column="2" Header="{x:Bind Localization.Username, Mode=OneWay}" Text="{x:Bind ViewModel.JumpUsername, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" /></Grid><PasswordBox x:Name="JumpPasswordInput" Header="{x:Bind Localization.JumpHostLocalOnlyPassword, Mode=OneWay}" PasswordChanged="OnJumpPasswordChanged" /><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox Header="{x:Bind Localization.JumpHostPrivateKey, Mode=OneWay}" Text="{x:Bind ViewModel.JumpPrivateKeyPath, Mode=TwoWay}" /><Button Grid.Column="1" Tag="jump-private" Click="OnPickKeyClick" VerticalAlignment="Bottom" Content="{x:Bind Localization.Select, Mode=OneWay}" /><TextBox Grid.Column="2" Header="{x:Bind Localization.JumpHostCertificate, Mode=OneWay}" Text="{x:Bind ViewModel.JumpCertificatePath, Mode=TwoWay}" /><Button Grid.Column="3" Tag="jump-certificate" Click="OnPickKeyClick" VerticalAlignment="Bottom" Content="{x:Bind Localization.Select, Mode=OneWay}" /></Grid></StackPanel></StackPanel></Border>
                    <Border Padding="12" Background="{StaticResource ChatOSProcessBackgroundBrush}" CornerRadius="8" Visibility="{x:Bind ViewModel.HasVerificationChallenge, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"><StackPanel Spacing="8"><TextBlock Text="{x:Bind ViewModel.VerificationPrompt, Mode=OneWay}" Style="{StaticResource ChatOSBodyStrongTextStyle}" TextWrapping="Wrap" /><TextBox PlaceholderText="{x:Bind Localization.VerificationCodePlaceholder, Mode=OneWay}" Text="{x:Bind ViewModel.VerificationCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" /></StackPanel></Border>
                    <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Button Click="OnDeleteClick" Content="{x:Bind Localization.Delete, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsEditingExisting, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" /><ProgressRing Grid.Column="1" Width="20" Height="20" HorizontalAlignment="Right" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" /><Button Grid.Column="2" Command="{x:Bind ViewModel.TestCommand}" Content="{x:Bind Localization.TestConnection, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.CanSave, Mode=OneWay}" /><Button Grid.Column="3" Command="{x:Bind ViewModel.SaveCommand}" Content="{x:Bind Localization.Save, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.CanSave, Mode=OneWay}" Style="{StaticResource ChatOSPrimaryButtonStyle}" /></Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <StackPanel Grid.Row="3" Margin="14,6" Spacing="3"><TextBlock Text="{x:Bind ViewModel.ActionMessage, Mode=OneWay}" Foreground="{StaticResource ChatOSSuccessBrush}" Visibility="{x:Bind ViewModel.ActionMessage, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" /><TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" Foreground="{StaticResource ChatOSFailureBrush}" TextWrapping="Wrap" Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" /></StackPanel>
    </Grid>
</UserControl>
