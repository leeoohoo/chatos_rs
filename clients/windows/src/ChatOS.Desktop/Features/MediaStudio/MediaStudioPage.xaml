                                                        </DataTemplate>
                                                    </ListView.ItemTemplate>
                                                </ListView>
                                                <StackPanel x:Name="StoryResourceEmptyState"><TextBlock Text="添加角色、场景或道具，或使用 AI 全剧规划自动建立素材表。" TextWrapping="Wrap" Style="{StaticResource ChatOSCaptionTextStyle}" /></StackPanel>
                                                <StackPanel x:Name="StoryResourceEditorPanel" DataContext="{x:Bind StoryViewModel.SelectedResource, Mode=OneWay}" Spacing="9">
                                                    <ComboBox Header="类型" ItemsSource="{x:Bind StoryViewModel.ResourceKinds}" SelectedItem="{Binding Kind, Mode=TwoWay}" />
                                                    <TextBox Header="名称" MaxLength="200" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    <TextBox Header="文字画像 / 说明" AcceptsReturn="True" MaxLength="8000" MinHeight="70" Text="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" />
                                                    <TextBox Header="参考图提示词" AcceptsReturn="True" MaxLength="7000" MinHeight="70" Text="{Binding ImagePrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" />
                                                    <Grid ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                        <Button Click="OnGenerateStoryResourceImageClick" Content="生成参考图" IsEnabled="{x:Bind StoryViewModel.CanGenerateResourceImage, Mode=OneWay}" Style="{StaticResource ChatOSSecondaryButtonStyle}" />
                                                        <Button Grid.Column="1" Click="OnImportStoryResourceImageClick" Content="导入本地图片" IsEnabled="{x:Bind StoryViewModel.CanImportResourceAsset, Mode=OneWay}" Style="{StaticResource ChatOSSecondaryButtonStyle}" />
