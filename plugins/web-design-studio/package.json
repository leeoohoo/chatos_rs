    "@types/express": "5.0.3",
    "@types/node": "24.5.2",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@types/three": "^0.183.1",
