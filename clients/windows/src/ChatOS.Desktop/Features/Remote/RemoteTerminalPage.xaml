<UserControl x:Class="ChatOS.Desktop.Features.Remote.RemoteTerminalPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:remote="using:ChatOS.Presentation.Remote">
    <Grid Background="{StaticResource ChatOSContentBackgroundBrush}">
        <Grid.RowDefinitions><RowDefinition Height="54" /><RowDefinition Height="1" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid Padding="14,0" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Button Click="OnBackClick" Style="{StaticResource ChatOSToolbarButtonStyle}"><FontIcon Glyph="&#xE72B;" /></Button><TextBlock Grid.Column="1" Margin="6,0" VerticalAlignment="Center" Text="{x:Bind ViewModel.ConnectionName, Mode=OneWay}" Style="{StaticResource ChatOSHeadlineTextStyle}" /><TextBlock Grid.Column="2" Margin="12,0" VerticalAlignment="Center" Text="{x:Bind ViewModel.WorkingDirectory, Mode=OneWay}" FontFamily="Cascadia Mono, Consolas" TextTrimming="CharacterEllipsis" /><ProgressRing Grid.Column="3" Width="20" Height="20" IsActive="{x:Bind ViewModel.IsRunning, Mode=OneWay}" /><Button Grid.Column="4" Command="{x:Bind ViewModel.CancelCommand}" Content="{x:Bind Localization.Cancel, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.IsRunning, Mode=OneWay}" /></Grid>
        <Border Grid.Row="1" Background="{StaticResource ChatOSBorderBrush}" />
        <ListView x:Name="OutputList" Grid.Row="2" ItemsSource="{x:Bind ViewModel.Lines}" SelectionMode="None" Padding="16"><ListView.ItemTemplate><DataTemplate x:DataType="remote:RemoteTerminalLine"><TextBlock Text="{x:Bind Text}" FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" /></DataTemplate></ListView.ItemTemplate></ListView>
        <StackPanel Grid.Row="3" Padding="14,8" Spacing="8"><Border Padding="10" Background="{StaticResource ChatOSProcessBackgroundBrush}" CornerRadius="8" Visibility="{x:Bind ViewModel.HasVerificationChallenge, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"><StackPanel Spacing="6"><TextBlock Text="{x:Bind ViewModel.VerificationPrompt, Mode=OneWay}" /><TextBox PlaceholderText="{x:Bind Localization.RemoteVerificationRetryPlaceholder, Mode=OneWay}" Text="{x:Bind ViewModel.VerificationCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" /></StackPanel></Border><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox x:Name="CommandInput" Text="{x:Bind ViewModel.Command, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{x:Bind Localization.RemoteCommandPlaceholder, Mode=OneWay}" FontFamily="Cascadia Mono, Consolas" KeyDown="OnCommandKeyDown" /><Button Grid.Column="1" Command="{x:Bind ViewModel.SubmitCommand}" Content="{x:Bind Localization.Execute, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.CanSubmit, Mode=OneWay}" Style="{StaticResource ChatOSPrimaryButtonStyle}" /></Grid><TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" Foreground="{StaticResource ChatOSFailureBrush}" TextWrapping="Wrap" Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" /></StackPanel>
    </Grid>
</UserControl>
