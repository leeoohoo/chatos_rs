#!/usr/bin/env node
const [major, minor] = process.versions.node.split('.').map(Number);
if (major < 22 || (major === 22 && minor < 13)) {
  process.stderr.write('Project Management requires Node.js >= 22.13 with node:sqlite.\n');
  process.exit(1);
}
const mode = process.argv[2];
if (!['mcp', 'studio'].includes(mode)) {
  process.stderr.write('Usage: chatos-project-management <mcp|studio>\n');
  process.exit(1);
}
import(`../dist/${mode}.mjs`).catch(error => {
  process.stderr.write(`${error.message}\n`);
  process.exitCode = 1;
});
