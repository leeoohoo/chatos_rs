<Page
    x:Class="ChatOS.Desktop.Features.MediaStudio.MediaStudioPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:ChatOS.Core.Domain"
    xmlns:media="using:ChatOS.Desktop.Features.MediaStudio"
    AutomationProperties.AutomationId="ChatOS.MediaStudio.Root"
    AutomationProperties.Name="AI 创作">

    <Page.Resources>
        <media:FilePathToImageSourceConverter x:Key="FilePathToImageSourceConverter" />
        <Style x:Key="MediaStudioCardStyle" TargetType="Border" BasedOn="{StaticResource ChatOSSectionCardStyle}">
            <Setter Property="CornerRadius" Value="16" />
        </Style>
        <Style x:Key="MediaStudioEmptyIconStyle" TargetType="Border" BasedOn="{StaticResource ChatOSEmptyStateIconStyle}">
            <Setter Property="Width" Value="84" />
            <Setter Property="Height" Value="84" />
            <Setter Property="CornerRadius" Value="24" />
        </Style>
    </Page.Resources>

    <Grid Background="{StaticResource ChatOSWorkspaceBackgroundBrush}">
        <Rectangle IsHitTestVisible="False" Opacity="0.08">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Offset="0" Color="#7057D8" />
                    <GradientStop Offset="0.48" Color="Transparent" />
                    <GradientStop Offset="1" Color="#0A7AFF" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Grid RowSpacing="0">
            <Grid.RowDefinitions><RowDefinition Height="68" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>

            <Grid Padding="20,0" ColumnSpacing="14" Background="{StaticResource ChatOSTitleBarBackgroundBrush}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <Border Width="38" Height="38" CornerRadius="11">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#7657E8" Offset="0" />
                                <GradientStop Color="#E45AA7" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <FontIcon Glyph="&#xE735;" FontSize="18" Foreground="White" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="AI 创作" Style="{StaticResource ChatOSPageTitleTextStyle}" />
                        <TextBlock Text="独立于聊天的图片与视频工作台" Style="{StaticResource ChatOSCaptionTextStyle}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="10">
                    <SelectorBar x:Name="StudioSectionBar" Width="430" SelectionChanged="OnStudioSectionChanged">
                        <SelectorBarItem x:Name="ImageSectionItem" Text="图片" IsSelected="True" />
                        <SelectorBarItem x:Name="VideoSectionItem" Text="视频" />
                        <SelectorBarItem x:Name="StorySectionItem" Text="剧情模式" />
                        <SelectorBarItem x:Name="HistorySectionItem" Text="记录" />
                    </SelectorBar>
                    <TextBlock MaxWidth="160" VerticalAlignment="Center" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" TextTrimming="CharacterEllipsis" Style="{StaticResource ChatOSCaptionTextStyle}" />
                    <ProgressRing Width="20" Height="20" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                    <Button AutomationProperties.AutomationId="ChatOS.MediaStudio.Refresh" AutomationProperties.Name="刷新模型" Click="OnReloadModelsClick" Style="{StaticResource ChatOSToolbarButtonStyle}" ToolTipService.ToolTip="刷新模型">
                        <FontIcon Glyph="&#xE72C;" />
                    </Button>
                </StackPanel>
            </Grid>

            <InfoBar x:Name="ErrorInfoBar" Grid.Row="1" Margin="20,10,20,0" IsClosable="False" Severity="Error" />

            <Pivot x:Name="StudioPivot" Grid.Row="2" Margin="20,18,20,20" SelectionChanged="OnStudioPivotSelectionChanged">
                <Pivot.Resources>
                    <Style TargetType="PivotHeaderItem"><Setter Property="Visibility" Value="Collapsed" /></Style>
                </Pivot.Resources>
                <PivotItem Header="图片创作">
                    <Grid ColumnSpacing="18">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="356" /></Grid.ColumnDefinitions>

                        <Border Style="{StaticResource MediaStudioCardStyle}" Padding="0">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="62" /><RowDefinition Height="1" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <Grid Padding="18,0">
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="图片画布" Style="{StaticResource ChatOSHeadlineTextStyle}" />
                                        <TextBlock Text="最新一批生成结果" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                    </StackPanel>
                                </Grid>
                                <Border Grid.Row="1" Background="{StaticResource ChatOSBorderBrush}" />

                                <Grid Grid.Row="2">
                                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <GridView
                                        x:Name="LatestImageGrid"
                                        Padding="16"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        ItemsSource="{x:Bind ViewModel.LatestImages}"
                                        SizeChanged="OnLatestImageGridSizeChanged"
                                        SelectionMode="None">
                                        <GridView.ItemsPanel>
                                            <ItemsPanelTemplate><ItemsWrapGrid ItemWidth="340" Orientation="Horizontal" /></ItemsPanelTemplate>
                                        </GridView.ItemsPanel>
                                        <GridView.ItemTemplate>
                                            <DataTemplate x:DataType="media:MediaStudioImageItem">
                                                <Border MinWidth="280" Margin="0,0,12,12" Padding="8" HorizontalAlignment="Stretch" Background="{StaticResource ChatOSSurfaceSubtleBrush}" CornerRadius="13">
                                                    <Grid>
                                                        <Image Height="300" Source="{Binding FilePath, Converter={StaticResource FilePathToImageSourceConverter}}" Stretch="Uniform" />
                                                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal" Spacing="5">
                                                            <Button Click="OnUseImageForVideoClick" Style="{StaticResource ChatOSToolbarButtonStyle}" ToolTipService.ToolTip="用作视频首帧"><FontIcon Glyph="&#xE714;" /></Button>
                                                            <Button Click="OnSaveImageClick" Style="{StaticResource ChatOSToolbarButtonStyle}" ToolTipService.ToolTip="另存为"><FontIcon Glyph="&#xE74E;" /></Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </GridView.ItemTemplate>
                                    </GridView>

                                    <Border x:Name="LatestImagePromptPanel" Grid.Row="1" Margin="18,0,18,18" Padding="13" Background="{StaticResource ChatOSSurfaceSubtleBrush}" CornerRadius="11" DataContext="{x:Bind ViewModel.LatestImageBatch, Mode=OneWay}">
                                        <StackPanel Spacing="5">
                                            <TextBlock Text="提示词" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                            <TextBlock Text="{Binding Prompt}" IsTextSelectionEnabled="True" TextWrapping="Wrap" Style="{StaticResource ChatOSSecondaryBodyTextStyle}" />
                                        </StackPanel>
                                    </Border>

                                    <StackPanel x:Name="CanvasEmptyState" Grid.RowSpan="2" MaxWidth="520" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                                        <Border Style="{StaticResource MediaStudioEmptyIconStyle}">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#7657E8" Offset="0" />
                                                    <GradientStop Color="#E45AA7" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <FontIcon Glyph="&#xEB9F;" FontSize="34" Foreground="White" />
                                        </Border>
                                        <TextBlock HorizontalAlignment="Center" Text="描述想象中的画面" Style="{StaticResource ChatOSHeadlineTextStyle}" />
                                        <TextBlock Text="选择图片模型、填写提示词并生成；图片不会进入聊天记录。" TextAlignment="Center" TextWrapping="Wrap" Style="{StaticResource ChatOSSecondaryBodyTextStyle}" />
                                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="8">
                                            <Button Click="OnPromptSuggestionClick" Content="电影感人像" Tag="电影感人像，柔和轮廓光，浅景深，精致肤质，电影级调色" Style="{StaticResource ChatOSSecondaryButtonStyle}" />
                                            <Button Click="OnPromptSuggestionClick" Content="未来城市" Tag="雨夜中的未来城市，霓虹灯光，广角构图，电影感，细节丰富" Style="{StaticResource ChatOSSecondaryButtonStyle}" />
                                            <Button Click="OnPromptSuggestionClick" Content="治愈插画" Tag="温暖治愈的手绘插画，柔和色彩，自然光，细腻笔触" Style="{StaticResource ChatOSSecondaryButtonStyle}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource MediaStudioCardStyle}" Padding="0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Padding="18" Spacing="17">
                                    <TextBlock Text="生成设置" Style="{StaticResource ChatOSHeadlineTextStyle}" />

                                    <StackPanel Spacing="7">
                                        <TextBlock Text="图片模型" Style="{StaticResource ChatOSBodyStrongTextStyle}" />
                                        <ComboBox AutomationProperties.AutomationId="ChatOS.MediaStudio.Model" HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.Models}" SelectedItem="{x:Bind ViewModel.SelectedModel, Mode=TwoWay}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="core:MediaGenerationModel">
                                                    <StackPanel Spacing="2">
                                                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource ChatOSBodyStrongTextStyle}" />
                                                        <TextBlock Style="{StaticResource ChatOSCaptionTextStyle}"><Run Text="{x:Bind Provider}" /><Run Text=" · " /><Run Text="{x:Bind ModelName}" /></TextBlock>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Spacing="7">
                                        <Grid>
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="参考图（最多 8 张）" Style="{StaticResource ChatOSBodyStrongTextStyle}" />
                                                <TextBlock Text="可从创作记录或本机选择" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                            </StackPanel>
                                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="6">
                                                <Button Click="OnAddGeneratedReferenceClick" Content="从记录" Style="{StaticResource ChatOSSecondaryButtonStyle}" />
                                                <Button AutomationProperties.AutomationId="ChatOS.MediaStudio.AddReference" Click="OnAddReferenceClick" Content="本机" Style="{StaticResource ChatOSSecondaryButtonStyle}" />
                                            </StackPanel>
                                        </Grid>
                                        <ItemsControl ItemsSource="{x:Bind ViewModel.ReferenceImages}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="core:ImageGenerationInput">
                                                    <Border Margin="0,0,0,5" Padding="9,6" Background="{StaticResource ChatOSSurfaceSubtleBrush}" CornerRadius="8">
                                                        <Grid ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                            <TextBlock VerticalAlignment="Center" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                                            <Button Grid.Column="1" Click="OnRemoveReferenceClick" Style="{StaticResource ChatOSToolbarButtonStyle}" ToolTipService.ToolTip="移除">
                                                                <FontIcon Glyph="&#xE711;" FontSize="11" />
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <StackPanel Spacing="7">
                                        <TextBlock Text="提示词" Style="{StaticResource ChatOSBodyStrongTextStyle}" />
                                        <TextBox AutomationProperties.AutomationId="ChatOS.MediaStudio.Prompt" AcceptsReturn="True" MinHeight="170" PlaceholderText="描述主体、场景、构图、光线和风格…" Text="{x:Bind ViewModel.Prompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="7">
                                            <TextBlock Text="尺寸" Style="{StaticResource ChatOSBodyStrongTextStyle}" />
                                            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.Sizes}" SelectedItem="{x:Bind ViewModel.SelectedSize, Mode=TwoWay}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="7">
                                            <TextBlock Text="数量" Style="{StaticResource ChatOSBodyStrongTextStyle}" />
                                            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.Counts}" SelectedItem="{x:Bind ViewModel.SelectedCount, Mode=TwoWay}" />
                                        </StackPanel>
                                    </Grid>

                                    <Button AutomationProperties.AutomationId="ChatOS.MediaStudio.Generate" AutomationProperties.Name="生成图片" Click="OnGenerateClick" Content="生成图片" IsEnabled="{x:Bind ViewModel.CanGenerate, Mode=OneWay}" Style="{StaticResource ChatOSPrimaryButtonStyle}" HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </PivotItem>

                <PivotItem Header="视频创作">
                    <Grid ColumnSpacing="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="356" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource MediaStudioCardStyle}" Padding="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="62" />
                                    <RowDefinition Height="1" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid Padding="18,0">
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="视频画布" Style="{StaticResource ChatOSHeadlineTextStyle}" />
                                        <TextBlock Text="生成完成后自动保存到本机" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                                        <TextBlock VerticalAlignment="Center" Text="{x:Bind ViewModel.VideoProgressLabel, Mode=OneWay}" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                        <Button x:Name="VideoCancelButton" Click="OnCancelVideoClick" Content="停止等待" Style="{StaticResource ChatOSSecondaryButtonStyle}" />
                                    </StackPanel>
                                </Grid>
                                <Border Grid.Row="1" Background="{StaticResource ChatOSBorderBrush}" />
                                <Grid Grid.Row="2" Padding="18">
                                    <Grid x:Name="VideoResultPanel" RowSpacing="14">
                                        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <MediaPlayerElement x:Name="VideoPlayer" MinHeight="360" AreTransportControlsEnabled="True" AutoPlay="False" Stretch="Uniform" />
                                        <Border Grid.Row="1" Padding="13" Background="{StaticResource ChatOSSurfaceSubtleBrush}" CornerRadius="11" DataContext="{x:Bind ViewModel.LatestVideo, Mode=OneWay}">
                                            <TextBlock Text="{Binding Prompt}" IsTextSelectionEnabled="True" TextWrapping="Wrap" Style="{StaticResource ChatOSSecondaryBodyTextStyle}" />
                                        </Border>
                                    </Grid>
                                    <StackPanel x:Name="VideoEmptyState" MaxWidth="460" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                                        <Border Style="{StaticResource MediaStudioEmptyIconStyle}" Background="{StaticResource ChatOSPurpleSoftBrush}">
                                            <FontIcon Glyph="&#xE714;" FontSize="24" Foreground="{StaticResource ChatOSPurpleBrush}" />
                                        </Border>
                                        <TextBlock HorizontalAlignment="Center" Text="把镜头描述变成视频" Style="{StaticResource ChatOSHeadlineTextStyle}" />
                                        <TextBlock Text="可选择首帧、画面比例、清晰度和时长。任务会自动轮询并下载结果。" TextAlignment="Center" TextWrapping="Wrap" Style="{StaticResource ChatOSSecondaryBodyTextStyle}" />
                                    </StackPanel>
                                    <StackPanel x:Name="VideoFailedState" MaxWidth="460" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                                        <Border Style="{StaticResource MediaStudioEmptyIconStyle}" Background="{StaticResource ChatOSWarningSoftBrush}">
                                            <FontIcon Glyph="&#xE7BA;" FontSize="28" Foreground="{StaticResource ChatOSWarningBrush}" />
                                        </Border>
                                        <TextBlock HorizontalAlignment="Center" Text="视频生成失败" Style="{StaticResource ChatOSHeadlineTextStyle}" />
                                        <TextBlock Text="请检查错误提示或模型配置后重试；以前的视频仍保留在创作记录中。" TextAlignment="Center" TextWrapping="Wrap" Style="{StaticResource ChatOSSecondaryBodyTextStyle}" />
                                    </StackPanel>
                                    <Border x:Name="VideoProgressPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="22" Background="{StaticResource ChatOSSurfaceBrush}" CornerRadius="14">
                                        <StackPanel Width="300" Spacing="12">
                                            <TextBlock Text="正在生成视频" Style="{StaticResource ChatOSHeadlineTextStyle}" />
                                            <ProgressBar x:Name="VideoProgressBar" IsIndeterminate="True" />
                                            <TextBlock HorizontalAlignment="Center" Text="{x:Bind ViewModel.VideoProgressLabel, Mode=OneWay}" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource MediaStudioCardStyle}" Padding="0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Padding="18" Spacing="17">
                                    <TextBlock Text="视频设置" Style="{StaticResource ChatOSHeadlineTextStyle}" />
                                    <StackPanel Spacing="7">
                                        <TextBlock Text="视频模型" Style="{StaticResource ChatOSBodyStrongTextStyle}" />
                                        <ComboBox HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.VideoModels}" SelectedItem="{x:Bind ViewModel.SelectedVideoModel, Mode=TwoWay}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="core:MediaGenerationModel">
                                                    <StackPanel Spacing="2">
                                                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource ChatOSBodyStrongTextStyle}" />
                                                        <TextBlock Style="{StaticResource ChatOSCaptionTextStyle}"><Run Text="{x:Bind Provider}" /><Run Text=" · " /><Run Text="{x:Bind ModelName}" /></TextBlock>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Spacing="7">
                                        <Grid>
                                            <TextBlock Text="首帧（可选）" Style="{StaticResource ChatOSBodyStrongTextStyle}" />
                                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="6">
                                                <Button Click="OnPickVideoFrameClick" Content="选择" Style="{StaticResource ChatOSSecondaryButtonStyle}" />
                                                <Button Click="OnRemoveVideoFrameClick" Content="清除" Style="{StaticResource ChatOSSecondaryButtonStyle}" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="{x:Bind ViewModel.VideoFirstFrameLabel, Mode=OneWay}" TextTrimming="CharacterEllipsis" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                    </StackPanel>
                                    <StackPanel Spacing="7">
                                        <Grid>
                                            <TextBlock Text="参考音频（可选）" Style="{StaticResource ChatOSBodyStrongTextStyle}" />
                                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="6">
                                                <Button Click="OnPickVideoAudioClick" Content="选择" IsEnabled="{x:Bind ViewModel.CanUseVideoReferenceAudio, Mode=OneWay}" Style="{StaticResource ChatOSSecondaryButtonStyle}" />
                                                <Button Click="OnRemoveVideoAudioClick" Content="清除" IsEnabled="{x:Bind ViewModel.CanUseVideoReferenceAudio, Mode=OneWay}" Style="{StaticResource ChatOSSecondaryButtonStyle}" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="{x:Bind ViewModel.VideoReferenceAudioLabel, Mode=OneWay}" TextTrimming="CharacterEllipsis" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                    </StackPanel>
                                    <StackPanel Spacing="7">
                                        <TextBlock Text="提示词" Style="{StaticResource ChatOSBodyStrongTextStyle}" />
                                        <TextBox AcceptsReturn="True" MinHeight="150" PlaceholderText="描述镜头运动、主体动作、光线和节奏…" Text="{x:Bind ViewModel.VideoPrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="7">
                                            <TextBlock Text="清晰度" Style="{StaticResource ChatOSBodyStrongTextStyle}" />
                                            <ComboBox ItemsSource="{x:Bind ViewModel.VideoSizes, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.VideoSize, Mode=TwoWay}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="7">
                                            <TextBlock Text="时长（秒）" Style="{StaticResource ChatOSBodyStrongTextStyle}" />
                                            <ComboBox ItemsSource="{x:Bind ViewModel.VideoDurations, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.VideoSeconds, Mode=TwoWay}" />
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Spacing="7">
                                        <TextBlock Text="画面比例" Style="{StaticResource ChatOSBodyStrongTextStyle}" />
                                        <ComboBox IsEnabled="{x:Bind ViewModel.CanChooseVideoRatio, Mode=OneWay}" ItemsSource="{x:Bind ViewModel.VideoRatios}" SelectedItem="{x:Bind ViewModel.VideoRatio, Mode=TwoWay}" />
                                        <TextBlock Text="{x:Bind ViewModel.VideoRatioHint, Mode=OneWay}" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                    </StackPanel>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <Button Click="OnGenerateVideoClick" Content="生成视频" IsEnabled="{x:Bind ViewModel.CanGenerateVideo, Mode=OneWay}" Style="{StaticResource ChatOSPrimaryButtonStyle}" HorizontalAlignment="Stretch" />
                                        <Button Grid.Column="1" Click="OnCancelVideoClick" Content="停止等待" IsEnabled="{x:Bind ViewModel.IsGeneratingVideo, Mode=OneWay}" Style="{StaticResource ChatOSSecondaryButtonStyle}" />
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </PivotItem>

                <PivotItem Header="剧情模式">
                    <Grid ColumnSpacing="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border x:Name="StoryProjectSidebar" Style="{StaticResource MediaStudioCardStyle}" Padding="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="1" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid Padding="16,14" ColumnSpacing="8">
                                    <StackPanel>
                                        <TextBlock Text="剧情项目" Style="{StaticResource ChatOSHeadlineTextStyle}" />
                                        <TextBlock Text="按账户保存在本机" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                    </StackPanel>
                                    <Button HorizontalAlignment="Right" Click="OnCloseStoryProjectClick" Content="新建" Style="{StaticResource ChatOSSecondaryButtonStyle}" />
                                </Grid>
                                <Border Grid.Row="1" Background="{StaticResource ChatOSBorderBrush}" />
                                <ListView
                                    Grid.Row="2"
                                    Padding="10"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    IsItemClickEnabled="True"
                                    ItemClick="OnStoryProjectClick"
                                    ItemsSource="{x:Bind StoryViewModel.Projects}"
                                    SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="media:StoryProjectCard">
                                            <Border Margin="0,0,0,8" Padding="12" Background="{StaticResource ChatOSSurfaceSubtleBrush}" CornerRadius="11">
                                                <StackPanel Spacing="5">
                                                    <Grid ColumnSpacing="8">
                                                        <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" Style="{StaticResource ChatOSBodyStrongTextStyle}" />
                                                        <TextBlock HorizontalAlignment="Right" Text="{x:Bind UpdatedAtLabel}" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                                    </Grid>
                                                    <TextBlock Text="{x:Bind Description}" MaxLines="2" TextWrapping="Wrap" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                                    <TextBlock Text="{x:Bind ProgressLabel}" Foreground="{StaticResource ChatOSPurpleBrush}" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                    <ListView.Footer>
                                        <Button HorizontalAlignment="Center" Click="OnLoadMoreStoryProjectsClick"
                                                Content="加载更多项目" Style="{StaticResource ChatOSSecondaryButtonStyle}"
                                                IsEnabled="{x:Bind StoryViewModel.CanLoadMoreProjects, Mode=OneWay}"
                                                Visibility="{x:Bind StoryViewModel.HasMoreProjects, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </ListView.Footer>
                                </ListView>
                            </Grid>
                        </Border>

                        <Border x:Name="StoryMainPanel" Grid.Column="1" Style="{StaticResource MediaStudioCardStyle}" Padding="0">
                            <Grid>
                                <ScrollViewer x:Name="StoryCreatePanel" VerticalScrollBarVisibility="Auto">
                                    <StackPanel MaxWidth="1180" Padding="26" HorizontalAlignment="Center" Spacing="22">
                                        <Border Padding="24" Background="{StaticResource ChatOSPurpleSoftBrush}" CornerRadius="18">
                                            <Grid ColumnSpacing="18">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="62" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <Border Width="62" Height="62" CornerRadius="16">
                                                    <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#5B5BD6" /><GradientStop Color="#8B5CF6" Offset="1" /></LinearGradientBrush></Border.Background>
                                                    <FontIcon Glyph="&#xE714;" FontSize="27" Foreground="White" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5">
                                                    <TextBlock Text="剧情工作室" FontSize="28" FontWeight="Bold" />
                                                    <TextBlock Text="从完整故事出发，建立角色、场景、分镜与视频制作计划。" TextWrapping="Wrap" Style="{StaticResource ChatOSSecondaryBodyTextStyle}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <StackPanel Spacing="3">
                                            <TextBlock Text="我的剧情" FontSize="20" FontWeight="SemiBold" />
                                            <TextBlock Text="最近更新的剧情项目" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                        </StackPanel>
