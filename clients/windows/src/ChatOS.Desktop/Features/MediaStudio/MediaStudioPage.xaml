                                                        <ItemsControl ItemsSource="{x:Bind StoryViewModel.ResourceRelations}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="media:StoryResourceRelationGroup">
                                                                    <Border Margin="0,0,0,8" Padding="9" Background="{StaticResource ChatOSSurfaceSubtleBrush}" CornerRadius="8">
