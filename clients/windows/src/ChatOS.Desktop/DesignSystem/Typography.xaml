<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <FontFamily x:Key="ChatOSInterfaceFontFamily">Segoe UI Variable, Microsoft YaHei UI</FontFamily>
    <x:Double x:Key="ChatOSFontSizeCaption">11</x:Double>
    <x:Double x:Key="ChatOSFontSizeBody">13</x:Double>
    <x:Double x:Key="ChatOSFontSizeHeadline">14</x:Double>
    <x:Double x:Key="ChatOSFontSizePageTitle">24</x:Double>

    <Style x:Key="ChatOSTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource ChatOSInterfaceFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource ChatOSFontSizeBody}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource ChatOSPrimaryTextBrush}" />
    </Style>

    <Style x:Key="ChatOSHeadlineTextStyle" TargetType="TextBlock" BasedOn="{StaticResource ChatOSTitleTextStyle}">
        <Setter Property="FontSize" Value="{DynamicResource ChatOSFontSizeHeadline}" />
    </Style>

    <Style x:Key="ChatOSPageTitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource ChatOSTitleTextStyle}">
        <Setter Property="FontSize" Value="{DynamicResource ChatOSFontSizePageTitle}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style x:Key="ChatOSBodyStrongTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource ChatOSInterfaceFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource ChatOSFontSizeBody}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource ChatOSPrimaryTextBrush}" />
    </Style>

    <Style x:Key="ChatOSSecondaryBodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource ChatOSInterfaceFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource ChatOSFontSizeBody}" />
        <Setter Property="Foreground" Value="{StaticResource ChatOSSecondaryTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="ChatOSCaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource ChatOSInterfaceFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource ChatOSFontSizeCaption}" />
        <Setter Property="Foreground" Value="{StaticResource ChatOSTertiaryTextBrush}" />
    </Style>

    <Style x:Key="ChatOSSectionLabelTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource ChatOSInterfaceFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource ChatOSFontSizeCaption}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource ChatOSSecondaryTextBrush}" />
        <Setter Property="Margin" Value="8,0,0,2" />
    </Style>
</ResourceDictionary>
