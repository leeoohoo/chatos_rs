<Page
    x:Class="ChatOS.Desktop.Features.AgentTeams.AgentWorkspacePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:domain="using:ChatOS.Core.Domain"
    xmlns:local="using:ChatOS.Desktop.Features.AgentTeams"
    xmlns:presentation="using:ChatOS.Presentation.AgentTeams"
    xmlns:shell="using:ChatOS.Desktop.AppShell"
    AutomationProperties.AutomationId="ChatOS.AgentWorkspace.Root"
    AutomationProperties.Name="Agent 工作区">

    <Page.Resources>
        <local:AgentPermissionLabelConverter x:Key="AgentPermissionLabelConverter" />
        <local:AgentHeartbeatLabelConverter x:Key="AgentHeartbeatLabelConverter" />
    </Page.Resources>

    <Grid Background="{StaticResource ChatOSWorkspaceBackgroundBrush}">
        <Grid RowSpacing="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid MinHeight="60" Padding="14,10" ColumnSpacing="14" Background="{StaticResource ChatOSSidebarBackgroundBrush}" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="11">
                    <Border Width="34" Height="34" Background="{StaticResource ChatOSPurpleSoftBrush}" CornerRadius="10">
                        <FontIcon Glyph="&#xE716;" FontSize="19" Foreground="{StaticResource ChatOSPurpleBrush}" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Agent" Style="{StaticResource ChatOSHeadlineTextStyle}" />
                        <TextBlock Text="私聊与项目团队" Style="{StaticResource ChatOSCaptionTextStyle}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                    <Button Click="OnCreateTeamClick" Content="创建团队" Style="{StaticResource ChatOSSecondaryButtonStyle}" />
                    <Button Click="OnNewAgentClick" Content="创建 Agent" Style="{StaticResource ChatOSPrimaryButtonStyle}" />
                    <Button AutomationProperties.Name="运行等待队列" Click="OnRunAgentsClick" Style="{StaticResource ChatOSToolbarButtonStyle}" ToolTipService.ToolTip="运行等待队列"><FontIcon Glyph="&#xE768;" /></Button>
                    <Button AutomationProperties.Name="刷新 Agent 工作区" Click="OnRefreshClick" Style="{StaticResource ChatOSToolbarButtonStyle}" ToolTipService.ToolTip="刷新"><FontIcon Glyph="&#xE72C;" /></Button>
                </StackPanel>
            </Grid>

            <InfoBar x:Name="NoticeBar" Grid.Row="1" Margin="10,6" IsClosable="False" />

            <Grid Grid.Row="2" ColumnSpacing="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="248" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Padding="0" Background="{StaticResource ChatOSSidebarBackgroundBrush}" BorderBrush="{StaticResource ChatOSBorderBrush}" BorderThickness="0,1,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="1" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="1" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Padding="8,10" Spacing="4">
                            <Grid Padding="4,0,4,8" ColumnSpacing="9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="34" Height="34" Background="{StaticResource ChatOSPurpleSoftBrush}" CornerRadius="10">
                                    <FontIcon Glyph="&#xE716;" FontSize="18" Foreground="{StaticResource ChatOSPurpleBrush}" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                    <TextBlock Text="Agent" Style="{StaticResource ChatOSBodyStrongTextStyle}" />
                                    <TextBlock Text="私聊与项目团队" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                </StackPanel>
                                <Button Grid.Column="2" AutomationProperties.Name="创建 Agent" Click="OnNewAgentClick" Style="{StaticResource ChatOSToolbarButtonStyle}" ToolTipService.ToolTip="创建 Agent">
                                    <FontIcon Glyph="&#xE710;" />
                                </Button>
                            </Grid>
                            <Button
                                x:Name="AgentManagementNavigationButton"
                                AutomationProperties.AutomationId="ChatOS.AgentWorkspace.Management"
                                AutomationProperties.Name="Agent 管理"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Click="OnShowAgentManagementClick"
                                Style="{StaticResource ChatOSSecondaryButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="9">
                                    <FontIcon Glyph="&#xE77B;" FontSize="15" />
                                    <StackPanel Spacing="1">
                                        <TextBlock Text="Agent 管理" FontWeight="SemiBold" />
                                        <TextBlock Text="模型、角色和权限" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                            <Button
                                x:Name="AgentDocumentsNavigationButton"
                                AutomationProperties.AutomationId="ChatOS.AgentWorkspace.Documents"
                                AutomationProperties.Name="本地 Agent 文档"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Click="OnShowAgentDocumentsClick"
                                Style="{StaticResource ChatOSSecondaryButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="9">
                                    <FontIcon Glyph="&#xE8A5;" FontSize="15" />
                                    <StackPanel Spacing="1">
                                        <TextBlock Text="本地 Agent 文档" FontWeight="SemiBold" />
                                        <TextBlock Text="跨设备发现与预览" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <Border Grid.Row="1" Background="{StaticResource ChatOSBorderBrush}" />

                        <StackPanel Grid.Row="2" Padding="12,11" Spacing="8">
                            <TextBlock Text="团队" Style="{StaticResource ChatOSCaptionTextStyle}" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.TeamRooms}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="domain:AgentRoom">
                                        <Button Margin="0,0,0,5" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="OnTeamClicked" Style="{StaticResource ChatOSSecondaryButtonStyle}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE716;" FontSize="13" Foreground="{StaticResource ChatOSPurpleBrush}" />
                                                <StackPanel>
                                                    <TextBlock Text="{x:Bind Draft.Name}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{x:Bind Draft.Goal}" TextTrimming="CharacterEllipsis" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <Border Grid.Row="3" Background="{StaticResource ChatOSBorderBrush}" />

                        <Grid Grid.Row="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Padding="13,11,13,5" Spacing="2">
                                <TextBlock Text="私聊" Style="{StaticResource ChatOSHeadlineTextStyle}" />
                                <TextBlock Text="所有 Agent 私聊都保存在本机" Style="{StaticResource ChatOSCaptionTextStyle}" />
                            </StackPanel>
                            <ListView
                                Grid.Row="1"
                                AutomationProperties.AutomationId="ChatOS.AgentWorkspace.DirectChats"
                                Padding="7"
                                Background="Transparent"
                                BorderThickness="0"
                                ItemsSource="{x:Bind ViewModel.DirectRooms}"
                                SelectedItem="{x:Bind ViewModel.SelectedRoom, Mode=TwoWay}"
                                SelectionChanged="OnRoomSelectionChanged">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="domain:AgentRoom">
                                        <StackPanel Padding="8" Spacing="2">
                                            <TextBlock FontWeight="SemiBold" Text="{x:Bind Draft.Name}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Draft.Goal}" TextTrimming="CharacterEllipsis" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Grid>
                </Border>

                <Grid Grid.Column="1" Padding="18,0,18,18">
                    <Grid
                        x:Name="AgentManagementPanel"
                        AutomationProperties.AutomationId="ChatOS.AgentWorkspace.ManagementPage">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="1" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid MinHeight="64" Padding="0,12" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="3">
                                <TextBlock Text="Agent 管理" Style="{StaticResource ChatOSHeadlineTextStyle}" />
                                <TextBlock Text="管理 Agent、模型和权限。" Style="{StaticResource ChatOSCaptionTextStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Button AutomationProperties.Name="Skill 管理" Click="OnSkillManagementClick" Content="Skill 管理" Style="{StaticResource ChatOSSecondaryButtonStyle}" />
                                <Button Click="OnNewAgentClick" Content="创建 Agent" Style="{StaticResource ChatOSPrimaryButtonStyle}" />
                            </StackPanel>
                        </Grid>
                        <Border Grid.Row="1" Background="{StaticResource ChatOSBorderBrush}" />
                        <Grid Grid.Row="2">
                            <GridView
                                x:Name="AgentGrid"
                                Padding="0,14,0,0"
                                Background="Transparent"
                                BorderThickness="0"
                                IsItemClickEnabled="True"
                                ItemClick="OnAgentClicked"
                                ItemsSource="{x:Bind ViewModel.Agents}"
                                SizeChanged="OnAgentGridSizeChanged"
                                SelectionMode="None">
                                <GridView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ItemsWrapGrid Orientation="Horizontal" ItemWidth="280" />
                                    </ItemsPanelTemplate>
                                </GridView.ItemsPanel>
                                <GridView.ItemContainerStyle>
                                    <Style TargetType="GridViewItem">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0,0,12,12" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                    </Style>
                                </GridView.ItemContainerStyle>
                                <GridView.ItemTemplate>
                                    <DataTemplate x:DataType="domain:AgentProfile">
                                        <Border Padding="14" Style="{StaticResource ChatOSSectionCardStyle}">
                                            <Grid RowSpacing="10">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="1" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid ColumnSpacing="11">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="58" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="56" Height="56" Background="{StaticResource ChatOSPurpleBrush}" CornerRadius="17">
                                                        <FontIcon Glyph="&#xE77B;" FontSize="24" Foreground="White" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                                        <TextBlock Text="{x:Bind Draft.Name}" TextTrimming="CharacterEllipsis" Style="{StaticResource ChatOSHeadlineTextStyle}" />
                                                        <TextBlock Text="{Binding Converter={StaticResource AgentPermissionLabelConverter}}" TextTrimming="CharacterEllipsis" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                                    </StackPanel>
                                                    <Button Grid.Column="2" AutomationProperties.Name="编辑 Agent" Click="OnEditAgentClick" Style="{StaticResource ChatOSToolbarButtonStyle}" ToolTipService.ToolTip="编辑 Agent"><FontIcon Glyph="&#xE70F;" FontSize="12" /></Button>
                                                </Grid>
                                                <TextBlock Grid.Row="1" MaxHeight="54" Text="{x:Bind Draft.Description}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" Style="{StaticResource ChatOSSecondaryBodyTextStyle}" />
                                                <Border Grid.Row="2" Background="{StaticResource ChatOSBorderBrush}" />
                                                <Grid Grid.Row="3" ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <StackPanel Spacing="3">
                                                        <TextBlock Style="{StaticResource ChatOSCaptionTextStyle}"><Run Text="模型  " /><Run Text="{x:Bind Draft.ModelConfigId}" /></TextBlock>
                                                        <TextBlock Style="{StaticResource ChatOSCaptionTextStyle}"><Run Text="思考等级  " /><Run Text="{x:Bind Draft.ThinkingLevel}" /></TextBlock>
                                                        <TextBlock Style="{StaticResource ChatOSCaptionTextStyle}"><Run Text="职业  " /><Run Text="{x:Bind Draft.ProfessionKey}" /></TextBlock>
                                                        <TextBlock Style="{StaticResource ChatOSCaptionTextStyle}"><Run Text="主动巡检  " /><Run Text="{Binding Converter={StaticResource AgentHeartbeatLabelConverter}}" /></TextBlock>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Orientation="Horizontal" Spacing="5">
                                                        <Button Click="OnDirectAgentClick" Content="私聊" Style="{StaticResource ChatOSPrimaryButtonStyle}" />
                                                        <Button AutomationProperties.Name="归档 Agent" Click="OnArchiveAgentClick" Style="{StaticResource ChatOSToolbarButtonStyle}" ToolTipService.ToolTip="归档"><FontIcon Glyph="&#xE74D;" FontSize="12" /></Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </GridView.ItemTemplate>
                            </GridView>
                            <StackPanel x:Name="AgentEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="9">
                                <Border Style="{StaticResource ChatOSEmptyStateIconStyle}">
                                    <FontIcon Glyph="&#xE77B;" FontSize="23" Foreground="{StaticResource ChatOSPurpleBrush}" />
                                </Border>
                                <TextBlock HorizontalAlignment="Center" Text="还没有 Agent" Style="{StaticResource ChatOSHeadlineTextStyle}" />
                                <TextBlock MaxWidth="420" Text="创建后可以直接私聊，也可以加入项目团队。" TextAlignment="Center" TextWrapping="Wrap" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                <Button HorizontalAlignment="Center" Click="OnNewAgentClick" Content="创建 Agent" Style="{StaticResource ChatOSPrimaryButtonStyle}" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <Grid
                        x:Name="AgentDocumentsPanel"
                        AutomationProperties.AutomationId="ChatOS.AgentWorkspace.DocumentsPage"
                        Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="1" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Padding="4,0,4,12" ColumnSpacing="10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="3">
                                <TextBlock Text="本地 Agent 文档" Style="{StaticResource ChatOSHeadlineTextStyle}" />
                                <TextBlock Text="显示当前账户由 Local Agent Host 保存的 Markdown 文档。" Style="{StaticResource ChatOSCaptionTextStyle}" />
                            </StackPanel>
                            <Button x:Name="ArtifactRefreshButton" Grid.Column="1" Click="OnRefreshArtifactsClick" Content="刷新" Style="{StaticResource ChatOSSecondaryButtonStyle}" />
                        </Grid>
                        <InfoBar x:Name="ArtifactNoticeBar" Grid.Row="1" Margin="0,0,0,10" IsClosable="False" Severity="Error" />
                        <Border Grid.Row="2" Background="{StaticResource ChatOSBorderBrush}" />
                        <Grid Grid.Row="3">
                            <StackPanel x:Name="ArtifactLoadingState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="9">
                                <ProgressRing x:Name="ArtifactProgress" Width="28" Height="28" IsActive="True" />
                                <TextBlock Text="正在读取本地文档…" Style="{StaticResource ChatOSCaptionTextStyle}" />
                            </StackPanel>
                            <ListView
                                x:Name="ArtifactList"
                                Padding="0,10,0,0"
                                Background="Transparent"
                                BorderThickness="0"
                                ItemsSource="{x:Bind ArtifactItems}"
                                SelectionMode="None">
                                <ListView.Footer>
                                    <Button x:Name="ArtifactLoadMoreButton" Margin="0,8,0,4" HorizontalAlignment="Center" Click="OnLoadMoreArtifactsClick" Content="加载更多" Style="{StaticResource ChatOSSecondaryButtonStyle}" />
                                </ListView.Footer>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:AgentArtifactItemViewModel">
                                        <Border Margin="0,0,0,8" Style="{StaticResource ChatOSSectionCardStyle}">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <FontIcon VerticalAlignment="Center" Glyph="&#xE8A5;" FontSize="21" Foreground="{StaticResource ChatOSPurpleBrush}" />
                                                <StackPanel Grid.Column="1" Spacing="3">
                                                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource ChatOSBodyStrongTextStyle}" />
                                                    <TextBlock Text="{x:Bind MetadataLabel}" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                                    <TextBlock Text="{x:Bind HashLabel}" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal" Spacing="6">
                                                    <Button Click="OnPreviewArtifactClick" Content="预览" Style="{StaticResource ChatOSSecondaryButtonStyle}" />
                                                    <Button AutomationProperties.Name="另存为插件产物" Click="OnSaveArtifactClick" Style="{StaticResource ChatOSToolbarButtonStyle}" ToolTipService.ToolTip="另存为"><FontIcon Glyph="&#xE896;" FontSize="13" /></Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <StackPanel x:Name="ArtifactEmptyState" Margin="0,18,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" Spacing="9">
                                <Border Style="{StaticResource ChatOSEmptyStateIconStyle}">
                                    <FontIcon Glyph="&#xE8A5;" FontSize="23" Foreground="{StaticResource ChatOSPurpleBrush}" />
                                </Border>
                                <TextBlock HorizontalAlignment="Center" Text="还没有本地 Agent 文档" Style="{StaticResource ChatOSHeadlineTextStyle}" />
                                <TextBlock MaxWidth="430" Text="Agent 创建并由 Local Agent Host 保存的 Markdown 会出现在这里。" TextAlignment="Center" TextWrapping="Wrap" Style="{StaticResource ChatOSCaptionTextStyle}" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <Border x:Name="DirectChatPanel" Padding="0" Style="{StaticResource ChatOSSectionCardStyle}" Visibility="Collapsed">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="1" /><RowDefinition Height="*" /><RowDefinition Height="1" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <StackPanel Padding="17,13" Spacing="3">
                                <TextBlock Text="{x:Bind SelectedRoomName, Mode=OneTime}" Style="{StaticResource ChatOSHeadlineTextStyle}" />
                                <TextBlock Text="{x:Bind SelectedRoomGoal, Mode=OneTime}" TextWrapping="Wrap" Style="{StaticResource ChatOSCaptionTextStyle}" />
                            </StackPanel>
                            <Border Grid.Row="1" Background="{StaticResource ChatOSBorderBrush}" />
                            <ListView Grid.Row="2" Padding="14,8" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" ItemsSource="{x:Bind ViewModel.MessageItems}" SelectionMode="None">
                                <ListView.Header>
                                    <Grid Padding="0,4,0,7" Visibility="{x:Bind ViewModel.HasEarlierMessages, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Button HorizontalAlignment="Center" Click="OnLoadEarlierMessagesClick" Content="加载更早消息" Style="{StaticResource ChatOSSecondaryButtonStyle}" Visibility="{x:Bind ViewModel.IsLoadingEarlierMessages, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                        <ProgressRing Width="20" Height="20" HorizontalAlignment="Center" IsActive="{x:Bind ViewModel.IsLoadingEarlierMessages, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsLoadingEarlierMessages, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </Grid>
                                </ListView.Header>
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /><Setter Property="IsTabStop" Value="False" /></Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="presentation:AgentMessageItemViewModel">
                                        <Border MaxWidth="640" Margin="0,4" Padding="12" HorizontalAlignment="{x:Bind IsHuman, Converter={StaticResource AgentMessageAlignmentConverter}}" Background="{x:Bind IsHuman, Converter={StaticResource AgentMessageBubbleBrushConverter}}" CornerRadius="11">
                                            <StackPanel Spacing="5">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Border Width="25" Height="25" Background="{StaticResource ChatOSPurpleSoftBrush}" CornerRadius="8" Visibility="{x:Bind IsHuman, Converter={StaticResource InverseBooleanToVisibilityConverter}}"><FontIcon Glyph="{x:Bind SenderGlyph}" FontSize="12" Foreground="{StaticResource ChatOSPurpleBrush}" /></Border>
                                                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{x:Bind SenderLabel}" />
                                                </StackPanel>
                                                <TextBlock Text="{x:Bind Content}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                                <ItemsControl ItemsSource="{x:Bind Attachments}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="domain:AgentMessageAttachment">
                                                            <StackPanel Margin="0,2,0,0" Orientation="Horizontal" Spacing="4">
                                                                <Button Click="OnPreviewAttachmentClick" Content="{x:Bind Name}" Style="{StaticResource ChatOSSecondaryButtonStyle}" FontSize="11" />
                                                                <Button AutomationProperties.Name="下载附件" Click="OnDownloadAttachmentClick" Style="{StaticResource ChatOSToolbarButtonStyle}" ToolTipService.ToolTip="另存为"><FontIcon Glyph="&#xE896;" FontSize="12" /></Button>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Text="{x:Bind TimestampLabel}" Style="{StaticResource ChatOSCaptionTextStyle}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <Border Grid.Row="3" Background="{StaticResource ChatOSBorderBrush}" />
                            <StackPanel Grid.Row="4" Padding="14" Spacing="8">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.PendingAttachments}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate><DataTemplate x:DataType="domain:AgentMessageAttachment"><Button Click="OnRemoveAttachmentClick" Content="{x:Bind Name}" Style="{StaticResource ChatOSSecondaryButtonStyle}" /></DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Button AutomationProperties.Name="添加附件" Click="OnAddAttachmentClick" Style="{StaticResource ChatOSToolbarButtonStyle}" ToolTipService.ToolTip="添加附件"><FontIcon Glyph="&#xE723;" /></Button>
                                    <TextBox Grid.Column="1" AcceptsReturn="True" MaxHeight="130" PlaceholderText="给 Agent 发消息…" Text="{x:Bind ViewModel.MessageText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" />
                                    <Button Grid.Column="2" VerticalAlignment="Bottom" Click="OnSendClick" Content="发送" IsEnabled="{x:Bind ViewModel.HasRoom, Mode=OneWay}" Style="{StaticResource ChatOSPrimaryButtonStyle}" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
