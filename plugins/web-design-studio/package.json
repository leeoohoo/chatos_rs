    "motion": "^12.23.12",
    "motion-v": "2.3.0",
    "next-themes": "^0.4.6",
    "ogl": "1.0.11",
    "opentype.js": "^1.3.4",
    "postprocessing": "^6.39.4",
    "proper-lockfile": "4.1.2",
    "qrcode": "^1.5.4",
